import {
    std("data/list/ArrList.zam");
    std("io/Paths.zam");
    std("io/local/FS.zam");
    std("lang/Err.zam");
    std("lang/Strs.zam");
    std("test/Assert.zam");
    "../cli/Target.zam";
    "../codegen/Runtime.zam";
    "../codegen/Zig.zam";
    "../syntax/Project.zam";
    "Natives.zam";
    "Pack.zam";
}

public namespace NativesTest {
    public fun void(uint, str...) Compiles = (argC, argV) {
        var str dir = FS::MakeTempDir(FS::TempDir(), "natives-").0;
        Assert::True(FS::WriteFile(Paths::Join(dir, "add.c"), "#include <zam/native.h>\n\nint64_t zam_add(int64_t a, int64_t b) {\n    return a + b;\n}\n") == null, dir);
        var (Project*, Err*) project = Project::Parse(Paths::Join(dir, "zam.yml"), "name: native\nversion: 0.0.0\nnative:\n  links: [-lm]\n  files: [add.c]\n");
        if(!Assert::True(project.1 == null, project.1 == null ? "" : project.1.Err())) {
            return;
        }
        var (Target, Err*) host = Zig::Host(dir);
        var (str, Err*) pack = Pack::Dir(host.0, dir);
        if(!Assert::True(host.1 == null && pack.1 == null, "no host pack")) {
            return;
        }
        var (ArrList[str]*, Err*) objects = Natives::Compile(project.0, dir, host.0, pack.0, Runtime::Dir(""), dir);
        if(Assert::True(objects.1 == null, objects.1 == null ? "" : objects.1.Err()) && Assert::True(objects.0.Len() == 1U, "one native compiles to no object")) {
            Assert::True(FS::Exists(objects.0.Get(0U)), objects.0.Get(0U));
        }
        Assert::True(Natives::Links(project.0).Len() == 1U && Natives::Links(project.0).Get(0U) == "-lm", "the native links are not passed on");
        FS::RemoveAll(dir);
    }

    public fun void(uint, str...) Missing = (argC, argV) {
        var (Project*, Err*) project = Project::Parse("/nowhere/zam.yml", "name: native\nversion: 0.0.0\nnative:\n  files: [gone.c]\n");
        var (ArrList[str]*, Err*) objects = Natives::Compile(project.0, FS::TempDir(), Target::Parse("aarch64-macos").0, "", "", FS::TempDir());
        if(Assert::True(objects.1 != null, "a missing native compiles")) {
            Assert::[str]Equal("native source \"gone.c\" not found at /nowhere/gone.c", objects.1.Err());
        }
    }

    public fun void(uint, str...) None = (argC, argV) {
        var (ArrList[str]*, Err*) objects = Natives::Compile(null, FS::TempDir(), Target::Parse("aarch64-macos").0, "", "", FS::TempDir());
        Assert::True(objects.1 == null && objects.0.Len() == 0U, "a project without natives compiles something");
    }
}
