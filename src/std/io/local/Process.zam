import {
    "../../lang/Arr.zam";
    "../../lang/Enums.zam";
    "../../lang/Err.zam";
    "../../lang/StrErr.zam";
    "../../lang/Strs.zam";
    "../../lang/System.zam";
    "File.zam";
}

// Running other programs
public namespace Process {
    // What a program wrote and the code it exited with
    public struct Result {
        // output is what the program wrote to its stdout and stderr together
        public var str output;
        // code is the program's exit code, or 128 and the signal for one a
        // signal ended.
        public var int code;
    }

    // How a started program's standard streams are connected
    public enum Stdio : int {
        // Inherit gives the program this one's stdin, stdout and stderr
        Inherit(0),
        // Pipe writes the program's stdin through In and reads its stdout through Out, and gives it this one's stderr
        Pipe(1),
        // Combine gives the program this one's stdin, and reads its stdout and stderr together through Out
        Combine(2);
    }

    // A started program
    public class Child {
        var uint handle;
        var uint id;
        var uint forward;
        var File* in;
        var File* out;
        var bool done;
        var int code;
        // ended is the OS number of the signal that ended the program, or 0
        var int ended;

        // ID answers the program's process id.
        public fun uint() ID = () {
            return this.id;
        }

        // In answers the pipe to the program's stdin, or null unless it was
        // started with Stdio::Pipe.
        public fun File*() In = () {
            return this.in;
        }

        // Out answers the pipe from the program's stdout, or null for one
        // started with Stdio::Inherit.
        public fun File*() Out = () {
            return this.out;
        }

        // Wait waits for the program to exit and answers its exit code, or 128 and the signal for one a signal ended
        public fun (int, Err*)() Wait = () {
            var (bool, int, Err*) waited = this.reap(true);
            return (waited.1, waited.2);
        }

        // Poll answers whether the program has exited, and its code as Wait does when it has, without waiting
        public fun (bool, int, Err*)() Poll = () {
            return this.reap(false);
        }

        // EndedBy answers the signal that ended the program, once it has been
        // waited on to its end, and whether one did.
        public fun (System.Signal, bool)() EndedBy = () {
            var Arr[System.Signal]* all = Enums::[System.Signal]All();
            if(this.ended != 0) {
                for(var uint i = 0U; i < all.Len(); i++) {
                    if(all.Get(i){int} == this.ended) {
                        return (all.Get(i), true);
                    }
                }
            }
            return (System.Signal::SIGHUP, false);
        }

        // Signal sends s to the program. On Windows only SIGTERM can be sent, and it ends the program with code 1
        public fun Err*(System.Signal) Signal = (s) {
            if(this.done) {
                return StrErr::New("process has already exited");
            }
            var str errStr;
            native(STD_PROCESS_SIGNAL){void(uint, int, str*)}(this.handle, s{int}, &errStr);
            if(errStr != null) {
                return StrErr::New(errStr);
            }
            return null;
        }

        // reap answers whether the program has exited, waiting for it to when block is set, and its code when it has
        fun (bool, int, Err*)(bool) reap = (block) {
            if(!this.done) {
                var str errStr;
                native(STD_PROCESS_WAIT){void(uint, uint, bool, bool*, int*, int*, str*)}(this.handle, this.forward, block, &(this.done), &(this.code), &(this.ended), &errStr);
                if(errStr != null) {
                    return (false, 0, StrErr::New(errStr));
                }
            }
            return (this.done, this.code, null);
        }
    }

    // Start starts the program argv names first, found on the PATH unless it
    // names a path, with the arguments after it, in the directory dir, or this
    // one for "", with each NAME=value of env set over this one's environment,
    // and its streams connected as stdio says. Each of signals this process
    // receives is sent on to the program until it is waited on to
    // its end, and handlers for them do not run meanwhile; SIGKILL and SIGSTOP
    // cannot be. On Windows, where only Ctrl-C reaches this process and it
    // reaches the program too, any signal ignores Ctrl-C here instead.
    public static fun (Process.Child*, Err*)(str, Arr[str]*, Arr[str]*, Process.Stdio, Arr[System.Signal]*) Start = (dir, argv, env, stdio, signals) {
        if(argv.Len() == 0U) {
            return (null, StrErr::New("no program to run"));
        }
        var int* forwarded = new(int, signals.Len());
        for(var uint i = 0U; i < signals.Len(); i++) {
            var System.Signal s = signals.Get(i);
            if(!s.Available()) {
                return (null, StrErr::New(s.Str() + " is not a signal on this OS"));
            } else if(s == System.Signal::SIGKILL || s == System.Signal::SIGSTOP) {
                return (null, StrErr::New("SIGKILL and SIGSTOP cannot be forwarded"));
            }
            forwarded[i] = s{int};
        }
        var Process.Child* c = new(Process.Child);
        var int in = -1;
        var int out = -1;
        var str errStr;
        native(STD_PROCESS_START){void(str, str, uint, str, uint, int, int*, uint, uint*, uint*, uint*, int*, int*, str*)}(dir, Process::joined(argv), argv.Len(), Process::joined(env), env.Len(), stdio{int}, forwarded, signals.Len(), &(c.handle), &(c.id), &(c.forward), &in, &out, &errStr);
        if(errStr != null) {
            return (null, StrErr::New("cannot run " + argv.Get(0U) + ": " + errStr));
        }
        c.in = in < 0 ? null : File::FromFD(in);
        c.out = out < 0 ? null : File::FromFD(out);
        return (c, null);
    }

    // Run runs the program argv names first as Start does, with its stdout and
    // stderr read together, and waits for it to exit. The error is for a
    // program that could not be run, not for one that exited with a code other
    // than 0.
    public static fun (Process.Result, Err*)(str, Arr[str]*, Arr[str]*) Run = (dir, argv, env) {
        var Process.Result result;
        result.output = "";
        result.code = 0;
        var (Process.Child*, Err*) started = Process::Start(dir, argv, env, Process.Stdio::Combine, Arr::[System.Signal]New(0U));
        if(started.1 != null) {
            return (result, started.1);
        }
        var (str, Err*) output = started.0.Out().ReadAll();
        started.0.Out().Close();
        var (int, Err*) waited = started.0.Wait();
        if(output.1 != null) {
            return (result, output.1);
        } else if(waited.1 != null) {
            return (result, waited.1);
        }
        result.output = output.0;
        result.code = waited.0;
        return (result, null);
    }

    // joined answers strs separated by NUL bytes.
    private static fun str(Arr[str]*) joined = (strs) {
        var byte zero = 0{byte};
        var str separator = Strs::FromBytes(&zero, 1U);
        var str out = "";
        for(var uint i = 0U; i < strs.Len(); i++) {
            if(i > 0U) {
                out = out + separator;
            }
            out = out + strs.Get(i);
        }
        return out;
    }
}
