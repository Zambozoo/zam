import {
    "../../codec/text/Base64.zam";
    "../../crypto/Rand.zam";
    "../../crypto/hash/SHA1.zam";
    "../../lang/Arr.zam";
    "../../lang/Arrs.zam";
    "../../lang/Err.zam";
    "../../lang/StrErr.zam";
    "../../lang/Strs.zam";
    "../../sync/Mutex.zam";
    "../local/Buffer.zam";
    "../local/Stream.zam";
    "../local/Streams.zam";
    "../net/Socket.zam";
    "../net/TCP.zam";
    "../net/TLS.zam";
    "HTTP.zam";
    "URL.zam";
}

// WebSocket over any stream, per RFC 6455: dialed as a client to ws:// and
// wss:// URLs, or accepted by a server from an HTTP request. One thread may
// send while another receives. Pings are answered without being seen.
public class WebSocket {
    // One whole message, or the end of the connection when closed is true
    public class Message {
        public var bool text;
        public var str data;
        public var bool closed;
    }

    // The largest message Receive takes, joined from its fragments
    public static var uint MaxMessage = 67108864U;

    var Stream* stream;
    var Socket* sock;
    var bool client;
    var Mutex* lock;
    var byte* buf;
    var uint bufCap;
    var uint bufStart;
    var uint bufEnd;
    var bool closeSent;
    var bool ended;
    var bool receiving;
    var bool released;

    private static fun WebSocket*(Stream*, Socket*, bool, str) of = (stream, sock, client, rest) {
        var WebSocket* ws = new(WebSocket);
        ws.stream = stream;
        ws.sock = sock;
        ws.client = client;
        ws.lock = Mutex::New();
        ws.bufCap = 16384U;
        ws.buf = new(byte, 16384U);
        ws.bufStart = 0U;
        ws.bufEnd = 0U;
        var (byte*, uint) r = Strs::ToBytes(rest);
        if(r.1 > 0U) {
            ws.reserve(r.1);
            Arrs::[byte]Copy(r.1, r.0, ws.buf);
            ws.bufEnd = r.1;
        }
        ws.closeSent = false;
        ws.ended = false;
        ws.receiving = false;
        ws.released = false;
        return ws;
    }

    private static fun (WebSocket*, Err*)(str) fail = (msg) {
        var (WebSocket*, Err*) out;
        out.0 = null;
        out.1 = StrErr::New(msg);
        return out;
    }

    // Dial opens a WebSocket to a ws:// or wss:// url, sending headers,
    // which may be null, with the opening handshake. A wss:// connection is
    // verified with ctx, or against the system's roots for a null one.
    public static fun (WebSocket*, Err*)(str, HTTP.Headers*, TLS.Context*) Dial = (url, headers, ctx) {
        var (URL*, Err*) parsed = URL::Parse(url);
        if(parsed.1 != null) {
            return WebSocket::fail(url + ": " + parsed.1.Err());
        }
        var URL* u = parsed.0;
        var bool secure = u.scheme == "wss" || u.scheme == "https";
        if(!secure && u.scheme != "ws" && u.scheme != "http") {
            return WebSocket::fail(url + ": not a WebSocket URL");
        }
        var uint port = u.port;
        if(port == 0U) {
            port = 80U;
            if(secure) {
                port = 443U;
            }
        }
        var (Socket*, Err*) d = TCP::Dial(u.host, port);
        if(d.1 != null) {
            return WebSocket::fail(url + ": " + d.1.Err());
        }
        var Stream* s = d.0;
        if(secure) {
            if(ctx == null) {
                var (TLS.Context*, Err*) roots = TLS.Context::Client("", true);
                if(roots.1 != null) {
                    d.0.Close();
                    return WebSocket::fail(url + ": " + roots.1.Err());
                }
                ctx = roots.0;
            }
            var (TLS*, Err*) t = TLS::Client(d.0, ctx, u.host);
            if(t.1 != null) {
                d.0.Close();
                return WebSocket::fail(url + ": " + t.1.Err());
            }
            s = t.0;
        }

        var str target = u.path;
        if(target == "") {
            target = "/";
        }
        if(u.query != "") {
            target = target + "?" + u.query;
        }
        var str host = u.host;
        if(u.port != 0U) {
            host = host + ":" + u.port{str};
        }
        var str key = WebSocket::newKey();
        var str extra = "";
        if(headers != null) {
            extra = headers.Join(": ", "\r\n");
        }
        var Err* e = Streams::WriteStr(s, "GET " + target + " HTTP/1.1\r\nHost: " + host + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n" + extra + "\r\n");
        if(e != null) {
            s.Close();
            return WebSocket::fail(url + ": " + e.Err());
        }
        var HTTP.Conn* c = HTTP.Conn::New(s, d.0, true);
        var (bool, Err*) next = c.Next();
        var str problem = "";
        if(next.1 != null) {
            problem = next.1.Err();
        } else if(!next.0) {
            problem = "connection closed during the handshake";
        } else if(c.status != 101U) {
            problem = "handshake answered " + c.status{str} + " " + HTTP::StatusText(c.status);
        } else {
            var str want = WebSocket::accept(key);
            if(c.headers.Value("sec-websocket-accept").0 != want) {
                problem = "handshake answered the wrong key";
            }
        }
        if(problem != "") {
            c.Delete();
            s.Close();
            return WebSocket::fail(url + ": " + problem);
        }
        var str rest = c.Rest();
        c.Delete();
        var (WebSocket*, Err*) out;
        out.0 = WebSocket::of(s, d.0, true, rest);
        out.1 = null;
        return out;
    }

    // Accept answers a request to open a WebSocket, hijacking the
    // connection it came on. It fails, leaving the request to be answered,
    // for a request that is not one.
    public static fun (WebSocket*, Err*)(HTTP.Request*) Accept = (req) {
        var (str, bool) key = req.headers.Value("sec-websocket-key");
        if(req.method != "GET" || HTTP.Headers::Fold(req.headers.Value("upgrade").0) != "websocket" || !key.1) {
            return WebSocket::fail("not a WebSocket request");
        }
        if(req.headers.Value("sec-websocket-version").0 != "13") {
            return WebSocket::fail("unsupported WebSocket version");
        }
        var HTTP.Conn* c = req.Hijack();
        if(c == null) {
            return WebSocket::fail("request was not received by a server");
        }
        var str accept = WebSocket::accept(key.0);
        var Err* e = Streams::WriteStr(c.stream, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n");
        if(e != null) {
            c.stream.Close();
            return WebSocket::fail(e.Err());
        }
        var (WebSocket*, Err*) out;
        out.0 = WebSocket::of(c.stream, c.sock, false, c.Rest());
        out.1 = null;
        return out;
    }

    // sendLocked sends one frame; the caller holds the lock.
    private fun Err*(int, byte*, uint) sendLocked = (opcode, b, n) {
        if(this.closeSent || this.released) {
            return StrErr::New("WebSocket is closed");
        }
        if(opcode == 8) {
            this.closeSent = true;
        }
        var byte* frame = new(byte, n + 14U);
        defer free(frame);
        var uint len = WebSocket::frame(opcode, this.client, b, n, frame);
        return Streams::WriteAll(this.stream, frame, len);
    }

    // guid is what RFC 6455 appends to a key before hashing it for the accept.
    private static var str$ guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

    // newKey makes a client's Sec-WebSocket-Key: 16 random bytes, in base64.
    private static fun str() newKey = () {
        var byte* b = new(byte, 16U);
        defer free(b);
        Rand::Read(b, 16U);
        return Base64::Encode(b, 16U);
    }

    // accept answers the Sec-WebSocket-Accept for a key: the base64 of the
    // SHA-1 of the key and the protocol's GUID.
    private static fun str(str) accept = (key) {
        var str s = key + WebSocket::guid;
        var (byte*, uint) p = Strs::ToBytes(s);
        var Arr[byte]* sum = SHA1::Sum(p.0, p.1);
        return Base64::Encode(sum.Arr(), sum.Len());
    }

    // frame writes one final frame of opcode carrying the n bytes at b into
    // out, which has room for n + 14, masking it with a random key when told
    // to, and answers the frame's length.
    private static fun uint(int, bool, byte*, uint, byte*) frame = (opcode, mask, b, n, out) {
        var uint size = n;
        var uint maskBit = 0U;
        if(mask) {
            maskBit = 128U;
        }
        out[0U] = (128U | (opcode{uint} & 15U)){byte};
        var uint at = 2U;
        if(size < 126U) {
            out[1U] = (maskBit | size){byte};
        } else if(size < 65536U) {
            out[1U] = (maskBit | 126U){byte};
            out[2U] = ((size >> 8U) & 255U){byte};
            out[3U] = (size & 255U){byte};
            at = 4U;
        } else {
            out[1U] = (maskBit | 127U){byte};
            for(var uint i = 0U; i < 8U; i++) {
                out[2U + i] = ((size >> (56U - 8U * i)) & 255U){byte};
            }
            at = 10U;
        }
        if(mask) {
            var byte* key = out + at;
            Rand::Read(key, 4U);
            at = at + 4U;
            for(var uint i = 0U; i < size; i++) {
                out[at + i] = (b[i]{uint} ^ key[i & 3U]{uint}){byte};
            }
        } else if(size > 0U) {
            Arrs::[byte]Copy(size, b, out + at);
        }
        return at + size;
    }

    // header reads a frame's head from the n bytes at b: whether it is final,
    // its opcode, its head's length and its payload's length, the head's
    // length being 0 while b holds too little of it to tell.
    private static fun (bool, int, uint, uint)(byte*, uint) header = (b, n) {
        var (bool, int, uint, uint) h;
        h.0 = false;
        h.1 = 0;
        h.2 = 0U;
        h.3 = 0U;
        if(n < 2U) {
            return h;
        }
        h.0 = (b[0U]{uint} & 128U) != 0U;
        h.1 = (b[0U]{uint} & 15U){int};
        var uint len = b[1U]{uint} & 127U;
        var uint need = 2U;
        if(len == 126U) {
            need = 4U;
        } else if(len == 127U) {
            need = 10U;
        }
        if((b[1U]{uint} & 128U) != 0U) {
            need = need + 4U;
        }
        if(n < need) {
            return h;
        }
        if(len == 126U) {
            len = (b[2U]{uint} << 8U) | b[3U]{uint};
        } else if(len == 127U) {
            len = 0U;
            for(var uint i = 0U; i < 8U; i++) {
                len = (len << 8U) | b[2U + i]{uint};
            }
        }
        h.2 = need;
        h.3 = len;
        return h;
    }

    // unmask unmasks the n payload bytes at b in place with the four-byte key
    // at key.
    private static fun void(byte*, uint, byte*) unmask = (b, n, key) {
        for(var uint i = 0U; i < n; i++) {
            b[i] = (b[i]{uint} ^ key[i & 3U]{uint}){byte};
        }
    }

    private fun Err*(int, byte*, uint) send = (opcode, b, n) {
        this.lock.Lock();
        defer this.lock.Unlock();
        return this.sendLocked(opcode, b, n);
    }

    public fun Err*(str) SendText = (s) {
        var (byte*, uint) p = Strs::ToBytes(s);
        return this.send(1, p.0, p.1);
    }

    public fun Err*(byte*, uint) SendBinary = (b, n) {
        return this.send(2, b, n);
    }

    // reserve makes room for n unread bytes in buf.
    private fun void(uint) reserve = (n) {
        var uint len = this.bufEnd - this.bufStart;
        if(this.bufStart > 0U) {
            if(len > 0U) {
                Arrs::[byte]Copy(len, this.buf + this.bufStart, this.buf);
            }
            this.bufStart = 0U;
            this.bufEnd = len;
        }
        if(n <= this.bufCap) {
            return;
        }
        var byte* grown = new(byte, n);
        if(len > 0U) {
            Arrs::[byte]Copy(len, this.buf, grown);
        }
        free(this.buf);
        this.buf = grown;
        this.bufCap = n;
    }

    // fill reads until n bytes are unread, answering false at the end of the
    // stream.
    private fun (bool, Err*)(uint) fill = (n) {
        var (bool, Err*) out;
        out.0 = true;
        out.1 = null;
        if(this.bufEnd - this.bufStart >= n) {
            return out;
        }
        if(this.bufStart + n > this.bufCap) {
            var uint want = n;
            if(want < 16384U) {
                want = 16384U;
            }
            this.reserve(want);
        }
        for(; this.bufEnd - this.bufStart < n;) {
            var (uint, Err*) p = this.stream.Read(this.buf + this.bufEnd, this.bufCap - this.bufEnd);
            if(p.1 != null) {
                out.0 = false;
                out.1 = p.1;
                return out;
            }
            if(p.0 == 0U) {
                out.0 = false;
                return out;
            }
            this.bufEnd = this.bufEnd + p.0;
        }
        return out;
    }

    // release closes the stream once nothing more is to be read or sent;
    // the caller holds the lock.
    private fun void() release = () {
        if(!this.released) {
            this.released = true;
            this.stream.Close();
        }
    }

    // Receive waits for the next whole message, joining its fragments. Once
    // the connection is closed, from either end, it answers a closed message.
    public fun (WebSocket.Message*, Err*)() Receive = () {
        var (WebSocket.Message*, Err*) out;
        out.0 = new(WebSocket.Message);
        out.0.text = false;
        out.0.data = "";
        out.0.closed = true;
        out.1 = null;
        {
            this.lock.Lock();
            defer this.lock.Unlock();
            if(this.ended) {
                return out;
            }
            this.receiving = true;
        }

        var Buffer* message = null;
        for {
            var bool fin;
            var int opcode;
            var uint head = 0U;
            var uint length;
            var (bool, Err*) got = this.fill(2U);
            for(; got.0 && head == 0U;) {
                var (bool, int, uint, uint) h = WebSocket::header(this.buf + this.bufStart, this.bufEnd - this.bufStart);
                fin = h.0;
                opcode = h.1;
                head = h.2;
                length = h.3;
                if(head == 0U) {
                    got = this.fill(this.bufEnd - this.bufStart + 1U);
                }
            }
            if(got.0 && (length > WebSocket::MaxMessage || (message != null && message.Len() + length > WebSocket::MaxMessage))) {
                got.0 = false;
                got.1 = StrErr::New("WebSocket message too large");
            }
            if(got.0) {
                got = this.fill(head + length);
            }
            if(!got.0) {
                if(got.1 != null && !this.closeSent) {
                    out.1 = got.1;
                } else if(message != null) {
                    out.1 = StrErr::New("connection ended in the middle of a message");
                }
                break;
            }
            var byte* payload = this.buf + this.bufStart + head;
            if((this.buf[this.bufStart + 1U]{int} & 128) != 0) {
                WebSocket::unmask(payload, length, payload - 4U);
            }
            this.bufStart = this.bufStart + head + length;
            if(opcode == 8) {
                var uint echo = length;
                if(echo > 2U) {
                    echo = 2U;
                }
                this.lock.Lock();
                defer this.lock.Unlock();
                if(!this.closeSent) {
                    this.sendLocked(8, payload, echo);
                }
                break;
            }
            if(opcode == 9) {
                this.send(10, payload, length);
                continue;
            }
            if(opcode == 10) {
                continue;
            }
            if((opcode == 1 || opcode == 2) && message == null) {
                if(fin) {
                    out.0.text = opcode == 1;
                    out.0.data = Strs::FromBytes(payload, length);
                    out.0.closed = false;
                    break;
                }
                out.0.text = opcode == 1;
                message = Buffer::New();
                message.Write(payload, length);
                continue;
            }
            if(opcode == 0 && message != null) {
                message.Write(payload, length);
                if(fin) {
                    out.0.data = message.Str();
                    out.0.closed = false;
                    message.Delete();
                    break;
                }
                continue;
            }
            out.1 = StrErr::New("WebSocket protocol error: unexpected opcode " + opcode{str});
            break;
        }

        this.lock.Lock();
        defer this.lock.Unlock();
        this.receiving = false;
        if(out.0.closed || out.1 != null) {
            this.ended = true;
            out.0.closed = true;
            this.release();
        }
        return out;
    }

    // Close sends a close frame, if none has been sent, and ends the
    // connection, ending any Receive waiting in another thread.
    public fun void() Close = () {
        this.lock.Lock();
        defer this.lock.Unlock();
        if(!this.closeSent && !this.released) {
            this.sendLocked(8, null, 0U);
        }
        this.ended = true;
        if(this.receiving) {
            this.sock.CloseRead();
            this.sock.CloseWrite();
        } else {
            this.release();
        }
    }

    public fun void() Delete = () {
        free(this.buf);
        this.buf = null;
    }
}
