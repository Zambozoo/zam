// Classes of ASCII chars
public namespace Chars {
    // IsLetter answers whether c is an ASCII letter.
    public static fun bool(char) IsLetter = (c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
    }

    // IsDigit answers whether c is an ASCII decimal digit.
    public static fun bool(char) IsDigit = (c) {
        return c >= '0' && c <= '9';
    }

    // IsSpace answers whether c is ASCII white space: a space, or a tab, line
    // feed, vertical tab, form feed or carriage return.
    public static fun bool(char) IsSpace = (c) {
        return c == ' ' || (c >= '\t' && c <= '\r');
    }
}
