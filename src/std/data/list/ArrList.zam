import {
    "../../lang/System.zam";
    "../../lang/Arrs.zam";
    "../../lang/Arr.zam";
}

// Circularly buffered array-based list
public class ArrList[A] {
    var A* arr;
    var uint start;
    var uint len;
    var uint cap;

    public static fun[A] ArrList[A]*(uint, A...) New = (len, args) {
        return ArrList::[A]NewWithCap(len, len, args...);
    }

    public fun void(uint, A...) Init = (len, args) {
        this.InitWithCap(len, len, args...);
    }

    public static fun[A] ArrList[A]*(uint, uint, A...) NewWithCap = (cap, len, args) {
        var ArrList[A]* a = new(ArrList[A]);
        a.InitWithCap(cap, len, args...);
        return a;
    }

    public fun void(uint, uint, A...) InitWithCap = (cap, len, args) {
        if(cap < len) {
            cap = len;
        }
        this.len = 0U;
        this.arr = new(A, cap);
        this.cap = cap;
        this.start = cap / 4U;
        for(var uint i = 0U; i < len; i++) {
            this.arr[(this.start + i) % cap] = args[i];
        }
        this.len = len;
    }

    private fun void() grow = () {
        var uint newCap = this.cap * 2U;
        if(newCap == 0U) {
            newCap = 1U;
        }
        var uint newStart = newCap / 4U;
        var A* a = new(A, newCap);
        if(this.start + this.len <= this.cap) {
            Arrs::[A]Copy(this.len, this.arr + this.start, a + newStart);
        } else {
            var uint firstCount = this.cap - this.start;
            Arrs::[A]Copy(firstCount, this.arr + this.start, a + newStart);
            Arrs::[A]Copy(this.len - firstCount, this.arr, a + newStart + firstCount);
        }
        // Mark reads arr, cap and start apart, so a collection between the
        // stores below may walk the wrong range of either buffer. The old one
        // is held whole until they are done, which keeps every element
        // reached, and is freed once it is collected.
        var Arr[A]* old = Arr::[A]New(this.cap, this.arr...);
        this.arr = a;
        this.cap = newCap;
        this.start = newStart;
    }

    public fun A() GetFirst = () {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        return this.arr[this.start];
    }

    public fun A() GetLast = () {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        return this.arr[(this.start + this.len - 1U) % this.cap];
    }

    public fun A(uint) Get = (i) {
        if(i >= this.len) {
            System::Panic("Arr out of bounds");
        }
        return this.arr[(this.start + i) % this.cap];
    }

    public fun A(A) SetFirst = (v) {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        var A old = this.arr[this.start];
        this.arr[this.start] = v;
        return old;
    }

    public fun A(A) SetLast = (v) {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        var uint p = (this.start + this.len - 1U) % this.cap;
        var A old = this.arr[p];
        this.arr[p] = v;
        return old;
    }

    public fun A(uint, A) Set = (i, v) {
        if(i >= this.len) {
            System::Panic("Arr out of bounds");
        }
        var uint p = (this.start + i) % this.cap;
        var A old = this.arr[p];
        this.arr[p] = v;
        return old;
    }

    public fun void(A) AddFirst = (v) {
        if(this.len == this.cap) {
            this.grow();
        }
        var uint p = (this.start + this.cap - 1U) % this.cap;
        this.arr[p] = v;
        this.len++;
        this.start = p;
    }

    public fun void(A) AddLast = (v) {
        if(this.len == this.cap) {
            this.grow();
        }
        this.arr[(this.start + this.len) % this.cap] = v;
        this.len++;
    }

    public fun void(uint, A) Add = (i, v) {
        if(i > this.len) {
            System::Panic("Arr out of bounds");
        } else if(i == this.len) {
            return this.AddLast(v);
        } else if(i == 0U) {
            return this.AddFirst(v);
        }

        if(this.len == this.cap) {
            this.grow();
        }

        var uint srcPhys = (this.start + i) % this.cap;
        var uint dstPhys = (this.start + i + 1U) % this.cap;
        var uint count = this.len - i;
        // Counted before the shift, so the last element is within what Mark
        // walks once it has moved out of the slot it was in.
        this.len++;
        if(srcPhys + count <= this.cap && dstPhys + count <= this.cap) {
            Arrs::[A]Copy(count, this.arr + srcPhys, this.arr + dstPhys);
        } else {
            for(var uint j = this.len - 1U; j > i; j--) {
                this.arr[(this.start + j) % this.cap] = this.arr[(this.start + j - 1U) % this.cap];
            }
        }
        this.arr[(this.start + i) % this.cap] = v;
    }

    public fun A() RemoveFirst = () {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        var A old = this.arr[this.start];
        var A zero;
        this.arr[this.start] = zero;
        this.start = (this.start + 1U) % this.cap;
        this.len--;
        return old;
    }

    public fun A() RemoveLast = () {
        if(this.len == 0U) {
            System::Panic("Arr out of bounds");
        }
        var uint p = (this.start + this.len - 1U) % this.cap;
        var A old = this.arr[p];
        var A zero;
        this.arr[p] = zero;
        this.len--;
        return old;
    }

    public fun A(uint) Remove = (i) {
        if(i >= this.len) {
            System::Panic("Arr out of bounds");
        }
        var A old = this.arr[(this.start + i) % this.cap];

        var uint srcPhys = (this.start + i + 1U) % this.cap;
        var uint dstPhys = (this.start + i) % this.cap;
        var uint count = this.len - i - 1U;
        if(srcPhys + count <= this.cap && dstPhys + count <= this.cap) {
            Arrs::[A]Copy(count, this.arr + srcPhys, this.arr + dstPhys);
        } else {
            for(var uint j = i; j + 1U < this.len; j++) {
                this.arr[(this.start + j) % this.cap] = this.arr[(this.start + j + 1U) % this.cap];
            }
        }
        var A zero;
        this.arr[(this.start + this.len - 1U) % this.cap] = zero;
        this.len--;
        return old;
    }

    public fun uint() Len = () {
        return this.len;
    }

    public fun void() Clear = () {
        var A* old = this.arr;
        this.InitWithCap(1U, 0U);
        free(old);
    }

    public fun Arr[A]*() Arr = () {
        var A* a = new(A, this.len);
        for(var uint i = 0U; i < this.len; i++) {
            a[i] = this.arr[(this.start + i) % this.cap];
        }
        return Arr::[A]New(this.len, a...);
    }

    public fun Iter[A]*() Iter = () {
        var Iter[A]* i = new(Iter[A]);
        i.Init(this);
        return i;
    }

    public fun str() Str = () {
        var str s = "[";
        var str spacer = "";
        for(var uint i = 0U; i < this.len; i++) {
            s = s + spacer + this.arr[(this.start + i) % this.cap]{str};
            spacer = ", ";
        }
        return s + "]";
    }

    // The list is emptied before its buffer is freed, so Mark never reads it
    // freed.
    public fun void() Delete = () {
        var A* arr = this.arr;
        this.len = 0U;
        this.cap = 0U;
        this.start = 0U;
        this.arr = null;
        free(arr);
    }

    // Live elements of a circular buffer are at most two runs: from start to the
    // end of the buffer, then from its front.
    public fun void() Mark = () {
        if(this.len == 0U) {
            return;
        }
        var uint first = this.cap - this.start;
        if(first > this.len) {
            first = this.len;
        }
        var A* tail = &(this.arr[this.start]);
        Arrs::[A]MarkAll(first, tail);
        Arrs::[A]MarkAll(this.len - first, this.arr);
    }

    private class Iter[A] {
        var ArrList[A]* l;
        var uint i;

        public fun void(ArrList[A]*) Init = (l) {
            this.InitWithIndex(l, 0U);
        }

        public fun void(ArrList[A]*, uint) InitWithIndex = (l, i) {
            if(i > l.Len()) {
                System::Panic("Arr out of bounds");
            }
            this.l = l;
            this.i = i;
        }

        public fun (A, bool)() Next = () {
            var (A, bool) p;
            if(this.i >= this.l.Len()) {
                p.1 = false;
                return p;
            }
            p.0 = this.l.Get(this.i);
            this.i++;
            p.1 = true;
            return p;
        }

        public fun (A, bool)() Prev = () {
            var (A, bool) p;
            if(this.i == 0U) {
                p.1 = false;
                return p;
            }
            this.i--;
            p.0 = this.l.Get(this.i);
            p.1 = true;
            return p;
        }
    }
}
