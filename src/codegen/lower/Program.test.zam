import {
    std("data/list/ArrList.zam");
    std("data/map/HashMap.zam");
    std("io/local/FS.zam");
    std("lang/Arr.zam");
    std("lang/Err.zam");
    std("lang/Strs.zam");
    std("test/Assert.zam");
    "../../cli/Optimization.zam";
    "../../cli/Target.zam";
    "../../syntax/MapSources.test.zam";
    "../../syntax/ProjectParser.zam";
    "../../semantic/Model.zam";
    "../../semantic/Semantic.zam";
    "../Collect.zam";
    "../Layout.zam";
