import {
    std("data/list/ArrList.zam");
    std("data/map/HashMap.zam");
    std("lang/Err.zam");
    std("lang/StrErr.zam");
    std("lang/Strs.zam");
    std("lang/System.zam");
    std("lang/Arr.zam");
    "../cli/Command.zam";
    "../cli/Target.zam";
    "../syntax/TokenKind.zam";
    ast = "../syntax/ast/*";
    "../semantic/Model.zam";
    "../semantic/Subtyping.zam";
    "../semantic/Type.zam";
    "ImageWriter.zam";
    "Zig.zam";
    "Collect.zam";
    "Layout.zam";
    "Runtime.zam";
    "Statics.zam";
    "ir/Module.zam";
    "lower/Program.zam";
    "TypeIds.zam";
}

// Codegen generates what a validated program is run from
public namespace Codegen {
    // Image answers the runtime image of the program m models, built as cmd configures it
    public fun ArrList[byte]*(Model*, Command*) Image = (m, cmd) {
        return ImageWriter::Write(m, cmd, TypeIds::New(m, Codegen::canonical()));
    }

    // Main answers why the program m models has no method to be entered through
    public fun Err*(Model*) Main = (m) {
        var ast.Decl* d = m.Program().main;
        var str name = d.name.value{str};
        var ast.Field.Method* entry = null;
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Field.Method* f = d.fields.Get(i){ast.Field.Method*};
            if(f != null && ast.Modifier::Static.In(f.modifiers) && f.name.value{str} == "main") {
                entry = f;
            }
        }
        if(entry == null) {
            return m.At(d, d.start, StrErr::New("main method not found in main code declaration " + name));
        }
        var Type* want = Type.Function::New(null, Type.Primitive::New(null, TokenKind::Void), ArrList::[Type*]New(2U,
            Type.Primitive::New(null, TokenKind::Uint),
            Type.Wrapped::New(null, ast.Type.Wrap::Variadic, Type.Primitive::New(null, TokenKind::String))));
        var Type* got = m.TypeOf(entry.signature);
        if(!Subtyping::New(m).Equal(got, want)) {
            return m.At(d, d.start, StrErr::New("main method " + name + "::main is of type " + Strs::Quote(got.Text()) + ", not " + Strs::Quote(want.Text())));
        }
        return null;
    }

    // MainName answers the name the main method of the program m models is compiled under
    public fun str(Model*) MainName = (m) {
        var ast.Decl* d = m.Program().main;
        var str name = d.name.value{str};
        for(var ast.Decl* outer = m.Outer(d); outer != null; outer = m.Outer(outer)) {
            name = outer.name.value{str} + "." + name;
        }
        return name + ".main";
    }

    // Compiled is a program's object file, its trapped functions, and the statements it covers
    public class Compiled {
        public var ArrList[byte]* object;
        public var ArrList[str]* traps;
        public var ArrList[Collect.Statement*]* covered;
    }

    // Object compiles the program m models, built as cmd configures it
    public fun (Codegen.Compiled*, Err*)(Model*, Command*, str, str) Object = (m, cmd, cache, runtime) {
        var Target target = cmd.target;
        if(!cmd.hasTarget) {
            var (Target, Err*) host = Zig::Host(cache);
            if(host.1 != null) {
                return (null, host.1);
            }
            target = host.0;
        }
        var (HashMap[str, str]*, Err*) tables = Runtime::Tables(runtime);
        if(tables.1 != null) {
            return (null, tables.1);
        }
        var TypeIds* ids = TypeIds::New(m, Codegen::canonical());
        var Layout* layout = Layout::New(m);
        var Collect* collected = Collect::Run(m, ids);
        var Arr[str]* natives = collected.Natives().Arr();
        var Err* invalid = Runtime::Validate(natives, tables.0);
        if(invalid != null) {
            return (null, invalid);
        }
        var ArrList[Collect.Statement*]* covered = null;
        if(cmd.coverProfile != "") {
            covered = collected.Statements();
        }
        var (Module*, ArrList[str]*) lowered = Program::Lower(m, target.triple, Codegen::Image(m, cmd), ids, layout, Statics::Lay(m, ids, layout, collected), natives, tables.0, covered);
        var (ArrList[byte]*, Err*) object = Zig::Compile(lowered.0, target, cache, cmd.optimization);
        if(object.1 != null) {
            return (null, object.1);
        }
        var Codegen.Compiled* c = new(Codegen.Compiled);
        c.object = object.0;
        c.traps = lowered.1;
        c.covered = covered == null ? ArrList::[Collect.Statement*]New(0U) : covered;
        return (c, null);
    }

    // canonical reports whether the lists the passes filled are to be put in canonical order
    fun bool() canonical = () {
        var (str, bool) env = System::Env("ZAM_CANONICAL_ORDER");
        return env.1 && env.0 != "";
    }

    // Hex writes bytes as lowercase hexadecimal, two digits a byte
    public fun str(ArrList[byte]*) Hex = (bytes) {
        var (byte*, uint) digits = Strs::ToBytes("0123456789abcdef");
        var uint n = bytes.Len() * 2U;
        if(n == 0U) {
            return "";
        }
        var byte* out = new(byte, n);
        for(var uint i = 0U; i < bytes.Len(); i++) {
            var byte b = bytes.Get(i);
            out[2U * i] = digits.0[(b >> 4){uint}];
            out[2U * i + 1U] = digits.0[(b & 15{byte}){uint}];
        }
        return Strs::FromBytes(out, n);
    }
}
