import {
    std("data/list/ArrList.zam");
    std("lang/Strs.zam");
}

// Quote spells names and byte strings the way LLVM's textual IR reads them
public namespace Quote {
    // Name answers name as an identifier, quoted when it holds anything an identifier cannot
    public fun str(str) Name = (name) {
        var (byte*, uint) bytes = Strs::ToBytes(name);
        var bool plain = bytes.1 > 0U && !(bytes.0[0U] >= '0'{byte} && bytes.0[0U] <= '9'{byte});
        for(var uint i = 0U; i < bytes.1 && plain; i++) {
            var byte c = bytes.0[i];
            plain = (c >= 'a'{byte} && c <= 'z'{byte}) || (c >= 'A'{byte} && c <= 'Z'{byte}) || (c >= '0'{byte} && c <= '9'{byte}) || c == '_'{byte} || c == '.'{byte} || c == '$'{byte} || c == '-'{byte};
        }
        if(plain) {
            return name;
        }
        return "\"" + Quote::escaped(bytes.0, bytes.1) + "\"";
    }

    // Text answers s as a metadata string
    public fun str(str) Text = (s) {
        var (byte*, uint) bytes = Strs::ToBytes(s);
        return "\"" + Quote::escaped(bytes.0, bytes.1) + "\"";
    }

    // Bytes answers n bytes at b as a c"..." string
    public fun str(byte*, uint) Bytes = (b, n) {
        return "c\"" + Quote::escaped(b, n) + "\"";
    }

    // escaped answers n bytes at b with a quote, a backslash and every byte that is not printable written as \XX
    fun str(byte*, uint) escaped = (b, n) {
        if(n == 0U) {
            return "";
        }
        var (byte*, uint) alphabet = Strs::ToBytes("0123456789ABCDEF");
        var byte* out = new(byte, n * 3U);
        var uint at = 0U;
        for(var uint i = 0U; i < n; i++) {
            var byte c = b[i];
            if(c < ' '{byte} || c > '~'{byte} || c == '"'{byte} || c == '\\'{byte}) {
                out[at] = '\\'{byte};
                out[at + 1U] = alphabet.0[(c >> 4{byte}){uint}];
                out[at + 2U] = alphabet.0[(c & 15{byte}){uint}];
                at = at + 3U;
            } else {
                out[at] = c;
                at++;
            }
        }
        var str s = Strs::FromBytes(out, at);
        free out;
        return s;
    }

    // Join answers parts written one after another
    public fun str(ArrList[str]*) Join = (parts) {
        var uint total = 0U;
        for(var uint i = 0U; i < parts.Len(); i++) {
            total = total + Strs::ToBytes(parts.Get(i)).1;
        }
        if(total == 0U) {
            return "";
        }
        var byte* out = new(byte, total);
        var uint at = 0U;
        for(var uint i = 0U; i < parts.Len(); i++) {
            var (byte*, uint) part = Strs::ToBytes(parts.Get(i));
            for(var uint j = 0U; j < part.1; j++) {
                out[at] = part.0[j];
                at++;
            }
        }
        var str s = Strs::FromBytes(out, total);
        free out;
        return s;
    }

    // Hex answers v as uppercase hexadecimal, at least digits wide
    public fun str(uint, uint) Hex = (v, digits) {
        var (byte*, uint) alphabet = Strs::ToBytes("0123456789ABCDEF");
        var str out = "";
        for(var uint i = 0U; i < digits || v != 0U; i++) {
            out = Strs::FromBytes(&(alphabet.0[v & 15U]), 1U) + out;
            v = v >> 4U;
        }
        return out;
    }
}
