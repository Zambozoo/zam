import std("data/list/ArrList.zam");
import std("data/set/HashSet.zam");
import "../syntax/Path.zam";
import "../syntax/Source.zam";
import "../syntax/SourceErr.zam";
import "../syntax/Token.zam";
import "../syntax/TokenKind.zam";
import ast = "../syntax/ast/*";
import "../semantic/Model.zam";
import "Intrinsics.zam";
import "TypeIds.zam";

// Collect gathers the natives and string literals a program names, in the order Go's collector meets them, which is what numbers their slots
public class Collect {
    // Statement is a statement a program compiled for coverage records running, by the token it starts at and where that lies
    public class Statement {
        public var Token* at;
        public var str path;
        public var uint line;
        public var uint column;
    }

    var ArrList[str]* natives;
    // statements is every statement of the program's own files, in no order yet
    var ArrList[Statement*]* statements;
    // source is the file being walked, or null for one whose statements are not covered
    var Source* source;
    var HashSet[str]* nativeSet;
    var ArrList[str]* literals;
    var HashSet[str]* literalSet;

    // Run walks the program m models, its files in ids' order
    public static fun Collect*(Model*, TypeIds*) Run = (m, ids) {
        var Collect* c = new(Collect);
        c.natives = ArrList::[str]New(0U);
        c.nativeSet = HashSet::[str]New(0U);
        c.literals = ArrList::[str]New(0U);
        c.literalSet = HashSet::[str]New(0U);
        c.statements = ArrList::[Statement*]New(0U);
        var ArrList[Source*]* files = ids.Files();
        for(var uint i = 0U; i < files.Len(); i++) {
            var Source* source = files.Get(i);
            c.source = null;
            if(!Path::IsStd(source.path) && !Path::IsTestFile(source.path)) {
                c.source = source;
            }
            c.decl(source.file.decl);
        }
        return c;
    }

    // Statements answers every statement of the program's own files, those of neither the standard library nor tests, by file, line and column
    public fun ArrList[Statement*]*() Statements = () {
        var ArrList[Statement*]* sorted = ArrList::[Statement*]New(0U);
        var HashSet[Token*]* seen = HashSet::[Token*]New(0U);
        for(var uint i = 0U; i < this.statements.Len(); i++) {
            var Statement* s = this.statements.Get(i);
            if(!seen.Add(s.at)) {
                continue;
            }
            var uint at = sorted.Len();
            for(; at > 0U && Collect::after(sorted.Get(at - 1U), s); at--) {}
            sorted.Add(at, s);
        }
        return sorted;
    }

    // after reports whether a lies after b, by file, line and column
    static fun bool(Statement*, Statement*) after = (a, b) {
        if(a.path != b.path) {
            return a.path > b.path;
        } else if(a.line != b.line) {
            return a.line > b.line;
        }
        return a.column > b.column;
    }

    // record records the statement starting at tok, when its file is covered
    fun void(Token*) record = (tok) {
        if(this.source == null || tok == null) {
            return;
        }
        var (uint, uint) position = SourceErr::Position(this.source.lineStarts, tok.offset);
        var Statement* s = new(Statement);
        s.at = tok;
        s.path = this.source.path;
        s.line = position.0;
        s.column = position.1;
        this.statements.AddLast(s);
    }

    // Natives answers the natives called through the native table, in slot order
    public fun ArrList[str]*() Natives = () {
        return this.natives;
    }

    // Literals answers the distinct string literals, in the order they are interned
    public fun ArrList[str]*() Literals = () {
        return this.literals;
    }

    // decl walks d's static fields, then its instance fields, Str first in a struct or enum, then the declarations nested in it
    fun void(ast.Decl*) decl = (d) {
        if(d.kind == ast.Field.Kind::Alias) {
            return;
        }
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Field* f = d.fields.Get(i);
            if(f{ast.Decl*} == null && Collect::held(f)) {
                this.field(f);
            }
        }
        var bool strFirst = d.kind == ast.Field.Kind::Struct || d.kind == ast.Field.Kind::Enum;
        if(strFirst) {
            for(var uint i = 0U; i < d.fields.Len(); i++) {
                var ast.Field* f = d.fields.Get(i);
                if(f{ast.Decl*} == null && !Collect::held(f) && f.name.value{str} == "Str") {
                    this.field(f);
                }
            }
        }
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Field* f = d.fields.Get(i);
            if(f{ast.Decl*} == null && !Collect::held(f) && !(strFirst && f.name.value{str} == "Str")) {
                this.field(f);
            }
        }
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Decl* nested = d.fields.Get(i){ast.Decl*};
            if(nested != null) {
                this.decl(nested);
            }
        }
    }

    fun void(ast.Field*) field = (f) {
        switch(f.kind) {
            case (ast.Field.Kind::Value) {
                this.exprs(f{ast.Field.Value*}.arguments);
                this.expr(f{ast.Field.Value*}.value);
            }
            case (ast.Field.Kind::Member)
                this.expr(f{ast.Field.Member*}.init);
            case (ast.Field.Kind::Method)
                this.stmt(f{ast.Field.Method*}.body);
        }
    }

    fun void(ast.Stmt*) stmt = (s) {
        if(s == null) {
            return;
        } else if(s.kind != ast.Stmt.Kind::Block) {
            this.record(s.start);
        }
        switch(s.kind) {
            case (ast.Stmt.Kind::Block) {
                var ArrList[ast.Stmt*]* statements = s{ast.Stmt.Block*}.statements;
                for(var uint i = 0U; i < statements.Len(); i++) {
                    this.stmt(statements.Get(i));
                }
            }
            case (ast.Stmt.Kind::Expr, ast.Stmt.Kind::Return, ast.Stmt.Kind::Delete, ast.Stmt.Kind::Free, ast.Stmt.Kind::Mark)
                this.expr(s{ast.Stmt.Value*}.value);
            case (ast.Stmt.Kind::For) {
                var ast.Stmt.For* f = s{ast.Stmt.For*};
                this.stmt(f.init);
                this.expr(f.condition);
                this.stmt(f.body);
                if(f.step != null) {
                    this.record(f.step.start);
                }
                this.expr(f.step);
                this.stmt(f.otherwise);
            }
            case (ast.Stmt.Kind::If) {
                var ast.Stmt.If* i = s{ast.Stmt.If*};
                this.expr(i.condition);
                this.stmt(i.then);
                this.stmt(i.otherwise);
            }
            case (ast.Stmt.Kind::Label)
                this.stmt(s{ast.Stmt.Label*}.target);
            case (ast.Stmt.Kind::Defer)
                this.stmt(s{ast.Stmt.Defer*}.deferred);
            case (ast.Stmt.Kind::Switch) {
                var ast.Stmt.Switch* sw = s{ast.Stmt.Switch*};
                this.expr(sw.subject);
                for(var uint i = 0U; i < sw.cases.Len(); i++) {
                    this.exprs(sw.cases.Get(i).values);
                }
                for(var uint i = 0U; i < sw.cases.Len(); i++) {
                    this.stmt(sw.cases.Get(i).body);
                }
                this.stmt(sw.otherwise);
            }
            case (ast.Stmt.Kind::Unpack)
                this.expr(s{ast.Stmt.Unpack*}.init);
            case (ast.Stmt.Kind::Variable)
                this.expr(s{ast.Stmt.Variable*}.init);
        }
    }

    fun void(ArrList[ast.Expr*]*) exprs = (es) {
        if(es == null) {
            return;
        }
        for(var uint i = 0U; i < es.Len(); i++) {
            this.expr(es.Get(i));
        }
    }

    fun void(ast.Expr*) expr = (e) {
        if(e == null) {
            return;
        }
        switch(e.kind) {
            case (ast.Expr.Kind::Cast)
                this.expr(e{ast.Expr.Cast*}.inner);
            case (ast.Expr.Kind::Field)
                this.expr(e{ast.Expr.Field*}.target);
            case (ast.Expr.Kind::Lambda)
                this.stmt(e{ast.Expr.Lambda*}.body);
            case (ast.Expr.Kind::NAry)
                this.exprs(e{ast.Expr.NAry*}.operands);
            case (ast.Expr.Kind::Unary)
                this.expr(e{ast.Expr.Unary*}.operand);
            case (ast.Expr.Kind::Ternary) {
                var ast.Expr.Ternary* t = e{ast.Expr.Ternary*};
                this.expr(t.condition);
                this.expr(t.then);
                this.expr(t.otherwise);
            }
            case (ast.Expr.Kind::Tuple)
                this.exprs(e{ast.Expr.Tuple*}.elements);
            case (ast.Expr.Kind::Call) {
                this.expr(e{ast.Expr.Call*}.callee);
                this.exprs(e{ast.Expr.Call*}.arguments);
            }
            case (ast.Expr.Kind::Spread)
                this.expr(e{ast.Expr.Spread*}.inner);
            case (ast.Expr.Kind::Index) {
                this.expr(e{ast.Expr.Index*}.target);
                this.expr(e{ast.Expr.Index*}.index);
            }
            case (ast.Expr.Kind::Async)
                this.expr(e{ast.Expr.Async*}.call);
            case (ast.Expr.Kind::Wait)
                this.expr(e{ast.Expr.Wait*}.waited);
            case (ast.Expr.Kind::New) {
                this.expr(e{ast.Expr.New*}.count);
                this.expr(e{ast.Expr.New*}.tail);
            }
            case (ast.Expr.Kind::Native) {
                var str name = e{ast.Expr.Native*}.id.value{str};
                if(!Intrinsics::Is(name) && this.nativeSet.Add(name)) {
                    this.natives.AddLast(name);
                }
            }
            case (ast.Expr.Kind::Symbol) {
                if(e.start.kind == TokenKind::StringLiteral && this.literalSet.Add(e.start.value{str})) {
                    this.literals.AddLast(e.start.value{str});
                }
            }
        }
    }

    // held reports whether f is held by its declaration, as an enum value always is
    static fun bool(ast.Field*) held = (f) {
        return f.kind == ast.Field.Kind::Value || ast.Modifier::Static.In(f.modifiers);
    }
}
