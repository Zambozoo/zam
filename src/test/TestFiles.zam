import {
    io = std("io/Paths.zam");
    std("data/list/ArrList.zam");
    std("data/set/HashSet.zam");
    std("data/sort/Sort.zam");
    std("io/local/FS.zam");
    std("lang/Arr.zam");
    std("lang/Err.zam");
    std("lang/StrErr.zam");
    std("lang/Strs.zam");
    std("codec/text/Regex.zam");
    ast = "../syntax/ast/*";
    "../cli/Paths.zam";
    "../syntax/Path.zam";
    "../syntax/ProjectParser.zam";
    "../syntax/Source.zam";
    "../syntax/SourceErr.zam";
}

// TestFiles finds the test files the targets of zam test name
public namespace TestFiles {
    namespace Errs {
        public fun Err*(str) Missing = (target) {
            return StrErr::New(target + " does not exist");
        }

        public fun Err*(str) NotTestable = (target) {
            return StrErr::New(target + " is not a directory or a " + Path::TestExtension + " file");
        }

        public fun Err*(str, Err*) Unlistable = (dir, err) {
            return StrErr::New("cannot list test files in " + Strs::Quote(Path::Display(dir)) + ": " + err.Err());
        }

        public fun Err*(str) Unparsed = (path) {
            return StrErr::New(Path::Display(path) + " was not parsed");
        }

        public fun Err*(str, str, str) Misnamed = (file, want, got) {
            return StrErr::New("the root declaration of a test file " + file + " must be named " + want + ", not " + got);
        }

        public fun Err*(str) Private = (file) {
            return StrErr::New("the root declaration of a test file " + file + " must be public");
        }
    }

    // RecursiveSuffix ends a target naming every directory beneath it too
    public var str$ RecursiveSuffix = "/...";
    // RootSuffix ends the name of a test file's root declaration
    public var str$ RootSuffix = "Test";
    // mainType is the type of a main method, as it is written
    var str$ mainType = "void(uint, str...)";

    // File is a test file and the tests found in it
    public class File {
        public var str path;
        // decl is the name of its root declaration
        public var str decl;
        // tests is the names of its test methods, in the order they are written
        public var ArrList[str]* tests;
    }

    // Discover answers the tests of each of paths in program
    public fun (ArrList[TestFiles.File*]*, Err*)(ProjectParser.Program*, ArrList[str]*, Regex*) Discover = (program, paths, pattern) {
        var ArrList[TestFiles.File*]* files = ArrList::[TestFiles.File*]New(0U);
        for(var uint i = 0U; i < paths.Len(); i++) {
            var (Source*, bool) source = program.sources.Get(paths.Get(i));
            if(!source.1) {
                return (null, Errs::Unparsed(paths.Get(i)));
            }
            var ast.Decl* d = source.0.file.decl;
            var str base = io.Paths::Base(paths.Get(i));
            var str want = Strs::Slice(base, 0U, Strs::ByteLen(base) - Strs::ByteLen(Path::TestExtension)) + TestFiles::RootSuffix;
            var str name = d.name.value{str};
            if(name != want) {
                return (null, SourceErr::At(Errs::Misnamed(base, want, name), source.0.path, source.0.lineStarts, d.start));
            } else if(!ast.Modifier::Public.In(d.modifiers)) {
                return (null, SourceErr::At(Errs::Private(base), source.0.path, source.0.lineStarts, d.start));
            }

            var TestFiles.File* file = new(TestFiles.File);
            file.path = paths.Get(i);
            file.decl = name;
            file.tests = ArrList::[str]New(0U);
            for(var uint j = 0U; j < d.fields.Len(); j++) {
                var ast.Field.Method* method = d.fields.Get(j){ast.Field.Method*};
                if(method == null || !ast.Modifier::Static.In(method.modifiers) || !ast.Modifier::Public.In(method.modifiers) || method.signature.Text() != TestFiles::mainType) {
                    continue;
                }
                var str test = method.name.value{str};
                if(pattern.Match(name + "." + test)) {
                    file.tests.AddLast(test);
                }
            }
            if(file.tests.Len() > 0U) {
                files.AddLast(file);
            }
        }
        return (files, null);
    }

    // Resolve answers the test files targets name
    public fun (ArrList[str]*, Err*)(Arr[str]*) Resolve = (targets) {
        var ArrList[str]* paths = ArrList::[str]New(0U);
        var HashSet[str]* seen = HashSet::[str]New(0U);
        for(var uint i = 0U; i < targets.Len(); i++) {
            var str target = targets.Get(i);
            var str dir = FS::ToSlash(target);
            var bool recursive = Strs::HasSuffix(dir, TestFiles::RecursiveSuffix);
            if(recursive) {
                dir = Strs::Slice(dir, 0U, Strs::ByteLen(dir) - Strs::ByteLen(TestFiles::RecursiveSuffix));
            }
            if(dir == "") {
                dir = ".";
            }
            var (str, Err*) path = Paths::Parse(dir);
            if(path.1 != null) {
                return (null, path.1);
            } else if(!FS::Exists(path.0)) {
                return (null, Errs::Missing(target));
            }

            var ArrList[str]* found = ArrList::[str]New(0U);
            if(FS::IsDir(path.0)) {
                var (ArrList[str]*, Err*) listed = TestFiles::List(path.0, recursive);
                if(listed.1 != null) {
                    return (null, listed.1);
                }
                found = listed.0;
            } else if(recursive || !Path::IsTestFile(path.0)) {
                return (null, Errs::NotTestable(target));
            } else {
                found.AddLast(path.0);
            }
            for(var uint j = 0U; j < found.Len(); j++) {
                if(seen.Add(found.Get(j))) {
                    paths.AddLast(found.Get(j));
                }
            }
        }
        return (paths, null);
    }

    // List answers the test files in dir, sorted, and those in the directories beneath it when recursive
    public fun (ArrList[str]*, Err*)(str, bool) List = (dir, recursive) {
        var ArrList[str]* files = ArrList::[str]New(0U);
        var Err* err = TestFiles::walk(dir, recursive, files);
        if(err != null) {
            return (null, Errs::Unlistable(dir, err));
        }
        var Arr[str]* sorted = files.Arr();
        Sort::[str]SortArr(sorted);
        var ArrList[str]* out = ArrList::[str]New(0U);
        for(var uint i = 0U; i < sorted.Len(); i++) {
            out.AddLast(sorted.Get(i));
        }
        return (out, null);
    }

    // walk adds the test files in dir to files, and those beneath it when recursive
    fun Err*(str, bool, ArrList[str]*) walk = (dir, recursive, files) {
        var (Arr[str]*, Err*) names = FS::ReadDir(dir);
        if(names.1 != null) {
            return names.1;
        }
        for(var uint i = 0U; i < names.0.Len(); i++) {
            var str name = names.0.Get(i);
            var str path = io.Paths::Join(dir, name);
            if(!FS::IsLink(path) && FS::IsDir(path)) {
                if(recursive && !Strs::HasPrefix(name, ".")) {
                    var Err* err = TestFiles::walk(path, recursive, files);
                    if(err != null) {
                        return err;
                    }
                }
            } else if(Path::IsTestFile(name)) {
                files.AddLast(path);
            }
        }
        return null;
    }
}
