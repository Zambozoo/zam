import {
    io = std("io/Paths.zam");
    std("data/list/ArrList.zam");
    std("io/local/FS.zam");
    std("lang/Arr.zam");
    std("lang/Err.zam");
    std("lang/Strs.zam");
    std("codec/text/Regex.zam");
    std("test/Assert.zam");
    "../syntax/MapSources.test.zam";
    "../syntax/Path.zam";
    "../syntax/ProjectParser.zam";
    "TestFiles.zam";
}

public namespace TestFilesTest {
    // tree answers a new directory of test files, one beside others, one in
    // a subdirectory and one in a directory whose name begins with a dot
    private fun str() tree = () {
        var str dir = FS::MakeTempDir(FS::ToSlash(FS::TempDir()), "zam-tests-").0;
        FS::MakeDirs(io.Paths::Join(dir, "sub"));
        FS::MakeDirs(io.Paths::Join(dir, ".hidden"));
        FS::WriteFile(io.Paths::Join(dir, "B.test.zam"), "");
        FS::WriteFile(io.Paths::Join(dir, "A.test.zam"), "");
        FS::WriteFile(io.Paths::Join(dir, "Main.zam"), "");
        FS::WriteFile(io.Paths::Join(dir, "sub/C.test.zam"), "");
        FS::WriteFile(io.Paths::Join(dir, ".hidden/D.test.zam"), "");
        return dir;
    }

    // names answers the paths of files relative to dir, joined by spaces
    private fun str(str, ArrList[str]*) names = (dir, files) {
        var str out = "";
        for(var uint i = 0U; i < files.Len(); i++) {
            if(i > 0U) {
                out = out + " ";
            }
            out = out + Strs::Slice(files.Get(i), Strs::ByteLen(dir) + 1U, Strs::ByteLen(files.Get(i)));
        }
        return out;
    }

    public fun void(uint, str...) Resolve = (argC, argV) {
        var str dir = TestFilesTest::tree();
        defer FS::RemoveAll(dir);
        Assert::[str]Equal("A.test.zam B.test.zam", TestFilesTest::names(dir, TestFiles::Resolve(Arr::[str]New(1U, dir)).0));
        Assert::[str]Equal("A.test.zam B.test.zam sub/C.test.zam", TestFilesTest::names(dir, TestFiles::Resolve(Arr::[str]New(1U, dir + "/...")).0));
        Assert::[str]Equal("sub/C.test.zam A.test.zam B.test.zam",
            TestFilesTest::names(dir, TestFiles::Resolve(Arr::[str]New(3U, io.Paths::Join(dir, "sub/C.test.zam"), dir, io.Paths::Join(dir, "A.test.zam"))).0));
    }

    public fun void(uint, str...) Errors = (argC, argV) {
        var str dir = TestFilesTest::tree();
        defer FS::RemoveAll(dir);
        var str missing = io.Paths::Join(dir, "Missing.test.zam");
        Assert::[str]Equal(missing + " does not exist", TestFiles::Resolve(Arr::[str]New(1U, missing)).1.Err());
        var str main = io.Paths::Join(dir, "Main.zam");
        Assert::[str]Equal(main + " is not a directory or a .test.zam file", TestFiles::Resolve(Arr::[str]New(1U, main)).1.Err());
        var str file = io.Paths::Join(dir, "A.test.zam") + "/...";
        Assert::[str]Equal(file + " is not a directory or a .test.zam file", TestFiles::Resolve(Arr::[str]New(1U, file)).1.Err());
    }

    // discovered answers the tests discover finds in the test files of texts, alternating paths and sources, as path:Decl.test, or the error it answers
    private fun str(str, uint, str...) discovered = (pattern, n, texts) {
        var ArrList[str]* paths = ArrList::[str]New(0U);
        for(var uint i = 0U; i + 1U < n; i = i + 2U) {
            paths.AddLast(texts[i]);
        }
        var str entry = paths.RemoveFirst();
        var (ProjectParser.Program*, ArrList[Err*]*) program = ProjectParser::New(MapSourcesTest.Sources::New(MapSourcesTest::Files(n, texts...)), MapSourcesTest.Packages::New(MapSourcesTest::Files(0U)), 1U, true, false).Parse(entry, paths.Arr());
        if(program.1.Len() > 0U) {
            return program.1.Get(0U).Err();
        }
        paths.Add(0U, entry);
        var (ArrList[TestFiles.File*]*, Err*) files = TestFiles::Discover(program.0, paths, Regex::Compile(pattern).0);
        if(files.1 != null) {
            return files.1.Err();
        }
        var str out = "";
        for(var uint i = 0U; i < files.0.Len(); i++) {
            var TestFiles.File* f = files.0.Get(i);
            for(var uint j = 0U; j < f.tests.Len(); j++) {
                out = out + " " + f.path + ":" + f.decl + "." + f.tests.Get(j);
            }
        }
        return Strs::TrimSpace(out);
    }

    public fun void(uint, str...) Discover = (argC, argV) {
        var str a = "public namespace ATest {\n    public fun void(uint, str...) Second = (argC, argV) {}\n    public fun void(uint, str...) First = (argC, argV) {}\n    fun void(uint, str...) hidden = (argC, argV) {}\n    public fun int(uint, str...) Typed = (argC, argV) { return 0; }\n    public var int field = 0;\n}\n";
        var str b = "public namespace BTest {\n    public fun void(uint, str...) Only = (argC, argV) {}\n}\n";
        var str none = "public namespace NoneTest {\n}\n";
        Assert::[str]Equal("/p/A.test.zam:ATest.Second /p/A.test.zam:ATest.First /p/B.test.zam:BTest.Only",
            TestFilesTest::discovered("", 6U, "/p/A.test.zam", a, "/p/None.test.zam", none, "/p/B.test.zam", b));
        Assert::[str]Equal("/p/A.test.zam:ATest.First", TestFilesTest::discovered("ATest\\.F", 4U, "/p/A.test.zam", a, "/p/B.test.zam", b));
        Assert::[str]Equal("", TestFilesTest::discovered("Missing", 2U, "/p/A.test.zam", a));
        Assert::[str]Equal("the root declaration of a test file C.test.zam must be named CTest, not ATest (" + Path::Display("/p/C.test.zam") + "[1:8])",
            TestFilesTest::discovered("", 2U, "/p/C.test.zam", a));
        Assert::[str]Equal("the root declaration of a test file P.test.zam must be public (" + Path::Display("/p/P.test.zam") + "[1:1])",
            TestFilesTest::discovered("", 2U, "/p/P.test.zam", "namespace PTest {\n}\n"));
    }
}
