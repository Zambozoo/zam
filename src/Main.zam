import std("data/list/ArrList.zam");
import std("io/Paths.zam");
import std("io/local/File.zam");
import std("io/local/FS.zam");
import std("lang/Arr.zam");
import std("lang/Arrs.zam");
import std("lang/Err.zam");
import std("lang/StrErr.zam");
import std("lang/Strs.zam");
import std("lang/System.zam");
import cli = "cli/Paths.zam";
import "cli/Command.zam";
import "cli/LocalFiles.zam";
import "cli/Verb.zam";
import "codegen/Codegen.zam";
import "codegen/Runtime.zam";
import "build/Build.zam";
import "build/Pack.zam";
import "syntax/LocalPackages.zam";
import "syntax/LocalSources.zam";
import "syntax/PackageArchive.zam";
import "syntax/Path.zam";
import "syntax/Project.zam";
import "semantic/Model.zam";
import "semantic/Dump.zam";
import "semantic/Semantic.zam";
import "syntax/ProjectParser.zam";
import "test/TestFiles.zam";

namespace Main {
    namespace Errs {
        public var Err*$ NoStd = StrErr::New("cannot find the standard library: set ZAM_STD to its directory");
        public var Err*$ NoHome = StrErr::New("cannot find the home directory for ZAMPATH");
    }

    private var str$ name = "zam";

    private enum Step : str {
        Command("command"),
        Std("std"),
        Syntax("syntax"),
        Semantic("semantic"),
        Codegen("codegen"),
        Build("build"),
        Run("run"),
        Get("get"),
        Clean("clean"),
        Test("test");
    }

    fun Arr[str]*(uint, str...) asArgs = (argC, argV) {
        var uint len = argC + 1U;
        var str* args = new(str, len);
        var Arr[str]* arr = Arr::[str]New(len, args...);
        args[0U] = name;
        Arrs::[str]Copy(argC, argV, args + 1U);
        return arr;
    }

    // onError writes the n errs that are not null, and exits when there are any
    fun void(Step, uint, Err*...) onError = (step, n, errs) {
        var bool failed = false;
        for(var uint i = 0U; i < n; i++) {
            if(errs[i] != null) {
                File::StdErr.WriteStr(Strs::Sprintf("[%s] %s\n", step, errs[i].Err()));
                failed = true;
            }
        }
        if(failed) {
            System::Exit(1);
        }
    }

    // stdRoot answers the directory the standard library is read from
    fun (str, Err*)() stdRoot = () {
        var (str, bool) env = System::Env("ZAM_STD");
        if(env.1 && env.0 != "") {
            return (FS::ToSlash(env.0), null);
        }
        var (str, Err*) exe = System::Executable();
        if(exe.1 != null) {
            return ("", exe.1);
        }
        var str dir = Paths::Dir(FS::ToSlash(exe.0));
        var Arr[str]* candidates = Arr::[str]New(2U, Paths::Join(dir, "std"), Paths::Join(dir, "../share/zam/std"));
        for(var uint i = 0U; i < candidates.Len(); i++) {
            if(FS::IsDir(candidates.Get(i))) {
                return (candidates.Get(i), null);
            }
        }
        return ("", Errs::NoStd);
    }

    // env answers the variable name, or "" when it is unset
    fun str(str) env = (name) {
        var (str, bool) value = System::Env(name);
        if(!value.1) {
            return "";
        }
        return FS::ToSlash(value.0);
    }

    // home answers the user's home directory
    fun (str, Err*)() home = () {
        var str dir = env("HOME");
        if(System::OS() == "windows") {
            dir = env("USERPROFILE");
        }
        if(dir == "") {
            return ("", Errs::NoHome);
        }
        return (dir, null);
    }

    // packages answers the directory dependencies are kept under
    fun (str, Err*)() packages = () {
        var str zamPath = env("ZAMPATH");
        if(zamPath != "") {
            var (str, Err*) absolute = cli.Paths::Parse(zamPath);
            if(absolute.1 != null) {
                return ("", absolute.1);
            }
            return (Paths::Join(absolute.0, "pkg"), null);
        }
        var (str, Err*) dir = home();
        if(dir.1 != null) {
            return ("", dir.1);
        }
        return (Paths::Join(dir.0, "zam/pkg"), null);
    }

    // cache answers the directory zam caches target packs and runtimes in
    fun (str, Err*)() cache = () {
        var str dir = env("ZAM_CACHE_DIR");
        if(dir != "") {
            return (dir, null);
        }
        var str os = System::OS();
        if(os == "windows") {
            dir = env("LocalAppData");
        } else if(os == "linux") {
            dir = env("XDG_CACHE_HOME");
        }
        if(dir == "") {
            var (str, Err*) user = home();
            if(user.1 != null) {
                return ("", user.1);
            } else if(os == "darwin") {
                dir = Paths::Join(user.0, "Library/Caches");
            } else {
                dir = Paths::Join(user.0, ".cache");
            }
        }
        return (Paths::Join(dir, "zam"), null);
    }

    // trapped writes each of traps, what a function compiled as a trap could not compile
    fun void(ArrList[str]*) trapped = (traps) {
        for(var uint i = 0U; i < traps.Len(); i++) {
            File::StdErr.WriteStr("compiled as a trap: " + traps.Get(i) + "\n");
        }
    }

    // removed removes dir, writing that it has
    fun void(Step, str) removed = (step, dir) {
        onError(step, 1U, PackageArchive::RemoveReadOnly(dir));
        File::StdOut.WriteStr("removed " + Path::Display(dir) + "\n");
    }

    fun void(uint, str...) main = (argC, argV) {
        var Arr[str]* args = asArgs(argC, argV...);

        var (Command*, Err*) r = Command::New(args, LocalFiles::New());
        onError(Step::Command, 1U, r.1);

        if(r.0.verb == Verb::Version) {
            File::StdOut.WriteStr(name + " " + Pack::Version + "\n");
            System::Exit(0);
        }

        if(r.0.verb == Verb::Clean) {
            var (str, Err*) pkg = packages();
            onError(Step::Clean, 1U, pkg.1);
            removed(Step::Clean, pkg.0);
            var (str, Err*) cached = cache();
            onError(Step::Clean, 1U, cached.1);
            removed(Step::Clean, Paths::Join(cached.0, "packs"));
            removed(Step::Clean, Paths::Join(cached.0, "runtime"));
            System::Exit(0);
        }

        if(r.0.verb == Verb::Get || r.0.verb == Verb::Build || r.0.verb == Verb::Run || r.0.verb == Verb::Test) {
            var (str, Err*) root = stdRoot();
            onError(Step::Std, 1U, root.1);
            var (str, Err*) pkg = packages();
            onError(Step::Command, 1U, pkg.1);
            var LocalSources* sources = LocalSources::New(root.0);
            var LocalPackages* fetcher = LocalPackages::New(pkg.0);

            if(r.0.verb == Verb::Get) {
                var (str, Err*) cwd = FS::Cwd();
                onError(Step::Get, 1U, cwd.1);
                var (str, Err*) projectFile = sources.ProjectFile(Paths::Join(FS::ToSlash(cwd.0), "zam.yml"));
                onError(Step::Get, 1U, projectFile.1);
                onError(Step::Get, 1U, ProjectParser::New(sources, fetcher, 1U, false, true).Get(projectFile.0, r.0.refs, r.0.asName));
                System::Exit(0);
            }

            var str entry = r.0.inputPath;
            var Arr[str]* extra = Arr::[str]New(0U);
            if(r.0.verb == Verb::Test) {
                var (ArrList[str]*, Err*) tests = TestFiles::Resolve(r.0.testTargets);
                onError(Step::Test, 1U, tests.1);
                if(tests.0.Len() == 0U) {
                    File::StdOut.WriteStr("no test files\n");
                    System::Exit(0);
                }
                entry = tests.0.RemoveFirst();
                extra = tests.0.Arr();
            }

            var ProjectParser* parser = ProjectParser::New(sources, fetcher, r.0.maxThreads{uint}, r.0.noProject, r.0.writeProject);
            var (ProjectParser.Program*, ArrList[Err*]*) program = parser.Parse(entry, extra);
            onError(Step::Syntax, program.1.Len(), program.1.Arr().Arr()...);
            var (Model*, ArrList[Err*]*) model = Semantic::Validate(program.0);
            onError(Step::Semantic, model.1.Len(), model.1.Arr().Arr()...);
            var str objectPath = env("ZAM_OBJECT");
            if(objectPath != "" || env("ZAM_DUMP") == "image") {
                onError(Step::Codegen, 1U, Codegen::Main(model.0));
            }
            if(objectPath != "") {
                var (str, Err*) cached = cache();
                onError(Step::Codegen, 1U, cached.1);
                var (str, Err*) std = stdRoot();
                onError(Step::Codegen, 1U, std.1);
                var (ArrList[byte]*, ArrList[str]*, Err*) object = Codegen::Object(model.0, r.0, cached.0, Runtime::Dir(std.0));
                onError(Step::Codegen, 1U, object.2);
                trapped(object.1);
                var (File*, Err*) file = File::Create(objectPath);
                onError(Step::Codegen, 1U, file.1);
                var Arr[byte]* bytes = object.0.Arr();
                onError(Step::Codegen, 2U, file.0.Write(bytes.Arr(), bytes.Len()).1, file.0.Close());
                System::Exit(0);
            }
            if(env("ZAM_DUMP") == "image") {
                File::StdOut.WriteStr(Codegen::Hex(Codegen::Image(model.0, r.0)) + "\n");
                System::Exit(0);
            }
            if((r.0.verb == Verb::Build || r.0.verb == Verb::Run) && env("ZAM_DUMP") == "") {
                onError(Step::Codegen, 1U, Codegen::Main(model.0));
                var (str, Err*) cached = cache();
                onError(Step::Codegen, 1U, cached.1);
                var (str, Err*) std = stdRoot();
                onError(Step::Codegen, 1U, std.1);
                var (ArrList[byte]*, ArrList[str]*, Err*) object = Codegen::Object(model.0, r.0, cached.0, Runtime::Dir(std.0));
                onError(Step::Codegen, 1U, object.2);
                trapped(object.1);
                var Project* project = model.0.Source(model.0.Program().main).project;
                if(r.0.verb == Verb::Run) {
                    var (int, Err*) status = Build::Run(object.0, r.0, project, cached.0, Runtime::Dir(std.0));
                    onError(Step::Run, 1U, status.1);
                    System::Exit(status.0);
                }
                onError(Step::Build, 1U, Build::Link(object.0, r.0, r.0.outputPath, project, cached.0, Runtime::Dir(std.0)).1);
                System::Exit(0);
            }
            if(env("ZAM_DUMP") == "semantic") {
                var ArrList[str]* lines = Dump::Lines(model.0);
                for(var uint i = 0U; i < lines.Len(); i++) {
                    File::StdOut.WriteStr(lines.Get(i) + "\n");
                }
                System::Exit(0);
            }
        }
        File::StdOut.WriteStr(r.0.Str() + "\n");
    }
}
