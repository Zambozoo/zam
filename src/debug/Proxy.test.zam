import std("codec/format/JSON.zam");
import std("io/Paths.zam");
import std("io/local/FS.zam");
import std("io/local/Pipe.zam");
import std("io/local/Process.zam");
import std("lang/Arr.zam");
import std("lang/Err.zam");
import std("lang/StrErr.zam");
import std("lang/Strs.zam");
import std("lang/System.zam");
import std("test/Assert.zam");
import "../build/Build.zam";
import "../cli/Target.zam";
import "../codegen/Runtime.zam";
import "../codegen/Zig.zam";
import "../rpc/Messages.zam";
import "../syntax/LocalPackages.zam";
import "../syntax/LocalSources.zam";
import "Proxy.zam";

public namespace ProxyTest {
    // exchange writes message to the proxy and answers what it writes back
    private fun JSON*(Pipe*, Messages.Reader*, str) exchange = (editor, replies, message) {
        Messages::Write(editor.Writer(), message);
        return replies.ReadJSON().0;
    }

    // echo is a program that writes back every byte it reads, as soon as it reads it
    private var str$ echo = "#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#define read _read\n#define write _write\n#else\n#include <unistd.h>\n#endif\n\nint main(void) {\n#ifdef _WIN32\n    _setmode(0, _O_BINARY);\n    _setmode(1, _O_BINARY);\n#endif\n    char buffer[4096];\n    int n;\n    while ((n = read(0, buffer, sizeof buffer)) > 0)\n        write(1, buffer, n);\n    return 0;\n}\n";

    // echoer compiles echo into dir for the host, answering its path
    private fun (str, Err*)(str) echoer = (dir) {
        var (Target, Err*) host = Zig::Host(dir);
        if(host.1 != null) {
            return ("", host.1);
        }
        FS::WriteFile(Paths::Join(dir, "echo.c"), ProxyTest::echo);
        var str binary = Build::Executable(host.0, Paths::Join(dir, "echo"));
        var (Process.Result, Err*) cc = Process::Run(dir, Arr::[str]New(7U, "zig", "cc", "-target", host.0.zig, "echo.c", "-o", FS::FromSlash(binary)), Zig::Env(dir));
        if(cc.1 != null) {
            return ("", cc.1);
        }
        if(cc.0.code != 0) {
            return ("", StrErr::New("zig cc failed on the echo program:\n" + cc.0.output));
        }
        return (binary, null);
    }

    // Serves drives a proxy in front of a program that hands every message back, as an editor would
    public fun void(uint, str...) Serves = (argC, argV) {
        var str dir = FS::ToSlash(FS::MakeTempDir(FS::TempDir(), "proxy-").0);
        defer FS::RemoveAll(dir);
        var (str, Err*) echoer = ProxyTest::echoer(dir);
        if(!Assert::True(echoer.1 == null, echoer.1 == null ? "" : echoer.1.Err())) {
            return;
        }
        FS::WriteFile(Paths::Join(dir, "zam.yml"), "name: debugged\n");
        var str main = Paths::Join(dir, "Main.zam");
        FS::WriteFile(main, "namespace Main {\n    fun void(uint, str...) main = (argC, argV) {\n    }\n}\n");
        var str broken = Paths::Join(dir, "Broken.zam");
        FS::WriteFile(broken, "namespace Broken {\n");
        var str std = System::Env("ZAM_STD").0;
        var str runtime = Runtime::Dir(std);

        var (Proxy*, Err*) p = Proxy::New(LocalSources::New(std), LocalPackages::New(Paths::Join(dir, "pkg")), Paths::Join(dir, "cache"), runtime, FS::FromSlash(echoer.0));
        if(!Assert::True(p.1 == null, p.1 == null ? "" : p.1.Err())) {
            return;
        }
        var Pipe* editor = Pipe::New().0;
        var Pipe* back = Pipe::New().0;
        var thread[Err*] served = async(p.0.Serve(editor.Reader(), back.Writer()));
        var Messages.Reader* replies = Messages.Reader::New(back.Reader());

        var JSON* loaded = ProxyTest::exchange(editor, replies, "{\"seq\":1,\"type\":\"event\",\"event\":\"loadedSource\",\"body\":{\"source\":{\"name\":\"Obj.zam\",\"path\":\"std://lang/Obj.zam\"}}}");
        var JSON* source = loaded.Get("body").0.Get("source").0;
        Assert::[int]Equal(Proxy::ReferenceBase, source.Get("sourceReference").0.AsInt());
        Assert::[str]Equal("deemphasize", source.Get("presentationHint").0.AsStr());

        var JSON* text = ProxyTest::exchange(editor, replies, "{\"seq\":2,\"type\":\"request\",\"command\":\"source\",\"arguments\":{\"source\":{\"sourceReference\":" + Proxy::ReferenceBase{str} + "}}}");
        Assert::True(text.Get("success").0.AsBool(), text.Str());
        Assert::[int]Equal(2, text.Get("request_seq").0.AsInt());
        Assert::[str]Equal(FS::ReadFile(Paths::Join(std, "lang/Obj.zam")).0, text.Get("body").0.Get("content").0.AsStr());

        var JSON* launched = ProxyTest::exchange(editor, replies, "{\"seq\":3,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":" + Strs::Quote(main) + ",\"args\":[\"a\"],\"stopOnEntry\":true,\"cwd\":" + Strs::Quote(dir) + "}}");
        var JSON* launch = launched.Get("arguments").0;
        Assert::True(FS::Exists(launch.Get("program").0.AsStr()), launch.Str());
        Assert::[str]Equal("[\"a\"]", launch.Get("args").0.Str());
        Assert::[str]Equal(dir, launch.Get("cwd").0.AsStr());
        Assert::[str]Equal("breakpoint set --one-shot true --name Main.main", launch.Get("preRunCommands").0.At(0U).AsStr());
        Assert::[str]Equal("command script import " + Strs::Quote(FS::FromSlash(Paths::Join(runtime, "zam_lldb.py"))), launch.Get("initCommands").0.At(0U).AsStr());

        var JSON* failed = ProxyTest::exchange(editor, replies, "{\"seq\":4,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":" + Strs::Quote(broken) + "}}");
        Assert::False(failed.Get("success").0.AsBool(), failed.Str());
        Assert::[int]Equal(4, failed.Get("request_seq").0.AsInt());
        Assert::True(failed.Get("message").0.AsStr() != "", failed.Str());

        var JSON* passed = ProxyTest::exchange(editor, replies, "{\"seq\":5,\"type\":\"request\",\"command\":\"threads\"}");
        Assert::[str]Equal("{\"seq\":5,\"type\":\"request\",\"command\":\"threads\"}", passed.Str());

        editor.Writer().Close();
        var Err* err = wait(served);
        Assert::True(err == null, err == null ? "" : err.Err());
    }
}
