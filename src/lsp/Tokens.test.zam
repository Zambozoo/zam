import std("test/Assert.zam");
import "Tokens.zam";

public namespace TokensTest {
    public fun void(uint, str...) Semantic = (argC, argV) {
        Assert::[str]Equal("[0,0,5,6,0,1,0,9,0,0,0,10,4,2,0,1,4,3,0,0,0,4,3,1,0,0,6,1,2,0,0,2,1,5,0,0,7,6,0,0,0,7,1,4,0,0,2,1,5,0,0,2,1,4,0,0,5,6,6,0,1,4,3,0,0,0,4,3,1,0,0,4,1,2,0,0,2,1,5,0,0,2,3,3,0,1,4,4,6,0,1,7,4,6,0,0,5,3,0,0,0,4,4,1,0,0,5,1,2,0,0,2,1,5,0,0,2,1,5,0,0,1,4,0,0]",
            Tokens::Semantic("// hi\nnamespace Main {\n    fun int() f = () { return 1 + 2; } // é😀\n    var str s = \"é\";\n    /* a\n       b */ var bool _ = !true;\n}\n").Str());
        Assert::[str]Equal("[0,0,9,0,0,0,10,4,2,0,0,7,3,0,0,0,4,3,1,0,0,4,1,2,0,0,2,1,5,0]",
            Tokens::Semantic("namespace Main { var str s = \"open").Str());
    }
}
