import io = std("io/Paths.zam");
import std("io/local/FS.zam");
import std("lang/Err.zam");
import std("lang/Strs.zam");

// Paths reads the paths a command line is written with
public namespace Paths {
    public static var str$ standardPrefix = "std://";

    // Parse answers the absolute slash path p names, written in the system's form
    public fun (str, Err*)(str) Parse = (p) {
        if(Strs::HasPrefix(p, standardPrefix)) {
            return (p, null);
        }
        var str slashed = FS::ToSlash(p);
        var bool windows = FS::Separator == "\\";
        if(io.Paths::IsAbs(slashed) && (!windows || io.Paths::Volume(slashed) != "")) {
            return (io.Paths::Clean(slashed), null);
        }
        var (str, Err*) cwd = FS::Cwd();
        if(cwd.1 != null) {
            return (null, cwd.1);
        } else if(io.Paths::IsAbs(slashed)) {
            return (io.Paths::Clean(io.Paths::Volume(FS::ToSlash(cwd.0)) + slashed), null);
        }
        return (io.Paths::Join(FS::ToSlash(cwd.0), slashed), null);
    }
}
