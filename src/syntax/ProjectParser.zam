import std("data/list/ArrList.zam");
import std("data/list/LinkList.zam");
import std("data/map/TreeMap.zam");
import std("data/set/HashSet.zam");
import std("io/Paths.zam");
import std("lang/Arr.zam");
import std("lang/Err.zam");
import std("lang/StrErr.zam");
import std("lang/Strs.zam");
import std("sync/Cond.zam");
import std("sync/Mutex.zam");
import std("sync/WaitGroup.zam");
import "FileParser.zam";
import "PackageProvider.zam";
import "Parser.zam";
import "Path.zam";
import "Project.zam";
import "Resolver.zam";
import "Source.zam";
import "SourceErr.zam";
import "SourceProvider.zam";
import "ast/Decl.zam";
import "ast/File.zam";

// ProjectParser parses every file a program is made of on several threads
public class ProjectParser {
    namespace Errs {
        public var Err*$ ReservedPackage = StrErr::New("\"std\" is a reserved package name");

        public fun Err*(str) NoProjectFile = (path) {
            return StrErr::New("project file missing for " + Path::Display(path));
        }

        public fun Err*(str) NoRepo = (pkg) {
            return StrErr::New("dependency " + Strs::Quote(pkg) + " has no repo");
        }

        public fun Err*(str, Err*) Unfetched = (pkg, err) {
            return StrErr::New("failed to fetch dependency " + Strs::Quote(pkg) + ": " + err.Err());
        }

        public fun Err*(str, str, str, str) Mismatch = (pkg, want, repo, got) {
            return StrErr::New("dependency " + Strs::Quote(pkg) + " does not match its hash: the project file has " + want + ", " + repo + " has " + got);
        }
    }

    // Program is every file parsed and every project they are in
    public class Program {
        public var TreeMap[str, Source*]* sources;
        public var TreeMap[str, Project*]* projects;
        public var Decl* main;
    }

    var SourceProvider* provider;
    var PackageProvider* packages;
    var uint threads;
    // noProject says local files are compiled as the entry's implicit project
    var bool noProject;
    var str entry;

    // projectLock is held while a project is found or read
    var Mutex* projectLock;
    // projects is every project read, by the path of its project file
    var TreeMap[str, Project*]* projects;
    // unreadable is the project files that could not be read, already reported
    var HashSet[str]* unreadable;
    // fetched maps the directory each dependency was extracted to onto its repo@version
    var TreeMap[str, str]* fetched;

    var Mutex* lock;
    var Cond* changed;
    // queue is the paths found and not yet taken by a thread
    var LinkList[str]* queue;
    var HashSet[str]* seen;
    // pending counts the paths found and not yet parsed
    var uint pending;
    var TreeMap[str, Source*]* sources;
    var ArrList[Err*]* errs;
    // incomplete says a file could not be parsed at all
    var bool incomplete;

    public static fun ProjectParser*(SourceProvider*, PackageProvider*, uint, bool) New = (provider, packages, threads, noProject) {
        var ProjectParser* p = new(ProjectParser);
        p.provider = provider;
        p.packages = packages;
        p.noProject = noProject;
        p.projectLock = Mutex::New();
        p.projects = TreeMap::[str, Project*]New(0U);
        p.unreadable = HashSet::[str]New(0U);
        p.fetched = TreeMap::[str, str]New(0U);
        p.threads = threads;
        if(p.threads == 0U) {
            p.threads = 1U;
        }
        p.lock = Mutex::New();
        p.changed = Cond::New(p.lock);
        p.queue = LinkList::[str]New(0U);
        p.seen = HashSet::[str]New(0U);
        p.sources = TreeMap::[str, Source*]New(0U);
        p.errs = ArrList::[Err*]New(0U);
        return p;
    }

    // Parse parses entry, the paths in extra, and every file they import
    public fun (Program*, ArrList[Err*]*)(str, Arr[str]*) Parse = (entry, extra) {
        this.entry = entry;
        this.lock.Lock();
        this.add(entry);
        for(var uint i = 0U; i < extra.Len(); i++) {
            this.add(extra.Get(i));
        }
        this.lock.Unlock();

        var WaitGroup* wg = WaitGroup::New();
        wg.Add(this.threads{int});
        for(var uint i = 0U; i < this.threads; i++) {
            async(this.work(wg));
        }
        wg.Wait();

        if(this.incomplete) {
            return (null, this.errs);
        }
        var Program* program = new(Program);
        program.sources = this.sources;
        program.projects = this.projects;
        program.main = this.sources.Get(entry).0.file.decl;
        return (program, this.errs);
    }

    // add queues path to be parsed unless it has been already, with the lock held
    fun void(str) add = (path) {
        if(this.seen.Add(path)) {
            this.queue.AddLast(path);
            this.pending++;
            this.changed.Broadcast();
        }
    }

    // work parses the paths queued until none is left to be found
    fun void(WaitGroup*) work = (wg) {
        defer wg.Done();
        for {
            this.lock.Lock();
            for(; this.queue.Len() == 0U && this.pending > 0U;) {
                this.changed.Wait();
            }
            if(this.queue.Len() == 0U) {
                this.lock.Unlock();
                return;
            }
            var str path = this.queue.RemoveFirst();
            this.lock.Unlock();

            var (Source*, ArrList[Err*]*, bool) parsed = this.parse(path);

            this.lock.Lock();
            for(var uint i = 0U; i < parsed.1.Len(); i++) {
                this.errs.AddLast(parsed.1.Get(i));
            }
            if(!parsed.2) {
                this.incomplete = true;
            }
            if(parsed.0 != null) {
                this.sources.Put(path, parsed.0);
                for(var uint i = 0U; i < parsed.0.imports.Len(); i++) {
                    var ArrList[str]* paths = parsed.0.imports.Get(i).paths;
                    for(var uint j = 0U; j < paths.Len(); j++) {
                        this.add(paths.Get(j));
                    }
                }
            }
            this.pending--;
            this.changed.Broadcast();
            this.lock.Unlock();
        }
    }

    // parse reads, parses and resolves the file at path
    fun (Source*, ArrList[Err*]*, bool)(str) parse = (path) {
        var ArrList[Err*]* errs = ArrList::[Err*]New(0U);
        var (Project*, Err*) project = this.projectOf(path);
        if(project.0 == null) {
            if(project.1 != null) {
                errs.AddLast(project.1);
            }
            return (null, errs, false);
        }
        var (str, Err*) text = this.provider.Read(path);
        if(text.1 != null) {
            errs.AddLast(SourceErr::In(text.1, path));
            return (null, errs, false);
        }

        var Parser* p = Parser::New(text.0);
        var (File*, Err*) file = FileParser::Parse(p);
        for(var uint i = 0U; i < p.diagnostics.Len(); i++) {
            var Parser.Diagnostic* d = p.diagnostics.Get(i);
            errs.AddLast(SourceErr::At(d.err, path, p.LineStarts(), d.token));
        }
        if(file.1 != null && file.1 != Parser.Errs::Recorded) {
            errs.AddLast(SourceErr::At(file.1, path, p.LineStarts(), p.Peek().0));
        }
        if(file.0 == null) {
            return (null, errs, false);
        }

        var Source* s = new(Source);
        s.path = path;
        s.project = project.0;
        s.file = file.0;
        s.lineStarts = p.LineStarts();
        var (ArrList[Source.Resolved*]*, ArrList[Parser.Diagnostic*]*) resolved = Resolver::Resolve(this.provider, project.0, path, file.0, p.importBlocks);
        s.imports = resolved.0;
        if(resolved.1.Len() > 0U) {
            file.0.brokenImports = true;
        }
        for(var uint i = 0U; i < resolved.1.Len(); i++) {
            var Parser.Diagnostic* d = resolved.1.Get(i);
            errs.AddLast(SourceErr::At(d.err, path, s.lineStarts, d.token));
        }
        return (s, errs, file.1 == null);
    }

    // projectOf answers the project the file at path is in
    fun (Project*, Err*)(str) projectOf = (path) {
        this.projectLock.Lock();
        defer this.projectLock.Unlock();
        var (str, str, bool) at = this.fetchedRoot(path);
        var str file = "";
        var bool implicit = this.noProject && !Path::IsStd(path) && !at.2;
        if(implicit) {
            file = Project::Implicit(this.entry).path;
        } else {
            var (str, Err*) found = this.provider.ProjectFile(path);
            if(found.1 != null) {
                return (null, SourceErr::In(found.1, path));
            } else if(at.2 && !Paths::Contains(at.1, found.0)) {
                return (null, SourceErr::In(Errs::NoProjectFile(path), path));
            }
            file = found.0;
        }

        var (Project*, bool) known = this.projects.Get(file);
        if(known.1) {
            return (known.0, null);
        } else if(this.unreadable.Contains(file)) {
            return (null, null);
        } else if(implicit) {
            var Project* p = Project::Implicit(this.entry);
            this.projects.Put(file, p);
            return (p, null);
        }
        var (Project*, Err*) read = this.read(file);
        if(read.1 != null) {
            this.unreadable.Add(file);
            return (null, SourceErr::In(read.1, file));
        }
        this.projects.Put(file, read.0);
        return (read.0, null);
    }

    // read reads the project file at path and fetches the dependencies it declares
    fun (Project*, Err*)(str) read = (path) {
        var (str, Err*) text = this.provider.Read(path);
        if(text.1 != null) {
            return (null, text.1);
        }
        var (Project*, Err*) parsed = Project::Parse(path, text.0);
        if(parsed.1 != null) {
            return (null, parsed.1);
        }
        var Project* p = parsed.0;
        for(var uint i = 0U; i < p.declared.Len(); i++) {
            if(p.declared.Get(i).pkg == "std") {
                return (null, Errs::ReservedPackage);
            }
        }

        var (str, str, bool) at = this.fetchedRoot(path);
        p.archive = at.0;
        p.root = at.1;
        for(var uint i = 0U; i < p.declared.Len(); i++) {
            var Project.Dependency* d = p.declared.Get(i);
            if(d.repo == "") {
                return (null, Errs::NoRepo(d.pkg));
            }
            var (str, str, Err*) fetched = this.packages.Fetch(d.repo);
            if(fetched.2 != null) {
                return (null, Errs::Unfetched(d.pkg, fetched.2));
            }
            this.fetched.Put(fetched.0, d.repo);
            if(d.hash != "" && d.hash != fetched.1) {
                return (null, Errs::Mismatch(d.pkg, d.hash, d.repo, fetched.1));
            }
            p.dependencies.Put(d.pkg, fetched.0);
        }
        if(!Path::IsStd(path)) {
            p.dependencies.Put("std", Path::Std);
        }
        return (p, null);
    }

    // fetchedRoot answers the repo@version and directory of the fetched dependency path lies in
    fun (str, str, bool)(str) fetchedRoot = (path) {
        var Arr[(str, str)]* all = this.fetched.Arr();
        for(var uint i = 0U; i < all.Len(); i++) {
            if(Paths::Contains(all.Get(i).0, path)) {
                return (all.Get(i).1, all.Get(i).0, true);
            }
        }
        return ("", "", false);
    }
}
