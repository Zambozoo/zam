import std("data/list/ArrList.zam");
import std("data/map/TreeMap.zam");
import std("io/Paths.zam");
import std("lang/Arr.zam");
import std("lang/Err.zam");
import std("lang/StrErr.zam");
import std("lang/Strs.zam");
import std("test/Assert.zam");
import "Path.zam";
import "ProjectParser.zam";
import "Source.zam";

public namespace ProjectParserTest {
    // MapSources serves sources from a map of paths to their text
    class MapSources {
        var TreeMap[str, str]* files;

        fun (str, Err*)(str) Read = (path) {
            var (str, bool) text = this.files.Get(path);
            if(!text.1) {
                return ("", StrErr::New("no file " + path));
            }
            return (text.0, null);
        }

        fun (Arr[str]*, Err*)(str) ListCodeFiles = (dir) {
            var ArrList[str]* children = ArrList::[str]New(0U);
            var Arr[(str, str)]* all = this.files.Arr();
            for(var uint i = 0U; i < all.Len(); i++) {
                var str path = all.Get(i).0;
                if(Paths::Dir(path) == Paths::Clean(dir) && Strs::HasSuffix(path, Path::Extension)) {
                    children.AddLast(path);
                }
            }
            return (children.Arr(), null);
        }
    }

    // at answers where an error at pos in the file at path is said to be
    private fun str(str, str) at = (path, pos) {
        return " (" + Path::Display(path) + pos + ")";
    }

    // quoted answers path as an error quotes it
    private fun str(str) quoted = (path) {
        return Strs::Quote(Path::Display(path));
    }

    // files answers the files of the given paths and texts, alternating
    private fun TreeMap[str, str]*(uint, str...) files = (n, pairs) {
        var TreeMap[str, str]* files = TreeMap::[str, str]New(0U);
        for(var uint i = 0U; i + 1U < n; i = i + 2U) {
            files.Put(pairs[i], pairs[i + 1U]);
        }
        return files;
    }

    // parse parses the program entered at /p/Main.zam on threads threads
    private fun (ProjectParser.Program*, ArrList[Err*]*)(TreeMap[str, str]*, uint) parse = (files, threads) {
        var MapSources* sources = new(MapSources);
        sources.files = files;
        return ProjectParser::New(sources, threads).Parse("/p/Main.zam", Arr::[str]New(0U));
    }

    // parses checks that files parse on 1 and 4 threads into sources at the
    // paths want, joined by spaces, with no error
    private fun void(TreeMap[str, str]*, str) parses = (files, want) {
        for(var uint threads = 1U; threads <= 4U; threads = threads + 3U) {
            var (ProjectParser.Program*, ArrList[Err*]*) out = ProjectParserTest::parse(files, threads);
            for(var uint i = 0U; i < out.1.Len(); i++) {
                Assert::True(false, out.1.Get(i).Err());
            }
            if(!Assert::True(out.0 != null, "no program")) {
                return;
            }
            var str got = "";
            var Arr[(str, Source*)]* sources = out.0.sources.Arr();
            for(var uint i = 0U; i < sources.Len(); i++) {
                if(i > 0U) {
                    got = got + " ";
                }
                got = got + sources.Get(i).0;
            }
            Assert::[str]Equal(want, got);
        }
    }

    // reports checks that files parse on 1 and 4 threads with the one error
    // containing want, and a program only if whole
    private fun void(TreeMap[str, str]*, bool, str) reports = (files, whole, want) {
        for(var uint threads = 1U; threads <= 4U; threads = threads + 3U) {
            var (ProjectParser.Program*, ArrList[Err*]*) out = ProjectParserTest::parse(files, threads);
            Assert::True((out.0 != null) == whole, "the program is not as whole as wanted");
            if(Assert::[uint]Equal(1U, out.1.Len())) {
                var str got = out.1.Get(0U).Err();
                Assert::True(Strs::Contains(got, want), got + " does not contain " + want);
            }
        }
    }

    public fun void(uint, str...) Imports = (argC, argV) {
        ProjectParserTest::parses(ProjectParserTest::files(8U,
            "/p/Main.zam", "import \"A.zam\";\nimport \"B.zam\";\npublic namespace Main {}",
            "/p/A.zam", "import \"lib/C.zam\";\nclass A {}",
            "/p/B.zam", "import \"lib/C.zam\";\nclass B {}",
            "/p/lib/C.zam", "class C {}"),
            "/p/A.zam /p/B.zam /p/Main.zam /p/lib/C.zam");
    }

    public fun void(uint, str...) Std = (argC, argV) {
        ProjectParserTest::parses(ProjectParserTest::files(6U,
            "/p/Main.zam", "import std(\"lang/X.zam\");\npublic namespace Main {}",
            "std://lang/X.zam", "import \"Y.zam\";\nclass X {}",
            "std://lang/Y.zam", "class Y {}"),
            "/p/Main.zam std://lang/X.zam std://lang/Y.zam");
    }

    public fun void(uint, str...) Globs = (argC, argV) {
        ProjectParserTest::parses(ProjectParserTest::files(8U,
            "/p/Main.zam", "import lib = \"lib/*\";\npublic namespace Main {}",
            "/p/lib/A.zam", "class A {}",
            "/p/lib/B.zam", "class B {}",
            "/p/lib/T.test.zam", "class T {}"),
            "/p/Main.zam /p/lib/A.zam /p/lib/B.zam");
        ProjectParserTest::reports(ProjectParserTest::files(2U,
            "/p/Main.zam", "import \"empty/*\";\npublic namespace Main {}"),
            true, "import \"empty/*\" matched no .zam files" + ProjectParserTest::at("/p/Main.zam", "[1:1]"));
    }

    public fun void(uint, str...) Blocks = (argC, argV) {
        ProjectParserTest::parses(ProjectParserTest::files(4U,
            "/p/Main.zam", "public namespace Main {\n    fun void() f = () {\n        import \"Inner.zam\";\n    }\n}",
            "/p/Inner.zam", "class Inner {}"),
            "/p/Inner.zam /p/Main.zam");
        ProjectParserTest::reports(ProjectParserTest::files(6U,
            "/p/Main.zam", "public namespace Main {\n    fun void() f = () {\n        import \"a/Twin.zam\";\n        import \"b/Twin.zam\";\n    }\n}",
            "/p/a/Twin.zam", "class Twin {}",
            "/p/b/Twin.zam", "class Twin {}"),
            true, "duplicate import \"Twin\": " + ProjectParserTest::quoted("/p/b/Twin.zam") + " collides with " + ProjectParserTest::quoted("/p/a/Twin.zam") + ProjectParserTest::at("/p/Main.zam", "[4:9]"));
    }

    public fun void(uint, str...) Errors = (argC, argV) {
        ProjectParserTest::reports(ProjectParserTest::files(4U,
            "/p/Main.zam", "import \"A.zam\";\nimport \"A.zam\";\npublic namespace Main {}",
            "/p/A.zam", "class A {}"),
            true, "duplicate import \"A\" of " + ProjectParserTest::quoted("/p/A.zam") + ProjectParserTest::at("/p/Main.zam", "[2:1]"));
        ProjectParserTest::reports(ProjectParserTest::files(2U,
            "/p/Main.zam", "import pkg(\"x.zam\");\npublic namespace Main {}"),
            true, "no dependency \"pkg\" declared by project \"Main\"" + ProjectParserTest::at("/p/Main.zam", "[1:1]"));
        ProjectParserTest::reports(ProjectParserTest::files(4U,
            "/p/Main.zam", "import \"T.test.zam\";\npublic namespace Main {}",
            "/p/T.test.zam", "class T {}"),
            true, "test file " + Path::Display("/p/T.test.zam") + " can only be imported by a test file" + ProjectParserTest::at("/p/Main.zam", "[1:1]"));
        ProjectParserTest::reports(ProjectParserTest::files(2U,
            "/p/Main.zam", "public namespace Main { var int x = ; }"),
            true, ProjectParserTest::at("/p/Main.zam", "[1:37]"));
    }

    public fun void(uint, str...) Incomplete = (argC, argV) {
        ProjectParserTest::reports(ProjectParserTest::files(2U,
            "/p/Main.zam", "import \"Missing.zam\";\npublic namespace Main {}"),
            false, "no file /p/Missing.zam" + ProjectParserTest::at("/p/Missing.zam", ""));
        ProjectParserTest::reports(ProjectParserTest::files(4U,
            "/p/Main.zam", "import \"B.zam\";\npublic namespace Main {}",
            "/p/B.zam", "class {}"),
            false, "unexpected token: \"{\", expected \"IDENTIFIER\"" + ProjectParserTest::at("/p/B.zam", "[1:7]"));

        var (ProjectParser.Program*, ArrList[Err*]*) out = ProjectParserTest::parse(ProjectParserTest::files(2U,
            "/p/Main.zam", "import pkg(\"x.zam\");\nclass {}"), 1U);
        Assert::True(out.0 == null, "a program of a file not read whole");
        if(Assert::[uint]Equal(2U, out.1.Len())) {
            Assert::[str]Equal("unexpected token: \"{\", expected \"IDENTIFIER\"" + ProjectParserTest::at("/p/Main.zam", "[2:7]"), out.1.Get(0U).Err());
            Assert::[str]Equal("no dependency \"pkg\" declared by project \"Main\"" + ProjectParserTest::at("/p/Main.zam", "[1:1]"), out.1.Get(1U).Err());
        }
    }
}
