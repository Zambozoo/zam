import std("data/list/ArrList.zam");
import std("data/set/TreeSet.zam");
import std("lang/Err.zam");
import std("lang/StrErr.zam");
import "Parser.zam";
import "StmtParser.zam";
import "Token.zam";
import "TokenKind.zam";
import "TypeParser.zam";
import "ast/Expr.zam";
import "ast/Stmt.zam";
import "ast/Type.zam";

// ExprParser reads expressions
public namespace ExprParser {
    namespace Errs {
        public var Err*$ AsyncNotCall = StrErr::New("async expression must be a call expression");
        public var Err*$ LambdaNotFunction = StrErr::New("lambda type must be a function type");

        public fun Err*(uint, uint) LambdaArity = (expected, got) {
            return StrErr::New("lambda parameter length mismatch, expected " + expected{str} + ", got " + got{str});
        }
    }

    var ArrList[TreeSet[TokenKind]*]* precedenceLevels;
    var TreeSet[TokenKind]* prefixKindsSet;
    var TreeSet[TokenKind]* postfixKindsSet;
    var TreeSet[TokenKind]* primaryKindsSet;
    var TreeSet[TokenKind]* fieldNamesSet;
    var TreeSet[TokenKind]* argumentEndsSet;
    var TreeSet[TokenKind]* typeArgumentEndsSet;
    var TreeSet[TokenKind]* parameterNamesSet;

    // Parse reads an expression, a comma joining assignments into a tuple
    public fun (Expr*, Err*)(Parser*) Parse = (p) {
        var (Expr*, Err*) first = ExprParser::ParseAssign(p);
        if(first.1 != null) {
            return first;
        }
        var ArrList[Expr*]* elements = null;
        for {
            var (Token*, Err*) comma = p.Match(TokenKind::Comma);
            if(comma.1 != null) {
                return (null, comma.1);
            } else if(comma.0 == null) {
                break;
            }
            if(elements == null) {
                elements = ArrList::[Expr*]New(0U);
                elements.AddLast(first.0);
            }
            var (Expr*, Err*) next = ExprParser::ParseAssign(p);
            if(next.1 != null) {
                return next;
            }
            elements.AddLast(next.0);
        }
        if(elements == null) {
            return first;
        }
        return (Expr.Tuple::New(elements), null);
    }

    // ParseAssign reads an expression short of a tuple
    public fun (Expr*, Err*)(Parser*) ParseAssign = (p) {
        var (Expr*, Err*) left = ExprParser::ternary(p);
        if(left.1 != null) {
            return left;
        }
        var (Token*, Err*) equal = p.Match(TokenKind::Equal);
        if(equal.1 != null) {
            return (null, equal.1);
        } else if(equal.0 == null) {
            return left;
        }
        var (Expr*, Err*) right = ExprParser::ternary(p);
        if(right.1 != null) {
            return right;
        }
        var ArrList[Expr*]* operands = ArrList::[Expr*]New(0U);
        operands.AddLast(left.0);
        operands.AddLast(right.0);
        return (Expr.NAry::New(TokenKind::Equal, operands), null);
    }

    // ternary reads a ternary operation
    fun (Expr*, Err*)(Parser*) ternary = (p) {
        var uint loosest = ExprParser::precedence().Len() - 1U;
        var (Expr*, Err*) condition = ExprParser::nary(p, loosest);
        if(condition.1 != null) {
            return condition;
        }
        var (Token*, Err*) question = p.Match(TokenKind::Question);
        if(question.1 != null) {
            return (null, question.1);
        } else if(question.0 == null) {
            return condition;
        }
        var (Expr*, Err*) then = ExprParser::nary(p, loosest);
        if(then.1 != null) {
            return then;
        }
        var (Token*, Err*) colon = p.Consume(TokenKind::Colon);
        if(colon.1 != null) {
            return (null, colon.1);
        }
        var (Expr*, Err*) otherwise = ExprParser::nary(p, loosest);
        if(otherwise.1 != null) {
            return otherwise;
        }
        return (Expr.Ternary::New(condition.0, then.0, otherwise.0), null);
    }

    // nary reads the operators of level and those tighter
    fun (Expr*, Err*)(Parser*, uint) nary = (p, level) {
        var (Expr*, Err*) first;
        if(level == 0U) {
            first = ExprParser::prefix(p);
        } else {
            first = ExprParser::nary(p, level - 1U);
        }
        if(first.1 != null) {
            return first;
        }
        var TreeSet[TokenKind]* operators = ExprParser::precedence().Get(level);
        var Expr* e = first.0;
        for {
            var (Token*, Err*) operator = p.MatchAny(operators);
            if(operator.1 != null) {
                return (null, operator.1);
            } else if(operator.0 == null) {
                return (e, null);
            }
            var (Expr*, Err*) operand;
            if(level == 0U) {
                operand = ExprParser::prefix(p);
            } else {
                operand = ExprParser::nary(p, level - 1U);
            }
            if(operand.1 != null) {
                return operand;
            }

            var Expr.NAry* run = e{Expr.NAry*};
            if(run != null && run.operator == operator.0.kind && run != first.0) {
                run.operands.AddLast(operand.0);
            } else {
                var ArrList[Expr*]* operands = ArrList::[Expr*]New(0U);
                operands.AddLast(e);
                operands.AddLast(operand.0);
                e = Expr.NAry::New(operator.0.kind, operands);
            }
        }
        return (e, null);
    }

    // prefix reads the operators written before an operand
    fun (Expr*, Err*)(Parser*) prefix = (p) {
        var (Token*, Err*) operator = p.MatchAny(ExprParser::prefixKinds());
        if(operator.1 != null) {
            return (null, operator.1);
        } else if(operator.0 == null) {
            return ExprParser::postfix(p);
        }
        if(operator.0.kind == TokenKind::At) {
            var (Token*, Err*) brace = p.Match(TokenKind::LeftBrace);
            if(brace.1 != null) {
                return (null, brace.1);
            } else if(brace.0 != null) {
                var (Type*, Err*) t = TypeParser::Parse(p);
                if(t.1 != null) {
                    return (null, t.1);
                }
                var (Token*, Err*) end = p.Consume(TokenKind::RightBrace);
                if(end.1 != null) {
                    return (null, end.1);
                }
                return (Expr.TypeValue::New(operator.0, t.0), null);
            }
        }
        var (Expr*, Err*) operand = ExprParser::prefix(p);
        if(operand.1 != null || operator.0.kind == TokenKind::Plus) {
            return operand;
        }
        return (Expr.Unary::New(operator.0, operator.0.kind, operand.0, false), null);
    }

    // postfix reads a primary and what is written after it
    fun (Expr*, Err*)(Parser*) postfix = (p) {
        var (Expr*, Err*) primary = ExprParser::primary(p);
        if(primary.1 != null || primary.0.kind == Expr.Kind::TypeValue) {
            return primary;
        }
        var Expr* e = primary.0;
        for {
            var (Token*, Err*) tok = p.MatchAny(ExprParser::postfixKinds());
            if(tok.1 != null) {
                return (null, tok.1);
            } else if(tok.0 == null) {
                return (e, null);
            }
            var TokenKind kind = tok.0.kind;
            if(kind == TokenKind::PlusPlus || kind == TokenKind::MinusMinus) {
                e = Expr.Unary::New(e.start, kind, e, true);
            } else if(kind == TokenKind::Period) {
                var (Token*, Err*) name = p.ConsumeAny(ExprParser::fieldNames());
                if(name.1 != null) {
                    return (null, name.1);
                }
                e = Expr.Field::New(e, name.0);
            } else if(kind == TokenKind::LeftBracket) {
                var (Expr*, Err*) index = ExprParser::ParseAssign(p);
                if(index.1 != null) {
                    return index;
                }
                var (Token*, Err*) end = p.Consume(TokenKind::RightBracket);
                if(end.1 != null) {
                    return (null, end.1);
                }
                e = Expr.Index::New(e, index.0);
            } else if(kind == TokenKind::LeftParen) {
                var (Expr*, Err*) call = ExprParser::call(p, e);
                if(call.1 != null) {
                    return call;
                }
                e = call.0;
            } else {
                var (Type*, Err*) t = TypeParser::Parse(p);
                if(t.1 != null) {
                    return (null, t.1);
                }
                var (Token*, Err*) end = p.Consume(TokenKind::RightBrace);
                if(end.1 != null) {
                    return (null, end.1);
                }
                e = Expr.Cast::New(e, t.0);
            }
        }
        return (e, null);
    }

    // primary reads a primary expression
    fun (Expr*, Err*)(Parser*) primary = (p) {
        var (Token*, Err*) start = p.ConsumeAny(ExprParser::primaryKinds());
        if(start.1 != null) {
            return (null, start.1);
        }
        var Token* tok = start.0;
        var TokenKind kind = tok.kind;
        if(kind == TokenKind::Identifier) {
            return ExprParser::identifier(p, tok);
        } else if(kind == TokenKind::Native) {
            return ExprParser::nativeCall(p, tok);
        } else if(kind == TokenKind::New) {
            return ExprParser::allocation(p, tok);
        } else if(kind == TokenKind::Lambda) {
            return ExprParser::lambdaValue(p, tok);
        } else if(kind == TokenKind::Type) {
            var Err* err = p.Consume(TokenKind::LeftParen).1;
            if(err != null) {
                return (null, err);
            }
            var (Type*, Err*) t = TypeParser::Parse(p);
            if(t.1 != null) {
                return (null, t.1);
            }
            err = p.Consume(TokenKind::RightParen).1;
            if(err != null) {
                return (null, err);
            }
            return (Expr.TypeValue::New(tok, t.0), null);
        } else if(kind == TokenKind::Async || kind == TokenKind::Wait || kind == TokenKind::LeftParen) {
            if(kind != TokenKind::LeftParen) {
                var Err* err = p.Consume(TokenKind::LeftParen).1;
                if(err != null) {
                    return (null, err);
                }
            }
            var (Expr*, Err*) inner = ExprParser::Parse(p);
            if(inner.1 != null) {
                return inner;
            } else if(kind == TokenKind::Async && inner.0.kind != Expr.Kind::Call) {
                return (null, Errs::AsyncNotCall);
            }
            var Err* err = p.Consume(TokenKind::RightParen).1;
            if(err != null) {
                return (null, err);
            } else if(kind == TokenKind::Async) {
                return (Expr.Async::New(tok, inner.0), null);
            } else if(kind == TokenKind::Wait) {
                return (Expr.Wait::New(tok, inner.0), null);
            }
            return inner;
        }
        return (Expr.Symbol::New(tok), null);
    }

    // identifier reads what a name begins
    fun (Expr*, Err*)(Parser*, Token*) identifier = (p, start) {
        var ArrList[Token*]* ids = ArrList::[Token*]New(0U);
        ids.AddLast(start);
        for {
            var (Token*, Err*) period = p.Match(TokenKind::Period);
            if(period.1 != null) {
                return (null, period.1);
            } else if(period.0 == null) {
                break;
            }
            var (Token*, Err*) index = p.Match(TokenKind::IntLiteral);
            if(index.1 != null) {
                return (null, index.1);
            } else if(index.0 != null) {
                return (Expr.Field::New(ExprParser::name(ids), index.0), null);
            }
            var (Token*, Err*) id = p.Consume(TokenKind::Identifier);
            if(id.1 != null) {
                return (null, id.1);
            }
            ids.AddLast(id.0);
        }

        var (Token*, Err*) colons = p.Match(TokenKind::ColonColon);
        if(colons.1 != null) {
            return (null, colons.1);
        } else if(colons.0 == null) {
            return (ExprParser::name(ids), null);
        }
        var ArrList[Type*]* arguments = null;
        var (Token*, Err*) bracket = p.Match(TokenKind::LeftBracket);
        if(bracket.1 != null) {
            return (null, bracket.1);
        } else if(bracket.0 != null) {
            arguments = ArrList::[Type*]New(0U);
            for {
                var (Type*, Err*) argument = TypeParser::Parse(p);
                if(argument.1 != null) {
                    return (null, argument.1);
                }
                arguments.AddLast(argument.0);
                var (Token*, Err*) end = p.ConsumeAny(ExprParser::typeArgumentEnds());
                if(end.1 != null) {
                    return (null, end.1);
                } else if(end.0.kind == TokenKind::RightBracket) {
                    break;
                }
            }
        }
        var (Token*, Err*) field = p.Consume(TokenKind::Identifier);
        if(field.1 != null) {
            return (null, field.1);
        }
        return (Expr.Static::New(Type.Reference::New(ids), arguments, field.0), null);
    }

    // name answers a symbol for one id, and a path for more
    fun Expr*(ArrList[Token*]*) name = (ids) {
        if(ids.Len() == 1U) {
            return Expr.Symbol::New(ids.Get(0U));
        }
        return Expr.Path::New(ids);
    }

    // call reads the arguments callee is called with
    fun (Expr*, Err*)(Parser*, Expr*) call = (p, callee) {
        var ArrList[Expr*]* arguments = ArrList::[Expr*]New(0U);
        var (Token*, Err*) empty = p.Match(TokenKind::RightParen);
        if(empty.1 != null) {
            return (null, empty.1);
        } else if(empty.0 != null) {
            return (Expr.Call::New(callee, arguments), null);
        }
        for {
            var (Expr*, Err*) argument = ExprParser::ParseAssign(p);
            if(argument.1 != null) {
                return argument;
            }
            var (Token*, Err*) spread = p.Match(TokenKind::PeriodPeriodPeriod);
            if(spread.1 != null) {
                return (null, spread.1);
            } else if(spread.0 != null) {
                arguments.AddLast(Expr.Spread::New(spread.0, argument.0));
            } else {
                arguments.AddLast(argument.0);
            }
            var (Token*, Err*) end = p.ConsumeAny(ExprParser::argumentEnds());
            if(end.1 != null) {
                return (null, end.1);
            } else if(end.0.kind == TokenKind::RightParen) {
                break;
            }
        }
        return (Expr.Call::New(callee, arguments), null);
    }

    // nativeCall reads the (ID) of a native
    fun (Expr*, Err*)(Parser*, Token*) nativeCall = (p, start) {
        var Err* err = p.Consume(TokenKind::LeftParen).1;
        if(err != null) {
            return (null, err);
        }
        var (Token*, Err*) id = p.Consume(TokenKind::Identifier);
        if(id.1 != null) {
            return (null, id.1);
        }
        err = p.Consume(TokenKind::RightParen).1;
        if(err != null) {
            return (null, err);
        }
        return (Expr.Native::New(start, id.0), null);
    }

    // allocation reads the (T, count, tail) of a new
    fun (Expr*, Err*)(Parser*, Token*) allocation = (p, start) {
        var Err* err = p.Consume(TokenKind::LeftParen).1;
        if(err != null) {
            return (null, err);
        }
        var (Type*, Err*) t = TypeParser::ParseTailable(p);
        if(t.1 != null) {
            return (null, t.1);
        }
        var Expr* count = null;
        for(var uint i = 0U; i < 2U; i++) {
            var (Token*, Err*) end = p.ConsumeAny(ExprParser::argumentEnds());
            if(end.1 != null) {
                return (null, end.1);
            } else if(end.0.kind == TokenKind::RightParen) {
                return (Expr.New::Of(start, t.0, count, null), null);
            }
            var (Expr*, Err*) next = ExprParser::ParseAssign(p);
            if(next.1 != null) {
                return next;
            } else if(i == 1U) {
                err = p.Consume(TokenKind::RightParen).1;
                if(err != null) {
                    return (null, err);
                }
                return (Expr.New::Of(start, t.0, count, next.0), null);
            }
            count = next.0;
        }
        return (Expr.New::Of(start, t.0, count, null), null);
    }

    // lambdaValue reads a lambda expression
    fun (Expr*, Err*)(Parser*, Token*) lambdaValue = (p, start) {
        var (Type*, Err*) t = TypeParser::Parse(p);
        if(t.1 != null) {
            return (null, t.1);
        }
        var Type.Function* signature = t.0{Type.Function*};
        if(signature == null) {
            return (null, Errs::LambdaNotFunction);
        }
        var Err* err = p.Consume(TokenKind::Colon).1;
        if(err != null) {
            return (null, err);
        }
        err = p.Consume(TokenKind::LeftParen).1;
        if(err != null) {
            return (null, err);
        }
        var (ArrList[Token*]*, Err*) parameters = ExprParser::ParameterNames(p);
        if(parameters.1 != null) {
            return (null, parameters.1);
        } else if(parameters.0.Len() != signature.parameters.Len()) {
            return (null, Errs::LambdaArity(signature.parameters.Len(), parameters.0.Len()));
        }
        var (Stmt*, Err*) body = StmtParser::Parse(p);
        if(body.1 != null) {
            return (null, body.1);
        }
        return (Expr.Lambda::New(start, signature, parameters.0, body.0), null);
    }

    // ParameterNames reads the names of a function's parameters
    fun (ArrList[Token*]*, Err*)(Parser*) ParameterNames = (p) {
        var ArrList[Token*]* names = ArrList::[Token*]New(0U);
        var (Token*, Err*) empty = p.Match(TokenKind::RightParen);
        if(empty.1 != null) {
            return (null, empty.1);
        } else if(empty.0 != null) {
            return (names, null);
        }
        for {
            var (Token*, Err*) name = p.ConsumeAny(ExprParser::parameterNames());
            if(name.1 != null) {
                return (null, name.1);
            }
            names.AddLast(name.0);
            var (Token*, Err*) end = p.ConsumeAny(ExprParser::argumentEnds());
            if(end.1 != null) {
                return (null, end.1);
            } else if(end.0.kind == TokenKind::RightParen) {
                return (names, null);
            }
        }
        return (names, null);
    }

    // parameterNames answers the tokens a parameter is named by
    fun TreeSet[TokenKind]*() parameterNames = () {
        if(ExprParser::parameterNamesSet == null) {
            ExprParser::parameterNamesSet = TreeSet::[TokenKind]New(2U, TokenKind::Identifier, TokenKind::Underscore);
        }
        return ExprParser::parameterNamesSet;
    }

    // precedence answers the operators of each n-ary level, tightest first
    fun ArrList[TreeSet[TokenKind]*]*() precedence = () {
        if(ExprParser::precedenceLevels == null) {
            var ArrList[TreeSet[TokenKind]*]* levels = ArrList::[TreeSet[TokenKind]*]New(0U);
            levels.AddLast(TreeSet::[TokenKind]New(3U, TokenKind::Star, TokenKind::Slash, TokenKind::Percent));
            levels.AddLast(TreeSet::[TokenKind]New(2U, TokenKind::Plus, TokenKind::Minus));
            levels.AddLast(TreeSet::[TokenKind]New(3U, TokenKind::LessLess, TokenKind::GreaterGreater, TokenKind::GreaterGreaterGreater));
            levels.AddLast(TreeSet::[TokenKind]New(6U, TokenKind::Less, TokenKind::Greater, TokenKind::LessEqual,
                TokenKind::GreaterEqual, TokenKind::Spaceship, TokenKind::Subtype));
            levels.AddLast(TreeSet::[TokenKind]New(2U, TokenKind::EqualEqual, TokenKind::BangEqual));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::And));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::Caret));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::Or));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::AndAnd));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::OrOr));
            levels.AddLast(TreeSet::[TokenKind]New(1U, TokenKind::QuestionQuestion));
            ExprParser::precedenceLevels = levels;
        }
        return ExprParser::precedenceLevels;
    }

    // prefixKinds answers the operators written before an operand
    fun TreeSet[TokenKind]*() prefixKinds = () {
        if(ExprParser::prefixKindsSet == null) {
            ExprParser::prefixKindsSet = TreeSet::[TokenKind]New(10U, TokenKind::PlusPlus, TokenKind::MinusMinus,
                TokenKind::Bang, TokenKind::Tilde, TokenKind::Minus, TokenKind::Plus, TokenKind::Star, TokenKind::And,
                TokenKind::Hash, TokenKind::At);
        }
        return ExprParser::prefixKindsSet;
    }

    // postfixKinds answers the tokens that begin what is written after an operand
    fun TreeSet[TokenKind]*() postfixKinds = () {
        if(ExprParser::postfixKindsSet == null) {
            ExprParser::postfixKindsSet = TreeSet::[TokenKind]New(6U, TokenKind::PlusPlus, TokenKind::MinusMinus,
                TokenKind::Period, TokenKind::LeftBracket, TokenKind::LeftParen, TokenKind::LeftBrace);
        }
        return ExprParser::postfixKindsSet;
    }

    // primaryKinds answers the tokens a primary begins with
    fun TreeSet[TokenKind]*() primaryKinds = () {
        if(ExprParser::primaryKindsSet == null) {
            ExprParser::primaryKindsSet = TreeSet::[TokenKind]New(19U, TokenKind::Lambda, TokenKind::IntLiteral, TokenKind::UintLiteral,
                TokenKind::FloatLiteral, TokenKind::PositLiteral, TokenKind::True, TokenKind::False,
                TokenKind::CharLiteral, TokenKind::StringLiteral, TokenKind::Identifier, TokenKind::This,
                TokenKind::Super, TokenKind::Null, TokenKind::Native, TokenKind::New, TokenKind::Type,
                TokenKind::Wait, TokenKind::Async, TokenKind::LeftParen);
        }
        return ExprParser::primaryKindsSet;
    }

    // fieldNames answers the tokens a field selected out of a value is named by
    fun TreeSet[TokenKind]*() fieldNames = () {
        if(ExprParser::fieldNamesSet == null) {
            ExprParser::fieldNamesSet = TreeSet::[TokenKind]New(2U, TokenKind::Identifier, TokenKind::IntLiteral);
        }
        return ExprParser::fieldNamesSet;
    }

    // argumentEnds answers the tokens that follow an argument
    fun TreeSet[TokenKind]*() argumentEnds = () {
        if(ExprParser::argumentEndsSet == null) {
            ExprParser::argumentEndsSet = TreeSet::[TokenKind]New(2U, TokenKind::Comma, TokenKind::RightParen);
        }
        return ExprParser::argumentEndsSet;
    }

    // typeArgumentEnds answers the tokens that follow a type argument of a generic method
    fun TreeSet[TokenKind]*() typeArgumentEnds = () {
        if(ExprParser::typeArgumentEndsSet == null) {
            ExprParser::typeArgumentEndsSet = TreeSet::[TokenKind]New(2U, TokenKind::Comma, TokenKind::RightBracket);
        }
        return ExprParser::typeArgumentEndsSet;
    }
}
