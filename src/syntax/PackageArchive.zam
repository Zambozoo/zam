import {
    std("codec/archive/Archive.zam");
    std("codec/archive/TAR.zam");
    std("codec/compress/ZSTD.zam");
    std("codec/text/Base64.zam");
    std("codec/text/Hex.zam");
    std("crypto/hash/SHA256.zam");
    std("data/list/ArrList.zam");
    std("data/map/TreeMap.zam");
    std("data/set/HashSet.zam");
    std("data/sort/Sort.zam");
    std("io/Paths.zam");
    std("io/local/File.zam");
    std("io/local/FS.zam");
    std("lang/Arr.zam");
    std("lang/Err.zam");
    std("lang/Iter.zam");
    std("lang/StrErr.zam");
    std("lang/Strs.zam");
}

// PackageArchive keeps a dependency as a zstd-compressed tar of its files
public namespace PackageArchive {
    namespace Errs {
        public fun Err*(str) NotRegular = (name) {
            return StrErr::New(name + " is not a regular file");
        }

        public fun Err*(str) EntryNotRegular = (name) {
            return StrErr::New("entry " + Strs::Quote(name) + " is not a regular file");
        }

        public fun Err*(str) EntryLeaves = (name) {
            return StrErr::New("entry " + Strs::Quote(name) + " leaves the archive");
        }

        public fun Err*(str) EntryTwice = (name) {
            return StrErr::New("entry " + Strs::Quote(name) + " appears twice");
        }
    }

    // HashPrefix prefixes a hash with the scheme it was taken by
    public var str$ HashPrefix = "h1:";

    // Pack writes the regular files of tree to archive
    public fun Err*(str, str) Pack = (tree, archive) {
        var ArrList[str]* names = ArrList::[str]New(0U);
        var Err* err = PackageArchive::walk(tree, "", names);
        if(err != null) {
            return err;
        }
        var Arr[str]* sorted = names.Arr();
        Sort::[str]SortArr(sorted);

        var Arr[Archive.Entry*]* entries = Arr::[Archive.Entry*]New(sorted.Len(), new(Archive.Entry*, sorted.Len())...);
        for(var uint i = 0U; i < sorted.Len(); i++) {
            var (str, Err*) body = FS::ReadFile(Paths::Join(tree, sorted.Get(i)));
            if(body.1 != null) {
                return body.1;
            }
            entries.Set(i, Archive.Entry::File(sorted.Get(i), PackageArchive::bytes(body.0)));
        }
        var (Arr[byte]*, Err*) tar = TAR::Write(entries);
        if(tar.1 != null) {
            return tar.1;
        }
        var Arr[byte]* compressed = ZSTD::Compress(tar.0.Arr(), tar.0.Len(), 3);
        var (File*, Err*) f = File::Create(archive);
        if(f.1 != null) {
            return f.1;
        }
        var (uint, Err*) written = f.0.Write(compressed.Arr(), compressed.Len());
        var Err* closed = f.0.Close();
        if(written.1 != null) {
            return written.1;
        }
        return closed;
    }

    // Entries answers the files of archive
    public fun (Arr[Archive.Entry*]*, Err*)(str) Entries = (archive) {
        var (str, Err*) text = FS::ReadFile(archive);
        if(text.1 != null) {
            return (null, text.1);
        }
        var (byte*, uint) b = Strs::ToBytes(text.0);
        var (Arr[Archive.Entry*]*, Err*) entries = TAR::Read(b.0, b.1);
        if(entries.1 != null) {
            return (null, entries.1);
        }
        var HashSet[str]* seen = HashSet::[str]New(0U);
        for(var uint i = 0U; i < entries.0.Len(); i++) {
            var str name = entries.0.Get(i).name;
            if(!entries.0.Get(i).isFile) {
                return (null, Errs::EntryNotRegular(name));
            } else if(Paths::Clean(name) != name || Paths::IsAbs(name) || name == ".." || Strs::HasPrefix(name, "../")) {
                return (null, Errs::EntryLeaves(name));
            } else if(!seen.Add(name)) {
                return (null, Errs::EntryTwice(name));
            }
        }
        return (entries.0, null);
    }

    // Hash answers the hash of the files in archive
    public fun (str, Err*)(str) Hash = (archive) {
        var (Arr[Archive.Entry*]*, Err*) entries = PackageArchive::Entries(archive);
        if(entries.1 != null) {
            return ("", entries.1);
        }
        var TreeMap[str, str]* sums = TreeMap::[str, str]New(0U);
        for(var uint i = 0U; i < entries.0.Len(); i++) {
            var Archive.Entry* e = entries.0.Get(i);
            var Arr[byte]* sum = SHA256::Sum(e.data.Arr(), e.data.Len());
            sums.Put(e.name, Hex::Encode(sum.Arr(), sum.Len()));
        }
        var str lines = "";
        var Iter[(str, str)]* sorted = sums.Iter();
        for(var ((str, str), bool) next = sorted.Next(); next.1; next = sorted.Next()) {
            lines = lines + next.0.1 + "  " + next.0.0 + "\n";
        }
        var (byte*, uint) b = Strs::ToBytes(lines);
        var Arr[byte]* total = SHA256::Sum(b.0, b.1);
        return (PackageArchive::HashPrefix + Base64::Encode(total.Arr(), total.Len()), null);
    }

    // Extract writes the files of archive to dir, read-only
    public fun Err*(str, str) Extract = (archive, dir) {
        var (Arr[Archive.Entry*]*, Err*) entries = PackageArchive::Entries(archive);
        if(entries.1 != null) {
            return entries.1;
        }
        var (str, Err*) pending = FS::MakeTempDir(Paths::Dir(dir), ".extract-");
        if(pending.1 != null) {
            return pending.1;
        }
        defer PackageArchive::RemoveReadOnly(pending.0);

        for(var uint i = 0U; i < entries.0.Len(); i++) {
            var Archive.Entry* e = entries.0.Get(i);
            var str file = Paths::Join(pending.0, e.name);
            var Err* err = FS::MakeDirs(Paths::Dir(file));
            if(err != null) {
                return err;
            }
            var (File*, Err*) f = File::New(file, File.Flag::WriteOnly{int} | File.Flag::Create{int} | File.Flag::Exclusive{int});
            if(f.1 != null) {
                return f.1;
            }
            var (uint, Err*) written = f.0.Write(e.data.Arr(), e.data.Len());
            var Err* closed = f.0.Close();
            if(written.1 != null) {
                return written.1;
            } else if(closed != null) {
                return closed;
            }
            err = FS::Chmod(file, 292);
            if(err != null) {
                return err;
            }
        }

        var Err* moved = FS::Rename(pending.0, dir);
        if(moved != null) {
            if(FS::IsDir(dir)) {
                return null;
            }
            return moved;
        }
        return PackageArchive::readOnlyDirs(dir);
    }

    // RemoveReadOnly removes dir, making everything under it writable first
    public fun Err*(str) RemoveReadOnly = (dir) {
        if(!FS::Exists(dir)) {
            return null;
        }
        PackageArchive::writable(dir);
        return FS::RemoveAll(dir);
    }

    // walk adds the regular files under the directory rel of tree to names
    fun Err*(str, str, ArrList[str]*) walk = (tree, rel, names) {
        var (Arr[str]*, Err*) children = FS::ReadDir(Paths::Join(tree, rel));
        if(children.1 != null) {
            return children.1;
        }
        for(var uint i = 0U; i < children.0.Len(); i++) {
            var str child = Paths::Join(rel, children.0.Get(i));
            var str path = Paths::Join(tree, child);
            if(child == ".git") {
                continue;
            } else if(FS::IsLink(path)) {
                return Errs::NotRegular(child);
            } else if(FS::IsDir(path)) {
                var Err* err = PackageArchive::walk(tree, child, names);
                if(err != null) {
                    return err;
                }
            } else {
                names.AddLast(child);
            }
        }
        return null;
    }

    // readOnlyDirs makes every directory under dir, and dir itself, read-only
    fun Err*(str) readOnlyDirs = (dir) {
        var (Arr[str]*, Err*) children = FS::ReadDir(dir);
        if(children.1 != null) {
            return children.1;
        }
        for(var uint i = 0U; i < children.0.Len(); i++) {
            var str child = Paths::Join(dir, children.0.Get(i));
            if(FS::IsDir(child)) {
                var Err* err = PackageArchive::readOnlyDirs(child);
                if(err != null) {
                    return err;
                }
            }
        }
        return FS::Chmod(dir, 365);
    }

    // writable makes path, and everything under it, writable
    fun void(str) writable = (path) {
        if(FS::IsLink(path) || !FS::IsDir(path)) {
            FS::Chmod(path, 420);
            return;
        }
        FS::Chmod(path, 493);
        var (Arr[str]*, Err*) children = FS::ReadDir(path);
        if(children.1 != null) {
            return;
        }
        for(var uint i = 0U; i < children.0.Len(); i++) {
            PackageArchive::writable(Paths::Join(path, children.0.Get(i)));
        }
    }

    // bytes answers the bytes of s
    fun Arr[byte]*(str) bytes = (s) {
        var (byte*, uint) p = Strs::ToBytes(s);
        var byte* b = new(byte, p.1);
        for(var uint i = 0U; i < p.1; i++) {
            b[i] = p.0[i];
        }
        return Arr::[byte]New(p.1, b...);
    }
}
