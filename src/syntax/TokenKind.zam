// TokenKind is what a token is: a symbol, a keyword, a literal, a name or the
// end of a file
public enum TokenKind {
    // Group is the classification of a token
    public enum Group : str {
        Other("other"),
        Symbol("symbol"),
        Keyword("keyword");
    }

    None.Init("NONE", Group::Other),
    Equal.Init("=", Group::Symbol),
    EqualEqual.Init("==", Group::Symbol),
    BangEqual.Init("!=", Group::Symbol),
    Less.Init("<", Group::Symbol),
    Greater.Init(">", Group::Symbol),
    LessEqual.Init("<=", Group::Symbol),
    GreaterEqual.Init(">=", Group::Symbol),
    Spaceship.Init("<=>", Group::Symbol),
    AndAnd.Init("&&", Group::Symbol),
    OrOr.Init("||", Group::Symbol),
    And.Init("&", Group::Symbol),
    Or.Init("|", Group::Symbol),
    Caret.Init("^", Group::Symbol),
    Tilde.Init("~", Group::Symbol),
    LessLess.Init("<<", Group::Symbol),
    GreaterGreater.Init(">>", Group::Symbol),
    GreaterGreaterGreater.Init(">>>", Group::Symbol),
    Plus.Init("+", Group::Symbol),
    Minus.Init("-", Group::Symbol),
    Star.Init("*", Group::Symbol),
    Slash.Init("/", Group::Symbol),
    Bang.Init("!", Group::Symbol),
    Percent.Init("%", Group::Symbol),
    PlusPlus.Init("++", Group::Symbol),
    MinusMinus.Init("--", Group::Symbol),
    Period.Init(".", Group::Symbol),
    PeriodPeriodPeriod.Init("...", Group::Symbol),
    Colon.Init(":", Group::Symbol),
    ColonColon.Init("::", Group::Symbol),
    SemiColon.Init(";", Group::Symbol),
    LeftBrace.Init("{", Group::Symbol),
    RightBrace.Init("}", Group::Symbol),
    LeftBracket.Init("[", Group::Symbol),
    RightBracket.Init("]", Group::Symbol),
    LeftParen.Init("(", Group::Symbol),
    RightParen.Init(")", Group::Symbol),
    Comma.Init(",", Group::Symbol),
    Question.Init("?", Group::Symbol),
    QuestionQuestion.Init("??", Group::Symbol),
    At.Init("@", Group::Symbol),
    Hash.Init("#", Group::Symbol),
    Dollar.Init("$", Group::Symbol),
    Subtype.Init("<:", Group::Symbol),
    Supertype.Init(":>", Group::Symbol),
    Abstract.Init("abstract", Group::Keyword),
    Alias.Init("alias", Group::Keyword),
    Any.Init("any", Group::Keyword),
    Async.Init("async", Group::Keyword),
    Bool.Init("bool", Group::Keyword),
    Break.Init("break", Group::Keyword),
    Byte.Init("byte", Group::Keyword),
    Case.Init("case", Group::Keyword),
    Char.Init("char", Group::Keyword),
    Class.Init("class", Group::Keyword),
    Continue.Init("continue", Group::Keyword),
    Defer.Init("defer", Group::Keyword),
    Delete.Init("delete", Group::Keyword),
    Else.Init("else", Group::Keyword),
    Enum.Init("enum", Group::Keyword),
    False.Init("false", Group::Keyword),
    Float.Init("flt", Group::Keyword),
    For.Init("for", Group::Keyword),
    Free.Init("free", Group::Keyword),
    Fun.Init("fun", Group::Keyword),
    If.Init("if", Group::Keyword),
    Import.Init("import", Group::Keyword),
    Int.Init("int", Group::Keyword),
    Interface.Init("interface", Group::Keyword),
    Label.Init("label", Group::Keyword),
    Lambda.Init("lambda", Group::Keyword),
    Mark.Init("mark", Group::Keyword),
    Namespace.Init("namespace", Group::Keyword),
    Native.Init("native", Group::Keyword),
    New.Init("new", Group::Keyword),
    Null.Init("null", Group::Keyword),
    Private.Init("private", Group::Keyword),
    Protected.Init("protected", Group::Keyword),
    Public.Init("public", Group::Keyword),
    Posit.Init("pst", Group::Keyword),
    Return.Init("return", Group::Keyword),
    Static.Init("static", Group::Keyword),
    String.Init("str", Group::Keyword),
    Struct.Init("struct", Group::Keyword),
    Super.Init("super", Group::Keyword),
    Switch.Init("switch", Group::Keyword),
    This.Init("this", Group::Keyword),
    Thread.Init("thread", Group::Keyword),
    True.Init("true", Group::Keyword),
    Type.Init("type", Group::Keyword),
    Var.Init("var", Group::Keyword),
    Virtual.Init("virtual", Group::Keyword),
    Void.Init("void", Group::Keyword),
    Uint.Init("uint", Group::Keyword),
    Wait.Init("wait", Group::Keyword),
    IntLiteral.Init("INT_LITERAL", Group::Other),
    UintLiteral.Init("UINT_LITERAL", Group::Other),
    FloatLiteral.Init("FLOAT_LITERAL", Group::Other),
    PositLiteral.Init("POSIT_LITERAL", Group::Other),
    StringLiteral.Init("STRING_LITERAL", Group::Other),
    CharLiteral.Init("CHAR_LITERAL", Group::Other),
    NullLiteral.Init("NULL_LITERAL", Group::Other),
    Identifier.Init("IDENTIFIER", Group::Other),
    Underscore.Init("UNDERSCORE", Group::Other),
    EOF.Init("EOF", Group::Other);

    // text is the source text of a symbol or keyword, and the kind's name
    // otherwise
    public var str text;
    public var Group group;

    public fun str() Str = () {
        return this.text;
    }

    fun void(str, Group) Init = (text, group) {
        this.text = text;
        this.group = group;
    }
}
