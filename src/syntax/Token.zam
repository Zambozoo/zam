import "TokenKind.zam";

// Token is a kind and value lexed at an offset
public class Token {
    public var TokenKind kind;
    // offset is where the token starts
    public var uint offset;
    // value is an identifer or literal value
    public var any value;

    public static fun Token*(TokenKind, uint, any) New = (kind, offset, value) {
        var Token* t = new(Token);
        t.kind = kind;
        t.offset = offset;
        t.value = value;
        return t;
    }
}
