import std("lang/Arr.zam");
import std("lang/Enums.zam");
import std("io/local/File.zam");
import "../TokenKind.zam";

// Main writes out what the Zam syntax package makes of its input, one line
// at a time, for comparison with the Go syntax package
namespace Main {
    fun void(uint, str...) main = (argC, argV) {
        var Arr[TokenKind]* all = Enums::[TokenKind]All();
        for(var uint i = 0U; i < all.Len(); i++) {
            var TokenKind k = all.Get(i);
            File::StdOut.WriteStr(k.text + " " + k.group{str} + "\n");
        }
    }
}
