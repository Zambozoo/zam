import std("data/list/ArrList.zam");
import std("data/map/HashMap.zam");
import "../syntax/Token.zam";
import "../syntax/TokenKind.zam";
import ast = "../syntax/ast/*";

// Type is a type with the names in it resolved
public abstract Type {
    // Kind is which type a Type is
    public enum Kind : int {
        Primitive(0),
        Wrapped(1),
        Array(2),
        Tailed(3),
        Tuple(4),
        Function(5),
        Named(6),
        Generic(7),
        Param(8);
    }

    public var Kind kind;
    // at is the token the type is written at, or null for one not written
    public var Token* at;

    // nullType is the type of null once it is first asked for, built then since TokenKind's values are not yet set while statics are
    static var Type* nullType = null;

    // Null answers the type of null: a void* that stands for every pointer, str and function
    public static fun Type*() Null = () {
        if(Type::nullType == null) {
            Type::nullType = Type.Wrapped::New(null, ast.Type.Wrap::Pointer, Type.Primitive::New(null, TokenKind::Void));
        }
        return Type::nullType;
    }

    // Text writes the type as messages name it
    public virtual fun str() Text;

    // Instantiate answers a copy of the type written at at
    public virtual fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate;

    // ContainsParam reports whether a generic parameter appears anywhere in t
    public static fun bool(Type*) ContainsParam = (t) {
        switch(t.kind) {
            case (Kind::Param)
                return true;
            case (Kind::Wrapped)
                return Type::ContainsParam(t{Wrapped*}.inner);
            case (Kind::Array)
                return Type::ContainsParam(t{Array*}.inner);
            case (Kind::Tailed)
                return Type::ContainsParam(t{Tailed*}.inner);
            case (Kind::Tuple)
                return Type::anyParam(t{Tuple*}.types);
            case (Kind::Function)
                return Type::ContainsParam(t{Function*}.returns) || Type::anyParam(t{Function*}.parameters);
            case (Kind::Generic)
                return Type::ContainsParam(t{Generic*}.inner) || Type::anyParam(t{Generic*}.arguments);
        }
        return false;
    }

    static fun bool(ArrList[Type*]*) anyParam = (types) {
        for(var uint i = 0U; i < types.Len(); i++) {
            if(Type::ContainsParam(types.Get(i))) {
                return true;
            }
        }
        return false;
    }

    // instantiateAll instantiates each of types
    static fun ArrList[Type*]*(ArrList[Type*]*, HashMap[ast.Generic*, Type*]*, Token*) instantiateAll = (types, bindings, at) {
        var ArrList[Type*]* copied = ArrList::[Type*]New(0U);
        for(var uint i = 0U; i < types.Len(); i++) {
            copied.AddLast(types.Get(i).Instantiate(bindings, at));
        }
        return copied;
    }

    // texts writes types as messages name them, separated by commas
    static fun str(ArrList[Type*]*) texts = (types) {
        var str out = "";
        for(var uint i = 0U; i < types.Len(); i++) {
            if(i > 0U) {
                out = out + ", ";
            }
            out = out + types.Get(i).Text();
        }
        return out;
    }

    // Primitive is a type named by its keyword
    public class Primitive <: Type* {
        public var TokenKind keyword;

        public static fun Primitive*(Token*, TokenKind) New = (at, keyword) {
            var Primitive* t = new(Primitive);
            t.kind = Kind::Primitive;
            t.at = at;
            t.keyword = keyword;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Primitive::New(at, this.keyword);
        }

        public fun str() Text = () {
            return this.keyword.text;
        }
    }

    // Wrapped is a wrapper around a type
    public class Wrapped <: Type* {
        public var ast.Type.Wrap wrap;
        public var Type* inner;

        public static fun Wrapped*(Token*, ast.Type.Wrap, Type*) New = (at, wrap, inner) {
            var Wrapped* t = new(Wrapped);
            t.kind = Kind::Wrapped;
            t.at = at;
            t.wrap = wrap;
            t.inner = inner;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Wrapped::New(at, this.wrap, this.inner.Instantiate(bindings, at));
        }

        public fun str() Text = () {
            switch(this.wrap) {
                case (ast.Type.Wrap::Pointer)
                    return this.inner.Text() + "*";
                case (ast.Type.Wrap::Variadic)
                    return this.inner.Text() + "...";
                case (ast.Type.Wrap::Thread)
                    return "thread[" + this.inner.Text() + "]";
            }
            return this.inner.Text() + "$";
        }
    }

    // Array is a run of a type, sized or, as a tail
    public class Array <: Type* {
        public var Type* inner;
        public var bool sized;
        public var uint size;

        public static fun Array*(Token*, Type*, bool, uint) New = (at, inner, sized, size) {
            var Array* t = new(Array);
            t.kind = Kind::Array;
            t.at = at;
            t.inner = inner;
            t.sized = sized;
            t.size = size;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Array::New(at, this.inner.Instantiate(bindings, at), this.sized, this.size);
        }

        public fun str() Text = () {
            if(this.sized) {
                return this.inner.Text() + "[" + this.size{str} + "]";
            }
            return this.inner.Text() + "[~]";
        }
    }

    // Tailed is a declaration with a tail, of a size or of any
    public class Tailed <: Type* {
        public var Type* inner;
        public var bool sized;
        public var uint size;

        public static fun Tailed*(Token*, Type*, bool, uint) New = (at, inner, sized, size) {
            var Tailed* t = new(Tailed);
            t.kind = Kind::Tailed;
            t.at = at;
            t.inner = inner;
            t.sized = sized;
            t.size = size;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Tailed::New(at, this.inner.Instantiate(bindings, at), this.sized, this.size);
        }

        public fun str() Text = () {
            if(this.sized) {
                return this.inner.Text() + "~" + this.size{str};
            }
            return this.inner.Text() + "~";
        }
    }

    // Tuple is two or more types held together
    public class Tuple <: Type* {
        public var ArrList[Type*]* types;

        public static fun Tuple*(Token*, ArrList[Type*]*) New = (at, types) {
            var Tuple* t = new(Tuple);
            t.kind = Kind::Tuple;
            t.at = at;
            t.types = types;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Tuple::New(at, Type::instantiateAll(this.types, bindings, at));
        }

        public fun str() Text = () {
            return "(" + Type::texts(this.types) + ")";
        }
    }

    // Function is a function's return type and parameter types
    public class Function <: Type* {
        public var Type* returns;
        public var ArrList[Type*]* parameters;

        public static fun Function*(Token*, Type*, ArrList[Type*]*) New = (at, returns, parameters) {
            var Function* t = new(Function);
            t.kind = Kind::Function;
            t.at = at;
            t.returns = returns;
            t.parameters = parameters;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Function::New(at, this.returns.Instantiate(bindings, at), Type::instantiateAll(this.parameters, bindings, at));
        }

        public fun str() Text = () {
            return this.returns.Text() + "(" + Type::texts(this.parameters) + ")";
        }
    }

    // Named is a declaration, named as it is written
    public class Named <: Type* {
        public var ast.Decl* decl;
        // name is the dotted path the declaration is named by
        public var str name;
        // archive is the repo@version of the fetched project the declaration is in
        public var str archive;

        public static fun Named*(Token*, ast.Decl*, str, str) New = (at, decl, name, archive) {
            var Named* t = new(Named);
            t.kind = Kind::Named;
            t.at = at;
            t.decl = decl;
            t.name = name;
            t.archive = archive;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Named::New(at, this.decl, this.name, this.archive);
        }

        public fun str() Text = () {
            if(this.archive != "") {
                return this.archive + ":" + this.name;
            }
            return this.name;
        }
    }

    // Generic is a generic declaration given its type arguments
    public class Generic <: Type* {
        public var Type* inner;
        public var ArrList[Type*]* arguments;

        public static fun Generic*(Token*, Type*, ArrList[Type*]*) New = (at, inner, arguments) {
            var Generic* t = new(Generic);
            t.kind = Kind::Generic;
            t.at = at;
            t.inner = inner;
            t.arguments = arguments;
            return t;
        }

        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            return Generic::New(at, this.inner.Instantiate(bindings, at), Type::instantiateAll(this.arguments, bindings, at));
        }

        public fun str() Text = () {
            return this.inner.Text() + "[" + Type::texts(this.arguments) + "]";
        }
    }

    // Param is a generic parameter of a declaration, method or alias
    public class Param <: Type* {
        public var ast.Generic* param;
        // owner is the declaration or method declaring the parameter
        public var ast.Field* owner;

        public static fun Param*(Token*, ast.Generic*, ast.Field*) New = (at, param, owner) {
            var Param* t = new(Param);
            t.kind = Kind::Param;
            t.at = at;
            t.param = param;
            t.owner = owner;
            return t;
        }

        // Instantiate answers what the parameter is bound to
        public fun Type*(HashMap[ast.Generic*, Type*]*, Token*) Instantiate = (bindings, at) {
            var (Type*, bool) bound = bindings.Get(this.param);
            if(bound.1) {
                return bound.0;
            }
            return this;
        }

        public fun str() Text = () {
            return this.param.name.value{str};
        }
    }
}
