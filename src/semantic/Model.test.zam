import {
    std("data/list/ArrList.zam");
    std("lang/Err.zam");
    std("lang/StrErr.zam");
    std("test/Assert.zam");
    "../syntax/MapSources.test.zam";
    "../syntax/Path.zam";
    "../syntax/ProjectParser.zam";
    ast = "../syntax/ast/*";
    "../syntax/Token.zam";
    "../syntax/TokenKind.zam";
    "Model.zam";
    "Type.zam";
}

public namespace ModelTest {
    public fun void(uint, str...) Declarations = (argC, argV) {
        var (ProjectParser.Program*, ArrList[Err*]*) parsed = MapSourcesTest::Parse(MapSourcesTest::Files(4U,
            "/p/Main.zam", "import \"A.zam\";\npublic namespace Main {\n    class Inner {\n        var int x;\n    }\n}",
            "/p/A.zam", "class A {}"));
        if(!Assert::[uint]Equal(0U, parsed.1.Len())) {
            Assert::Fatal(parsed.1.Get(0U).Err());
        }
        var Model* m = Model::New(parsed.0);
        var ast.Decl* main = parsed.0.main;
        var ast.Decl* inner = m.Nested(main, "Inner");
        if(!Assert::True(inner != null, "Inner is not nested in Main")) {
            return;
        }
        var ast.Field* x = inner.fields.Get(0U);
        var ast.Decl* a = parsed.0.sources.Get("/p/A.zam").0.file.decl;

        Assert::True(m.Nested(main, "Missing") == null, "a missing declaration is nested");
        Assert::True(m.Nested(inner, "x") == null, "a member is a nested declaration");
        Assert::True(m.Outer(main) == null, "a file's declaration is written in another");
        Assert::True(m.Outer(inner) == main, "Inner is not written in Main");
        Assert::True(m.Outer(x) == inner, "x is not written in Inner");
        Assert::True(m.Outer(a) == null, "A is written in another declaration");
        Assert::[str]Equal("/p/Main.zam", m.Source(inner).path);
        Assert::[str]Equal("/p/A.zam", m.Source(a).path);
        var ast.Import* imported = parsed.0.sources.Get("/p/Main.zam").0.file.imports.Get(0U);
        if(Assert::[uint]Equal(1U, m.Imported(imported).Len())) {
            Assert::[str]Equal("/p/A.zam", m.Imported(imported).Get(0U).path);
        }
        Assert::True(m.TypeOf(inner.fields.Get(0U){ast.Field.Member*}.declared) == null, "a type is resolved before resolution");
        Assert::[str]Equal("bad (" + Path::Display("/p/Main.zam") + "[3:11])", m.At(inner, inner.name, StrErr::New("bad")).Err());
    }

    public fun void(uint, str...) Expansion = (argC, argV) {
        var (ProjectParser.Program*, ArrList[Err*]*) parsed = MapSourcesTest::Parse(MapSourcesTest::Files(2U,
            "/p/Main.zam", "public namespace Main {\n    alias Number = int;\n    var Number n;\n}"));
        var Model* m = Model::New(parsed.0);
        var ast.Decl.Alias* number = m.Nested(parsed.0.main, "Number"){ast.Decl.Alias*};
        var ast.Type* declared = parsed.0.main.fields.Get(1U){ast.Field.Member*}.declared;
        var Type* asWritten = Type.Named::New(declared.start, number, "Number", "");
        var Type* expanded = Type.Primitive::New(declared.start, TokenKind::Int);

        m.bindType(declared, asWritten);
        Assert::True(m.Written(declared) == asWritten, "a type not expanded is not as written");
        m.rebindType(declared, expanded);
        Assert::True(m.TypeOf(declared) == expanded, "an expanded type is not what it resolves to");
        Assert::True(m.Written(declared) == asWritten, "an expanded type is not kept as written");
        m.rebindType(declared, Type.Primitive::New(declared.start, TokenKind::Int));
        Assert::True(m.Written(declared) == asWritten, "rebinding again loses what was written");

        Assert::[uint]Equal(0U, m.Uses().Len());
        m.addUse(Model.Use::New(number, ArrList::[Type*]New(0U), declared{ast.Type.Reference*}, parsed.0.main));
        if(Assert::[uint]Equal(1U, m.Uses().Len())) {
            Assert::True(m.Uses().Get(0U).named == number, "the use is not of Number");
        }
    }
}
