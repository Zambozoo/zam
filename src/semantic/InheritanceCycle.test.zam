import {
    std("data/list/ArrList.zam");
    std("lang/Err.zam");
    std("test/Assert.zam");
    "../syntax/MapSources.test.zam";
    "../syntax/Path.zam";
    "../syntax/ProjectParser.zam";
    "Alias.zam";
    "GenericCycle.zam";
    "InheritanceCycle.zam";
    "Model.zam";
    "Resolve.zam";
}

public namespace InheritanceCycleTest {
    // reports checks that the program /p/Main.zam, written as main, has the
    // cycles want, each a message and its position in /p/Main.zam, in order
    private fun void(str, uint, str...) reports = (main, n, want) {
        var (ProjectParser.Program*, ArrList[Err*]*) parsed = MapSourcesTest::Parse(MapSourcesTest::Files(2U, "/p/Main.zam", main));
        if(!Assert::[uint]Equal(0U, parsed.1.Len())) {
            Assert::Fatal(parsed.1.Get(0U).Err());
        }
        var Model* m = Model::New(parsed.0);
        var ArrList[Err*]* errs = Resolve::Run(m);
        if(errs.Len() == 0U) {
            errs = Alias::Run(m);
        }
        if(errs.Len() == 0U) {
            errs = GenericCycle::Run(m);
        }
        if(!Assert::[uint]Equal(0U, errs.Len())) {
            Assert::Fatal(errs.Get(0U).Err());
        }

        errs = InheritanceCycle::Run(m);
        Assert::[uint]Equal(n / 2U, errs.Len());
        for(var uint i = 0U; i + 1U < n && i / 2U < errs.Len(); i = i + 2U) {
            Assert::[str]Equal("inheritance cycle detected: " + want[i] + " (" + Path::Display("/p/Main.zam") + want[i + 1U] + ")", errs.Get(i / 2U).Err());
        }
    }

    public fun void(uint, str...) Cycles = (argC, argV) {
        InheritanceCycleTest::reports("public namespace Main {\n" +
            "    class A <: B* {\n" +
            "    }\n" +
            "    class B <: A* {\n" +
            "    }\n" +
            "    class C <: C* {\n" +
            "    }\n" +
            "    abstract D <: E* {\n" +
            "    }\n" +
            "    class E <: D* {\n" +
            "    }\n" +
            "    namespace Outer {\n" +
            "        class F <: Outer.G* {\n" +
            "        }\n" +
            "        class G <: F* {\n" +
            "        }\n" +
            "    }\n" +
            "}\n", 8U,
            "A inherits from B", "[2:5]",
            "C inherits from C", "[6:5]",
            "D inherits from E", "[8:5]",
            "F inherits from Outer.G", "[13:9]");
    }

    public fun void(uint, str...) Generics = (argC, argV) {
        InheritanceCycleTest::reports("public namespace Main {\n" +
            "    class A[T] <: B[T]* {\n" +
            "    }\n" +
            "    class B[T] <: A[T]* {\n" +
            "    }\n" +
            "    class C[T] <: D[int]* {\n" +
            "    }\n" +
            "    class D[T] <: C[str]* {\n" +
            "    }\n" +
            "}\n", 4U,
            "A inherits from B[T]", "[2:5]",
            "C inherits from D[int]", "[6:5]");
    }

    public fun void(uint, str...) Acyclic = (argC, argV) {
        InheritanceCycleTest::reports("public namespace Main {\n" +
            "    abstract Root {}\n" +
            "    abstract Middle <: Root* {}\n" +
            "    class Left <: Middle* {}\n" +
            "    class Right <: Middle* {}\n" +
            "    class Holder <: Box[Left*]* {\n" +
            "        class Inner <: Holder* {}\n" +
            "    }\n" +
            "    class Box[T] {}\n" +
            "}\n", 0U);
    }

    // Broken finds cycles in what a parse recovered from without failing on
    // what it left out
    public fun void(uint, str...) Broken = (argC, argV) {
        var (ProjectParser.Program*, ArrList[Err*]*) parsed = MapSourcesTest::Parse(MapSourcesTest::Files(2U, "/p/Main.zam",
            "public namespace Main {\n    class A <: A* {\n        fun void() f = () {\n            var int x = ;\n        }\n    }\n}\n"));
        Assert::True(parsed.1.Len() > 0U, "the broken file parses");
        if(!Assert::True(parsed.0 != null, "the parse recovers nothing")) {
            return;
        }
        var Model* m = Model::New(parsed.0);
        Assert::[uint]Equal(0U, Resolve::Run(m).Len());
        Assert::[uint]Equal(0U, Alias::Run(m).Len());
        Assert::[uint]Equal(0U, GenericCycle::Run(m).Len());
        Assert::[uint]Equal(1U, InheritanceCycle::Run(m).Len());
    }
}
