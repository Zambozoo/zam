import std("data/list/ArrList.zam");
import "Subtyping.zam";
import "Type.zam";

// TypeSet is types in the order first added, each the same type as none before it
public class TypeSet {
    var Subtyping* subtyping;
    var ArrList[Type*]* types;

    public static fun TypeSet*(Subtyping*) New = (subtyping) {
        var TypeSet* s = new(TypeSet);
        s.subtyping = subtyping;
        s.types = ArrList::[Type*]New(0U);
        return s;
    }

    // Add adds t, reporting whether it was not already held
    public fun bool(Type*) Add = (t) {
        if(this.Contains(t)) {
            return false;
        }
        this.types.AddLast(t);
        return true;
    }

    public fun bool(Type*) Contains = (t) {
        for(var uint i = 0U; i < this.types.Len(); i++) {
            if(this.subtyping.Equal(this.types.Get(i), t)) {
                return true;
            }
        }
        return false;
    }

    public fun uint() Len = () {
        return this.types.Len();
    }

    public fun Type*(uint) Get = (i) {
        return this.types.Get(i);
    }
}
