import {
    std("data/list/ArrList.zam");
    std("data/set/HashSet.zam");
    std("lang/Err.zam");
    std("lang/Iter.zam");
    std("lang/StrErr.zam");
    "../syntax/Source.zam";
    ast = "../syntax/ast/*";
    "Model.zam";
    "Type.zam";
}

// InheritanceCycle rejects a class or abstract whose chain of bases leads back to itself
public class InheritanceCycle {
    var Model* model;
    var ArrList[Err*]* errs;
    // cycle is the declarations on the chain of bases being followed
    var HashSet[ast.Decl*]* cycle;
    // visited is the declarations whose chains of bases have been followed
    var HashSet[ast.Decl*]* visited;

    // Run finds the classes and abstracts of the program m models that inherit from themselves
    public static fun ArrList[Err*]*(Model*) Run = (m) {
        var InheritanceCycle* c = new(InheritanceCycle);
        c.model = m;
        c.errs = ArrList::[Err*]New(0U);
        c.cycle = HashSet::[ast.Decl*]New(0U);
        c.visited = HashSet::[ast.Decl*]New(0U);
        var Iter[(str, Source*)]* all = m.Program().sources.Iter();
        for(var ((str, Source*), bool) next = all.Next(); next.1; next = all.Next()) {
            if(next.0.1.file.decl != null) {
                c.visit(next.0.1.file.decl);
            }
        }
        return c.errs;
    }

    // visit follows the chain of bases of d
    fun void(ast.Decl*) visit = (d) {
        if(d.kind == ast.Field.Kind::Alias) {
            return;
        } else if(d.kind != ast.Field.Kind::Class && d.kind != ast.Field.Kind::Abstract) {
            this.nested(d);
            return;
        } else if(this.visited.Contains(d)) {
            return;
        }

        var Type* base = this.model.Base(d);
        if(this.cycle.Contains(d)) {
            this.errs.AddLast(this.model.At(d, d.start, StrErr::New("inheritance cycle detected: " + d.name.value{str} + " inherits from " + InheritanceCycle::named(base).Text())));
            return;
        }
        this.cycle.Add(d);
        var ast.Decl* next = InheritanceCycle::declOf(InheritanceCycle::named(base));
        if(next != null) {
            this.visit(next);
        }
        this.cycle.Remove(d);
        this.visited.Add(d);
        this.nested(d);
    }

    // nested visits the declarations nested in d
    fun void(ast.Decl*) nested = (d) {
        var HashSet[ast.Decl*]* outer = this.cycle;
        this.cycle = HashSet::[ast.Decl*]New(0U);
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Decl* inner = d.fields.Get(i){ast.Decl*};
            if(inner != null) {
                this.visit(inner);
            }
        }
        this.cycle = outer;
    }

    // named answers the type base points to, or null for none
    static fun Type*(Type*) named = (base) {
        if(base == null || base.kind != Type.Kind::Wrapped) {
            return null;
        }
        return base{Type.Wrapped*}.inner;
    }

    // declOf answers the declaration t names, or null for none
    static fun ast.Decl*(Type*) declOf = (t) {
        if(t != null && t.kind == Type.Kind::Generic) {
            t = t{Type.Generic*}.inner;
        }
        if(t != null && t.kind == Type.Kind::Tailed) {
            t = t{Type.Tailed*}.inner;
        }
        if(t == null || t.kind != Type.Kind::Named) {
            return null;
        }
        return t{Type.Named*}.decl;
    }
}
