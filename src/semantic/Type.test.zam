import std("data/list/ArrList.zam");
import std("data/map/HashMap.zam");
import std("test/Assert.zam");
import "../syntax/Token.zam";
import "../syntax/TokenKind.zam";
import ast = "../syntax/ast/*";
import "Type.zam";

public namespace TypeTest {
    // named answers a reference named name to a declaration of that name
    private fun Type*(str, str) named = (name, archive) {
        var Token* id = Token::New(TokenKind::Identifier, 0U, name);
        var ast.Decl* d = ast.Decl.Object::New(ast.Field.Kind::Class, id, 0U, id);
        return Type.Named::New(id, d, name, archive);
    }

    private fun Type*(TokenKind) primitive = (keyword) {
        return Type.Primitive::New(null, keyword);
    }

    public fun void(uint, str...) Text = (argC, argV) {
        var Type* i = TypeTest::primitive(TokenKind::Int);
        var Type* s = TypeTest::primitive(TokenKind::String);
        Assert::[str]Equal("int", i.Text());
        Assert::[str]Equal("int*", Type.Wrapped::New(null, ast.Type.Wrap::Pointer, i).Text());
        Assert::[str]Equal("int$", Type.Wrapped::New(null, ast.Type.Wrap::Const, i).Text());
        Assert::[str]Equal("int...", Type.Wrapped::New(null, ast.Type.Wrap::Variadic, i).Text());
        Assert::[str]Equal("thread[int]", Type.Wrapped::New(null, ast.Type.Wrap::Thread, i).Text());
        Assert::[str]Equal("int[4]", Type.Array::New(null, i, true, 4U).Text());
        Assert::[str]Equal("int[~]", Type.Array::New(null, i, false, 0U).Text());
        Assert::[str]Equal("(int, str)", Type.Tuple::New(null, ArrList::[Type*]New(2U, i, s)).Text());
        Assert::[str]Equal("int(str, int)", Type.Function::New(null, i, ArrList::[Type*]New(2U, s, i)).Text());
        Assert::[str]Equal("void()", Type.Function::New(null, TypeTest::primitive(TokenKind::Void), ArrList::[Type*]New(0U)).Text());

        Assert::[str]Equal("lib.Dep", TypeTest::named("lib.Dep", "").Text());
        Assert::[str]Equal("example.com/dep@v1:lib.Dep", TypeTest::named("lib.Dep", "example.com/dep@v1").Text());
        Assert::[str]Equal("Node~", Type.Tailed::New(null, TypeTest::named("Node", ""), false, 0U).Text());
        Assert::[str]Equal("Node~3", Type.Tailed::New(null, TypeTest::named("Node", ""), true, 3U).Text());
        Assert::[str]Equal("Map[str, int*]", Type.Generic::New(null, TypeTest::named("Map", ""), ArrList::[Type*]New(2U, s, Type.Wrapped::New(null, ast.Type.Wrap::Pointer, i))).Text());

        var Token* t = Token::New(TokenKind::Identifier, 0U, "T");
        var ast.Generic* g = ast.Generic::New(t, ast.Generic.Bound::None, null);
        Assert::[str]Equal("T*", Type.Wrapped::New(null, ast.Type.Wrap::Pointer, Type.Param::New(t, g, null)).Text());
    }

    public fun void(uint, str...) Instantiate = (argC, argV) {
        var Token* tok = Token::New(TokenKind::Identifier, 0U, "T");
        var ast.Generic* t = ast.Generic::New(tok, ast.Generic.Bound::None, null);
        var ast.Generic* u = ast.Generic::New(Token::New(TokenKind::Identifier, 0U, "U"), ast.Generic.Bound::None, null);
        var Type* s = TypeTest::primitive(TokenKind::String);
        var Type* uParam = Type.Param::New(null, u, null);
        var Type* box = TypeTest::named("Box", "");
        var Type* f = Type.Function::New(null, Type.Param::New(null, t, null), ArrList::[Type*]New(3U, uParam, TypeTest::primitive(TokenKind::Int), box));
        var HashMap[ast.Generic*, Type*]* bindings = HashMap::[ast.Generic*, Type*]New(1U, (t, s));
        var Token* at = Token::New(TokenKind::Identifier, 7U, "Use");

        var Type* got = f.Instantiate(bindings, at);
        Assert::[str]Equal("str(U, int, Box)", got.Text());
        Assert::[str]Equal("T(U, int, Box)", f.Text());
        Assert::True(got.at == at, "the copy is not written at the use");
        var Type.Function* copied = got{Type.Function*};
        Assert::True(copied.returns == s, "a bound parameter is not replaced by what it is bound to");
        Assert::True(copied.parameters.Get(0U) == uParam, "an unbound parameter is not kept");
        Assert::True(copied.parameters.Get(1U).at == at, "a primitive is not written at the use");
        var Type.Named* named = copied.parameters.Get(2U){Type.Named*};
        Assert::True(named.at == at, "a declaration is not written at the use");
        Assert::True(named.decl == box{Type.Named*}.decl, "a declaration is not kept");
    }
}
