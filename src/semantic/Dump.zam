import {
    std("data/list/ArrList.zam");
    std("lang/Arr.zam");
    ast = "../syntax/ast/*";
    "Canonical.zam";
    "Members.zam";
    "Model.zam";
    "Type.zam";
    "TypeSet.zam";
}

// Dump writes what monomorphization and interface collection found out about a program, one fact a line, as Go's are compared
public namespace Dump {
    // Lines answers the facts m holds
    public fun ArrList[str]*(Model*) Lines = (m) {
        var ArrList[str]* lines = ArrList::[str]New(0U);
        var ArrList[Type*]* instances = m.Instances();
        for(var uint i = 0U; i < instances.Len(); i++) {
            var Type* t = instances.Get(i);
            lines.AddLast("instance " + Canonical::Decl(m, Members::DeclOf(t)) + " " + Canonical::Text(m, t));
        }
        var ArrList[Model.MethodInstance*]* methods = m.MethodInstances();
        for(var uint i = 0U; i < methods.Len(); i++) {
            var Model.MethodInstance* mi = methods.Get(i);
            lines.AddLast("method " + Canonical::Decl(m, mi.owner) + "::" + mi.method.name.value{str} + " [" + Canonical::Texts(m, mi.arguments) + "]");
        }
        var Arr[(ast.Field*, TypeSet*)]* open = m.OpenTypes().Arr();
        for(var uint i = 0U; i < open.Len(); i++) {
            var ast.Field* owner = open.Get(i).0;
            var str id = "";
            if(owner{ast.Decl*} != null) {
                id = Canonical::Decl(m, owner{ast.Decl*});
            } else {
                id = Canonical::Decl(m, m.Outer(owner)) + "::" + owner.name.value{str};
            }
            Dump::set(m, lines, "open " + id, open.Get(i).1);
        }
        Dump::set(m, lines, "function", m.FunctionTypes());
        Dump::set(m, lines, "thread", m.ThreadTypes());
        Dump::set(m, lines, "pointer", m.PointerTypes());
        Dump::set(m, lines, "tuple", m.TupleTypes());
        var ArrList[Model.Implementation*]* implementations = m.Implements();
        for(var uint i = 0U; i < implementations.Len(); i++) {
            lines.AddLast("implements " + Canonical::Text(m, implementations.Get(i).implementor) + " " + Canonical::Text(m, implementations.Get(i).iface));
        }
        return lines;
    }

    // set adds a line for each type of types, after prefix
    fun void(Model*, ArrList[str]*, str, TypeSet*) set = (m, lines, prefix, types) {
        if(types == null) {
            return;
        }
        for(var uint i = 0U; i < types.Len(); i++) {
            lines.AddLast(prefix + " " + Canonical::Text(m, types.Get(i)));
        }
    }
}
