import std("data/list/ArrList.zam");
import std("lang/Iter.zam");
import "../syntax/Source.zam";
import ast = "../syntax/ast/*";
import "Members.zam";
import "Model.zam";
import "Subtyping.zam";
import "Type.zam";

// CollectInterfaces records every interface each class, abstract and interface, and each ground instance of one, implements
public class CollectInterfaces {
    var Model* model;
    var Members* members;
    var ArrList[Type*]* implementors;
    var ArrList[Type*]* interfaces;

    // Run matches every implementor of the program m models against every interface, recording each it implements
    public static fun void(Model*) Run = (m) {
        var CollectInterfaces* c = new(CollectInterfaces);
        c.model = m;
        c.members = Members::New(m);
        c.implementors = ArrList::[Type*]New(0U);
        c.interfaces = ArrList::[Type*]New(0U);
        var Iter[(str, Source*)]* all = m.Program().sources.Iter();
        for(var ((str, Source*), bool) next = all.Next(); next.1; next = all.Next()) {
            if(next.0.1.file.decl != null) {
                c.collect(next.0.1.file.decl);
            }
        }
        var ArrList[Type*]* instances = m.Instances();
        for(var uint i = 0U; i < instances.Len(); i++) {
            var Type* t = instances.Get(i);
            var ast.Decl* d = Members::DeclOf(t);
            if(CollectInterfaces::inheritable(d)) {
                c.implementors.AddLast(t);
                if(d.kind == ast.Field.Kind::Interface) {
                    c.interfaces.AddLast(t);
                }
            }
        }
        var Subtyping* subtyping = Subtyping::New(m);
        for(var uint i = 0U; i < c.implementors.Len(); i++) {
            for(var uint j = 0U; j < c.interfaces.Len(); j++) {
                if(subtyping.implements(c.implementors.Get(i), c.interfaces.Get(j))) {
                    m.addImplementation(Model.Implementation::New(c.implementors.Get(i), c.interfaces.Get(j)));
                }
            }
        }
    }

    // collect gathers d, if a class, abstract or interface, and the declarations nested in it
    fun void(ast.Decl*) collect = (d) {
        if(CollectInterfaces::inheritable(d)) {
            var Type* self = this.members.SelfType(d);
            this.implementors.AddLast(self);
            if(d.kind == ast.Field.Kind::Interface && d.generics == null) {
                this.interfaces.AddLast(self);
            }
        }
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Decl* nested = d.fields.Get(i){ast.Decl*};
            if(nested != null) {
                this.collect(nested);
            }
        }
    }

    // inheritable reports whether d is a class, abstract or interface
    static fun bool(ast.Decl*) inheritable = (d) {
        return d != null && (d.kind == ast.Field.Kind::Class || d.kind == ast.Field.Kind::Abstract || d.kind == ast.Field.Kind::Interface);
    }
}
