import {
    std("data/list/ArrList.zam");
    std("lang/Err.zam");
    "../syntax/ProjectParser.zam";
    "Alias.zam";
    "AliasUse.zam";
    "CollectInterfaces.zam";
    "GenericCycle.zam";
    "InheritanceCycle.zam";
    "MemberCycle.zam";
    "Model.zam";
    "Monomorphize.zam";
    "Resolve.zam";
    "Static.zam";
}

// Semantic checks what a parsed program means
public namespace Semantic {
    // Validate runs the semantic passes over program in order
    public fun (Model*, ArrList[Err*]*)(ProjectParser.Program*) Validate = (program) {
        var Model* m = Model::New(program);
        var ArrList[Err*]* errs = Resolve::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = Alias::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = GenericCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = InheritanceCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = MemberCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = AliasUse::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = Static::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        Monomorphize::Run(m);
        CollectInterfaces::Run(m);
        return (m, errs);
    }
}
