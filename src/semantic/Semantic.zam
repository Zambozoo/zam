import std("data/list/ArrList.zam");
import std("lang/Err.zam");
import "../syntax/ProjectParser.zam";
import "Alias.zam";
import "AliasUse.zam";
import "GenericCycle.zam";
import "InheritanceCycle.zam";
import "MemberCycle.zam";
import "Model.zam";
import "Resolve.zam";

// Semantic checks what a parsed program means
public namespace Semantic {
    // Validate runs the semantic passes over program in order
    public fun (Model*, ArrList[Err*]*)(ProjectParser.Program*) Validate = (program) {
        var Model* m = Model::New(program);
        var ArrList[Err*]* errs = Resolve::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = Alias::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = GenericCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = InheritanceCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        errs = MemberCycle::Run(m);
        if(errs.Len() > 0U) {
            return (m, errs);
        }
        return (m, AliasUse::Run(m));
    }
}
