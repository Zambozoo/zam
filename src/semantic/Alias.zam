import {
    std("data/list/ArrList.zam");
    std("data/map/HashMap.zam");
    std("lang/Err.zam");
    std("lang/Iter.zam");
    std("lang/StrErr.zam");
    std("lang/Strs.zam");
    "../syntax/Source.zam";
    "../syntax/Token.zam";
    ast = "../syntax/ast/*";
    "Model.zam";
    "Type.zam";
}

// Alias replaces every alias written where a type is with the type the alias names
public class Alias <: ast.Walker* {
    // State is how far the type an alias names has been expanded
    enum State : uint {
        Unexpanded(0U),
        Expanding(1U),
        Expanded(2U);
    }

    var Model* model;
    var ArrList[Err*]* errs;
    // states is how far each alias's own type has been expanded
    var HashMap[ast.Decl.Alias*, State]* states;
    // stack is the aliases whose types are being expanded, outermost first
    var ArrList[ast.Decl.Alias*]* stack;
    // decl is the declaration being walked
    var ast.Decl* decl;

    // Run expands the aliases of the program m models
    public static fun ArrList[Err*]*(Model*) Run = (m) {
        var Alias* x = new(Alias);
        x.model = m;
        x.errs = ArrList::[Err*]New(0U);
        x.states = HashMap::[ast.Decl.Alias*, State]New(0U);
        x.stack = ArrList::[ast.Decl.Alias*]New(0U);

        var ArrList[ast.Decl.Alias*]* aliases = ArrList::[ast.Decl.Alias*]New(0U);
        var Iter[(str, Source*)]* all = m.Program().sources.Iter();
        for(var ((str, Source*), bool) next = all.Next(); next.1; next = all.Next()) {
            if(next.0.1.file.decl != null) {
                Alias::collect(next.0.1.file.decl, aliases);
            }
        }

        for(var uint i = 0U; i < aliases.Len(); i++) {
            x.checkParameters(aliases.Get(i));
        }
        if(x.errs.Len() > 0U) {
            return x.errs;
        }

        for(var uint i = 0U; i < aliases.Len(); i++) {
            x.expandAlias(aliases.Get(i));
        }
        if(x.errs.Len() > 0U) {
            return x.errs;
        }

        all = m.Program().sources.Iter();
        for(var ((str, Source*), bool) next = all.Next(); next.1; next = all.Next()) {
            x.VisitFile(next.0.1.file);
        }
        return x.errs;
    }

    // collect adds d, if an alias, and the aliases declared within it to aliases
    static fun void(ast.Decl*, ArrList[ast.Decl.Alias*]*) collect = (d, aliases) {
        if(d.kind == ast.Field.Kind::Alias) {
            aliases.AddLast(d{ast.Decl.Alias*});
        }
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Decl* nested = d.fields.Get(i){ast.Decl*};
            if(nested != null) {
                Alias::collect(nested, aliases);
            }
        }
    }

    fun void(ast.Decl*) VisitDecl = (d) {
        var ast.Decl* outer = this.decl;
        this.decl = d;
        super.VisitDecl(d);
        this.decl = outer;
    }

    // VisitDeclAlias expands the bounds of an alias's parameters
    fun void(ast.Decl.Alias*) VisitDeclAlias = (d) {
        if(d.generics == null) {
            return;
        }
        for(var uint i = 0U; i < d.generics.Len(); i++) {
            this.VisitGeneric(d.generics.Get(i));
        }
    }

    // VisitDeclObject requires the base of d be a pointer to a declaration
    fun void(ast.Decl.Object*) VisitDeclObject = (d) {
        super.VisitDeclObject(d);
        if(d.base == null) {
            return;
        }
        var Type* base = this.model.TypeOf(d.base);
        if(base == null) {
            return;
        }
        this.model.bindBase(d, base);
        if(base.kind == Type.Kind::Wrapped && base{Type.Wrapped*}.wrap == ast.Type.Wrap::Pointer) {
            var Type.Kind inner = base{Type.Wrapped*}.inner.kind;
            if(inner == Type.Kind::Named || inner == Type.Kind::Generic || inner == Type.Kind::Tailed) {
                return;
            }
        }
        this.fail(d, d.base.start, "base declaration type " + Strs::Quote(base.Text()) + " is not a pointer to a resolvable type");
    }

    fun void(ast.Type*) VisitType = (t) {
        this.expand(t, this.decl);
    }

    // checkParameters requires the type alias names use every parameter of alias
    fun void(ast.Decl.Alias*) checkParameters = (target) {
        if(target.generics == null) {
            return;
        }
        var ArrList[str]* used = ArrList::[str]New(0U);
        Alias::paramNames(this.model.Written(target.aliased), used);
        for(var uint i = 0U; i < target.generics.Len(); i++) {
            var str name = target.generics.Get(i).name.value{str};
            if(!Alias::holds(used, name)) {
                this.fail(target, target.name, "alias " + target.name.value{str} + " does not use its parameter " + name);
            }
        }
    }

    // expandAlias expands the type alias names
    fun bool(ast.Decl.Alias*) expandAlias = (target) {
        var (State, bool) state = this.states.Get(target);
        if(state.1 && state.0 == State::Expanded) {
            return true;
        } else if(state.1 && state.0 == State::Expanding) {
            var str names = "";
            var bool found = false;
            for(var uint i = 0U; i < this.stack.Len(); i++) {
                found = found || this.stack.Get(i) == target;
                if(found) {
                    names = names + this.stack.Get(i).name.value{str} + " -> ";
                }
            }
            this.fail(target, target.name, "alias " + target.name.value{str} + " refers to itself through " + names + target.name.value{str});
            return false;
        }

        this.states.Put(target, State::Expanding);
        this.stack.AddLast(target);
        this.expand(target.aliased, target);
        this.stack.RemoveLast();
        this.states.Put(target, State::Expanded);
        return true;
    }

    // expand answers what t names with every alias in it replaced
    fun Type*(ast.Type*, ast.Decl*) expand = (t, in) {
        if(t == null) {
            return null;
        }
        var Type* current = this.model.TypeOf(t);
        if(current == null) {
            return null;
        }
        switch(t.kind) {
            case (ast.Type.Kind::Wrapped) {
                var ast.Type* inner = t{ast.Type.Wrapped*}.inner;
                var Type* before = this.model.TypeOf(inner);
                var Type* after = this.expand(inner, in);
                if(after != null && after != before) {
                    return this.rebound(t, Type.Wrapped::New(current.at, current{Type.Wrapped*}.wrap, after));
                }
            }
            case (ast.Type.Kind::Array) {
                var ast.Type* inner = t{ast.Type.Array*}.inner;
                var Type* before = this.model.TypeOf(inner);
                var Type* after = this.expand(inner, in);
                if(after != null && after != before) {
                    var Type.Array* a = current{Type.Array*};
                    return this.rebound(t, Type.Array::New(current.at, after, a.sized, a.size));
                }
            }
            case (ast.Type.Kind::Tuple) {
                var (ArrList[Type*]*, bool) types = this.expandAll(t{ast.Type.Tuple*}.types, in);
                if(types.0 != null && types.1) {
                    return this.rebound(t, Type.Tuple::New(current.at, types.0));
                }
            }
            case (ast.Type.Kind::Function) {
                var ast.Type.Function* f = t{ast.Type.Function*};
                var Type* before = this.model.TypeOf(f.returns);
                var Type* returns = this.expand(f.returns, in);
                var (ArrList[Type*]*, bool) parameters = this.expandAll(f.parameters, in);
                if(returns != null && parameters.0 != null && (returns != before || parameters.1)) {
                    return this.rebound(t, Type.Function::New(current.at, returns, parameters.0));
                }
            }
            case (ast.Type.Kind::Reference) {
                if(Alias::aliasOf(current) != null) {
                    return this.use(t{ast.Type.Reference*}, ArrList::[Type*]New(0U), t, in);
                }
            }
            case (ast.Type.Kind::Generic) {
                var ast.Type.Generic* g = t{ast.Type.Generic*};
                var (ArrList[Type*]*, bool) arguments = this.expandAll(g.arguments, in);
                if(arguments.0 == null) {
                    return current;
                } else if(g.inner != null && g.inner.kind == ast.Type.Kind::Reference && Alias::aliasOf(this.model.TypeOf(g.inner)) != null) {
                    return this.use(g.inner{ast.Type.Reference*}, arguments.0, t, in);
                } else if(arguments.1) {
                    return this.rebound(t, Type.Generic::New(current.at, current{Type.Generic*}.inner, arguments.0));
                }
            }
        }
        return current;
    }

    // expandAll expands each of ts
    fun (ArrList[Type*]*, bool)(ArrList[ast.Type*]*, ast.Decl*) expandAll = (ts, in) {
        var ArrList[Type*]* expanded = ArrList::[Type*]New(0U);
        if(ts == null) {
            return (expanded, false);
        }
        var bool changed = false;
        var bool whole = true;
        for(var uint i = 0U; i < ts.Len(); i++) {
            var Type* before = this.model.TypeOf(ts.Get(i));
            var Type* after = this.expand(ts.Get(i), in);
            whole = whole && after != null;
            changed = changed || after != before;
            expanded.AddLast(after);
        }
        if(!whole) {
            return (null, false);
        }
        return (expanded, changed);
    }

    // use answers what the alias reference names given arguments
    fun Type*(ast.Type.Reference*, ArrList[Type*]*, ast.Type*, ast.Decl*) use = (reference, arguments, written, in) {
        var Type* current = this.model.TypeOf(written);
        var ast.Decl.Alias* target = Alias::aliasOf(this.model.TypeOf(reference));
        var uint arity = 0U;
        if(target.generics != null) {
            arity = target.generics.Len();
        }
        if(arguments.Len() != arity) {
            this.fail(in, reference.start, "alias " + target.name.value{str} + " takes " + arity{str} + " type arguments, but " + arguments.Len(){str} + " were provided");
            return current;
        } else if(!this.expandAlias(target)) {
            return current;
        }
        var Type* named = this.model.TypeOf(target.aliased);
        if(named == null) {
            return current;
        }

        var HashMap[ast.Generic*, Type*]* bindings = HashMap::[ast.Generic*, Type*]New(0U);
        for(var uint i = 0U; i < arity; i++) {
            bindings.Put(target.generics.Get(i), arguments.Get(i));
        }
        this.model.addUse(Model.Use::New(target, arguments, reference, in));
        return this.rebound(written, named.Instantiate(bindings, reference.start));
    }

    // rebound records t as resolving to expanded, and answers expanded
    fun Type*(ast.Type*, Type*) rebound = (t, expanded) {
        this.model.rebindType(t, expanded);
        return expanded;
    }

    // fail records msg as found at tok, written in d
    fun void(ast.Decl*, Token*, str) fail = (d, tok, msg) {
        this.errs.AddLast(this.model.At(d, tok, StrErr::New(msg)));
    }

    // aliasOf answers the alias t names, or null if it names none
    static fun ast.Decl.Alias*(Type*) aliasOf = (t) {
        if(t == null || t.kind != Type.Kind::Named) {
            return null;
        }
        var ast.Decl* d = t{Type.Named*}.decl;
        if(d.kind != ast.Field.Kind::Alias) {
            return null;
        }
        return d{ast.Decl.Alias*};
    }

    // paramNames adds to names the name of every generic parameter written in t
    static fun void(Type*, ArrList[str]*) paramNames = (t, names) {
        if(t == null) {
            return;
        }
        switch(t.kind) {
            case (Type.Kind::Wrapped)
                Alias::paramNames(t{Type.Wrapped*}.inner, names);
            case (Type.Kind::Array)
                Alias::paramNames(t{Type.Array*}.inner, names);
            case (Type.Kind::Tuple)
                Alias::allParamNames(t{Type.Tuple*}.types, names);
            case (Type.Kind::Function) {
                Alias::paramNames(t{Type.Function*}.returns, names);
                Alias::allParamNames(t{Type.Function*}.parameters, names);
            }
            case (Type.Kind::Generic)
                Alias::allParamNames(t{Type.Generic*}.arguments, names);
            case (Type.Kind::Param)
                names.AddLast(t{Type.Param*}.param.name.value{str});
        }
    }

    // allParamNames adds to names the name of every generic parameter written in ts
    static fun void(ArrList[Type*]*, ArrList[str]*) allParamNames = (ts, names) {
        for(var uint i = 0U; i < ts.Len(); i++) {
            Alias::paramNames(ts.Get(i), names);
        }
    }

    // holds reports whether names holds name
    static fun bool(ArrList[str]*, str) holds = (names, name) {
        for(var uint i = 0U; i < names.Len(); i++) {
            if(names.Get(i) == name) {
                return true;
            }
        }
        return false;
    }
}
