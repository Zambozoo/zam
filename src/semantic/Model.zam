import {
    std("data/list/ArrList.zam");
    std("data/map/HashMap.zam");
    std("lang/Arr.zam");
    std("lang/Err.zam");
    std("lang/Iter.zam");
    "../syntax/ProjectParser.zam";
    "../syntax/Source.zam";
    "../syntax/SourceErr.zam";
    "../syntax/Token.zam";
    ast = "../syntax/ast/*";
    "Type.zam";
    "TypeSet.zam";
}

// Model is what semantic analysis finds out about a program
public class Model {
    // Use is an alias written where a type is
    public class Use {
        // named is the alias written
        public var ast.Decl.Alias* named;
        // arguments is the types the alias is given, in parameter order
        public var ArrList[Type*]* arguments;
        // at is the reference the alias is written as
        public var ast.Type.Reference* at;
        // decl is the declaration the alias is written in
        public var ast.Decl* decl;

        public static fun Use*(ast.Decl.Alias*, ArrList[Type*]*, ast.Type.Reference*, ast.Decl*) New = (named, arguments, at, decl) {
            var Use* u = new(Use);
            u.named = named;
            u.arguments = arguments;
            u.at = at;
            u.decl = decl;
            return u;
        }
    }

    // MethodInstance is a generic static method given ground type arguments
    public class MethodInstance {
        public var ast.Field.Method* method;
        // owner is the declaration the method is declared in
        public var ast.Decl* owner;
        public var ArrList[Type*]* arguments;

        public static fun MethodInstance*(ast.Field.Method*, ast.Decl*, ArrList[Type*]*) New = (method, owner, arguments) {
            var MethodInstance* i = new(MethodInstance);
            i.method = method;
            i.owner = owner;
            i.arguments = arguments;
            return i;
        }
    }

    // Implementation is an implementor found to have every method an interface asks for
    public class Implementation {
        public var Type* implementor;
        public var Type* iface;

        public static fun Implementation*(Type*, Type*) New = (implementor, iface) {
            var Implementation* i = new(Implementation);
            i.implementor = implementor;
            i.iface = iface;
            return i;
        }
    }

    // Selection is the field a name selected out of a value stands for, and the type it comes to
    public class Selection {
        public var ast.Field* field;
        public var Type* signature;
    }

    // Binding is what a name written in a body stands for
    public class Binding {
        // Kind is where what a name stands for lies
        public enum Kind : int {
            // Local is a parameter or a variable a body declares
            Local(0),
            // Static is a static field of a declaration being checked or one enclosing it
            Static(1),
            // Instance is a field of the receiver, inherited ones among them
            Instance(2);
        }

        public var Kind kind;
        // bound is the type the name comes to
        public var Type* bound;
        // field is the field the name stands for, or null for a local
        public var ast.Field* field;
        // at is where the name is declared
        public var Token* at;

        public static fun Binding*(Kind, Type*, ast.Field*, Token*) New = (kind, bound, field, at) {
            var Binding* b = new(Binding);
            b.kind = kind;
            b.bound = bound;
            b.field = field;
            b.at = at;
            return b;
        }

        // IsMethod reports whether the name stands for a method
        public fun bool() IsMethod = () {
            if(this.field == null) {
                return this.kind == Kind::Instance;
            }
            return this.field.kind == ast.Field.Kind::Method;
        }
    }

    var ProjectParser.Program* program;
    // sources maps every declaration onto the file it is written in
    var HashMap[ast.Decl*, Source*]* sources;
    // outer maps every field onto the declaration it is written in
    var HashMap[ast.Field*, ast.Decl*]* outer;
    // types maps every type written onto what it resolves to, its aliases expanded
    var HashMap[ast.Type*, Type*]* types;
    // written maps every type whose aliases were expanded onto what it resolved to as written
    var HashMap[ast.Type*, Type*]* written;
    // imported maps every import onto the files it names
    var HashMap[ast.Import*, ArrList[Source*]*]* imported;
    // bases maps every class and abstract onto the type it extends
    var HashMap[ast.Decl*, Type*]* bases;
    // uses is every alias written where a type is
    var ArrList[Use*]* uses;
    // exprTypes maps every expression typed onto its type
    var HashMap[ast.Expr*, Type*]* exprTypes;
    // captures maps every lambda onto the locals it closes over, in the order first closed over
    var HashMap[ast.Expr.Lambda*, ArrList[str]*]* captures;
    // bindings maps every name written in a body onto what it stands for
    var HashMap[ast.Expr*, Binding*]* bindings;
    // selections maps every name selected out of a value as a field onto what it stands for
    var HashMap[Token*, Selection*]* selections;
    // paths maps every path typed onto the type after each of its names, its first name first
    var HashMap[ast.Expr.Path*, ArrList[Type*]*]* paths;
    // instances is every ground instantiation of a generic declaration the program can reach
    var ArrList[Type*]* instances;
    // methodInstances is every ground instantiation of a generic static method the program can reach
    var ArrList[MethodInstance*]* methodInstances;
    // openTypes maps every generic class, abstract and interface, and every generic method in one, onto the open types it names
    var HashMap[ast.Field*, TypeSet*]* openTypes;
    // functionTypes, threadTypes, pointerTypes and tupleTypes are every ground type of their kind the program can reach
    var TypeSet* functionTypes;
    var TypeSet* threadTypes;
    var TypeSet* pointerTypes;
    var TypeSet* tupleTypes;
    // implementations is every interface each class, abstract and interface, and each ground instance of one, implements
    var ArrList[Implementation*]* implementations;

    // New answers a model of program with nothing found out yet
    public static fun Model*(ProjectParser.Program*) New = (program) {
        var Model* m = new(Model);
        m.program = program;
        m.sources = HashMap::[ast.Decl*, Source*]New(0U);
        m.outer = HashMap::[ast.Field*, ast.Decl*]New(0U);
        m.types = HashMap::[ast.Type*, Type*]New(0U);
        m.written = HashMap::[ast.Type*, Type*]New(0U);
        m.imported = HashMap::[ast.Import*, ArrList[Source*]*]New(0U);
        m.selections = HashMap::[Token*, Selection*]New(0U);
        m.bases = HashMap::[ast.Decl*, Type*]New(0U);
        m.uses = ArrList::[Use*]New(0U);
        m.exprTypes = HashMap::[ast.Expr*, Type*]New(0U);
        m.captures = HashMap::[ast.Expr.Lambda*, ArrList[str]*]New(0U);
        m.bindings = HashMap::[ast.Expr*, Binding*]New(0U);
        m.paths = HashMap::[ast.Expr.Path*, ArrList[Type*]*]New(0U);
        m.instances = ArrList::[Type*]New(0U);
        m.methodInstances = ArrList::[MethodInstance*]New(0U);
        m.openTypes = HashMap::[ast.Field*, TypeSet*]New(0U);
        m.implementations = ArrList::[Implementation*]New(0U);
        var Iter[(str, Source*)]* all = program.sources.Iter();
        for(var ((str, Source*), bool) next = all.Next(); next.1; next = all.Next()) {
            var Source* s = next.0.1;
            if(s.file.decl != null) {
                m.declare(s, s.file.decl);
            }
            for(var uint i = 0U; i < s.imports.Len(); i++) {
                var Source.Resolved* r = s.imports.Get(i);
                var ArrList[Source*]* files = ArrList::[Source*]New(0U);
                for(var uint j = 0U; j < r.paths.Len(); j++) {
                    var (Source*, bool) file = program.sources.Get(r.paths.Get(j));
                    if(file.1) {
                        files.AddLast(file.0);
                    }
                }
                m.imported.Put(r.imported, files);
            }
        }
        return m;
    }

    // declare records d, and the fields and declarations within it, as written in s
    fun void(Source*, ast.Decl*) declare = (s, d) {
        this.sources.Put(d, s);
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Field* f = d.fields.Get(i);
            this.outer.Put(f, d);
            var ast.Decl* nested = f{ast.Decl*};
            if(nested != null) {
                this.declare(s, nested);
            }
        }
    }

    // Program answers the program modelled
    public fun ProjectParser.Program*() Program = () {
        return this.program;
    }

    // Source answers the file d is written in
    public fun Source*(ast.Decl*) Source = (d) {
        return this.sources.Get(d).0;
    }

    // Outer answers the declaration f is written in, or null for a file's own
    public fun ast.Decl*(ast.Field*) Outer = (f) {
        return this.outer.Get(f).0;
    }

    // Nested answers the declaration named name written in d, or null for none
    public fun ast.Decl*(ast.Decl*, str) Nested = (d, name) {
        for(var uint i = 0U; i < d.fields.Len(); i++) {
            var ast.Decl* nested = d.fields.Get(i){ast.Decl*};
            if(nested != null && nested.name != null && nested.name.value{str} == name) {
                return nested;
            }
        }
        return null;
    }

    // TypeOf answers what t resolves to, its aliases expanded
    public fun Type*(ast.Type*) TypeOf = (t) {
        return this.types.Get(t).0;
    }

    // Written answers what t resolves to as written, its aliases not expanded
    public fun Type*(ast.Type*) Written = (t) {
        var (Type*, bool) written = this.written.Get(t);
        if(written.1) {
            return written.0;
        }
        return this.types.Get(t).0;
    }

    // ExprType answers the type of e, or null if it has not been typed
    public fun Type*(ast.Expr*) ExprType = (e) {
        return this.exprTypes.Get(e).0;
    }

    // Captures answers the locals l closes over, in the order first closed over
    public fun ArrList[str]*(ast.Expr.Lambda*) Captures = (l) {
        var (ArrList[str]*, bool) names = this.captures.Get(l);
        if(!names.1) {
            return ArrList::[str]New(0U);
        }
        return names.0;
    }

    // Binding answers what the name written as e stands for, or null
    public fun Binding*(ast.Expr*) Binding = (e) {
        return this.bindings.Get(e).0;
    }

    // PathTypes answers the type after each name of p as far as it was typed, its first name first, or null
    public fun ArrList[Type*]*(ast.Expr.Path*) PathTypes = (p) {
        return this.paths.Get(p).0;
    }

    // ResolvedTypes answers what every type written resolves to
    public fun ArrList[Type*]*() ResolvedTypes = () {
        var ArrList[Type*]* all = ArrList::[Type*]New(0U);
        var Arr[(ast.Type*, Type*)]* entries = this.types.Arr();
        for(var uint i = 0U; i < entries.Len(); i++) {
            all.AddLast(entries.Get(i).1);
        }
        return all;
    }

    // Instances answers every ground instantiation of a generic declaration the program can reach
    public fun ArrList[Type*]*() Instances = () {
        return this.instances;
    }

    // MethodInstances answers every ground instantiation of a generic static method the program can reach
    public fun ArrList[MethodInstance*]*() MethodInstances = () {
        return this.methodInstances;
    }

    // OpenTypes answers the open types each generic template and method names
    public fun HashMap[ast.Field*, TypeSet*]*() OpenTypes = () {
        return this.openTypes;
    }

    public fun TypeSet*() FunctionTypes = () {
        return this.functionTypes;
    }

    public fun TypeSet*() ThreadTypes = () {
        return this.threadTypes;
    }

    public fun TypeSet*() PointerTypes = () {
        return this.pointerTypes;
    }

    public fun TypeSet*() TupleTypes = () {
        return this.tupleTypes;
    }

    // Implements answers every interface each class, abstract and interface, and each ground instance of one, implements
    public fun ArrList[Implementation*]*() Implements = () {
        return this.implementations;
    }

    // Uses answers every alias written where a type is
    public fun ArrList[Use*]*() Uses = () {
        return this.uses;
    }

    // Imported answers the files i names, or none for an import not resolved
    public fun ArrList[Source*]*(ast.Import*) Imported = (i) {
        var (ArrList[Source*]*, bool) files = this.imported.Get(i);
        if(!files.1) {
            return ArrList::[Source*]New(0U);
        }
        return files.0;
    }

    // Base answers the type d extends, or null for a declaration extending none
    public fun Type*(ast.Decl*) Base = (d) {
        return this.bases.Get(d).0;
    }

    // At answers err as found at tok in the file d is written in
    public fun Err*(ast.Decl*, Token*, Err*) At = (d, tok, err) {
        var Source* s = this.Source(d);
        return SourceErr::At(err, s.path, s.lineStarts, tok);
    }

    // bindType records t as resolving to resolved
    fun void(ast.Type*, Type*) bindType = (t, resolved) {
        this.types.Put(t, resolved);
    }

    // rebindType records t as resolving to expanded once its aliases are expanded
    fun void(ast.Type*, Type*) rebindType = (t, expanded) {
        if(!this.written.Contains(t)) {
            this.written.Put(t, this.types.Get(t).0);
        }
        this.types.Put(t, expanded);
    }

    // bindExpr records e as of type t
    fun void(ast.Expr*, Type*) bindExpr = (e, t) {
        this.exprTypes.Put(e, t);
    }

    // capture records l as closing over name, unless it already does
    fun void(ast.Expr.Lambda*, str) capture = (l, name) {
        var ArrList[str]* names = this.Captures(l);
        for(var uint i = 0U; i < names.Len(); i++) {
            if(names.Get(i) == name) {
                return;
            }
        }
        names.AddLast(name);
        this.captures.Put(l, names);
    }

    // Selected answers what the name written at tok, selected out of a value, stands for, or null
    public fun Selection*(Token*) Selected = (tok) {
        var (Selection*, bool) found = this.selections.Get(tok);
        if(!found.1) {
            return null;
        }
        return found.0;
    }

    // selectField records the name written at tok, selected out of a value, as standing for field, of type t
    fun void(Token*, ast.Field*, Type*) selectField = (tok, field, t) {
        if(!this.selections.Contains(tok)) {
            var Selection* s = new(Selection);
            s.field = field;
            s.signature = t;
            this.selections.Put(tok, s);
        }
    }

    // bindName records the name written as e as standing for b
    fun void(ast.Expr*, Binding*) bindName = (e, b) {
        this.bindings.Put(e, b);
    }

    fun void(Type*) addInstance = (t) {
        this.instances.AddLast(t);
    }

    fun void(MethodInstance*) addMethodInstance = (i) {
        this.methodInstances.AddLast(i);
    }

    // bindTypes records the open types of each template and method and the ground types of each kind
    fun void(HashMap[ast.Field*, TypeSet*]*, TypeSet*, TypeSet*, TypeSet*, TypeSet*) bindTypes = (open, functions, threads, pointers, tuples) {
        this.openTypes = open;
        this.functionTypes = functions;
        this.threadTypes = threads;
        this.pointerTypes = pointers;
        this.tupleTypes = tuples;
    }

    fun void(Implementation*) addImplementation = (i) {
        this.implementations.AddLast(i);
    }

    // bindPath records types as the type after each name of p
    fun void(ast.Expr.Path*, ArrList[Type*]*) bindPath = (p, types) {
        this.paths.Put(p, types);
    }

    // addUse records u as an alias written where a type is
    fun void(Use*) addUse = (u) {
        this.uses.AddLast(u);
    }

    // bindBase records d as extending base
    fun void(ast.Decl*, Type*) bindBase = (d, base) {
        this.bases.Put(d, base);
    }
}
