// Limits and special values of flt, an IEEE 754 double
public namespace Flts {
    // Max is the largest finite flt.
    public var flt$ Max = 1.7976931348623157e308;
    // Min is the smallest positive normal flt.
    public var flt$ Min = 2.2250738585072014e-308;
    // Epsilon is the gap between 1 and the next flt above it.
    public var flt$ Epsilon = 2.220446049250313e-16;
    public var flt$ Inf = type(Flts).FromBits(9218868437227405312U);
    public var flt$ NegInf = type(Flts).FromBits(18442240474082181120U);
    // NaN is a quiet NaN, which compares unequal to everything, itself too.
    public var flt$ NaN = type(Flts).FromBits(9221120237041090560U);

    // FromBits returns the flt whose IEEE 754 bits are u.
    public static fun flt(uint) FromBits = (u) {
        var flt f;
        native(STD_BITS_TO_FLT){void(uint, flt*)}(u, &f);
        return f;
    }

    // ToBits returns the IEEE 754 bits of f.
    public static fun uint(flt) ToBits = (f) {
        var uint u;
        native(STD_BITS_FROM_FLT){void(flt, uint*)}(f, &u);
        return u;
    }
}
