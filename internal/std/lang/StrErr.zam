public class StrErr {
    var str msg;

    public static fun StrErr*(str) New = (msg) {
        var StrErr* e = new(StrErr);
        e.Init(msg);
        return e;
    }

    public fun void(str) Init = (msg) {
        this.msg = msg;
    }

    public fun str() Str = () {
        return this.msg;
    }

    public fun str() Err = () {
        return this.msg;
    }
}
