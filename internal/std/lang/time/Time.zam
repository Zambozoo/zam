import "../Err.zam";
import "../Pair.zam";
import "../StrErr.zam";
import "../Strs.zam";
import "Duration.zam";

// Time is an instant, counted in nanoseconds from the Unix epoch, which
// reaches from 1677 to 2262, and read on the calendar in UTC. A Time from Now
// also carries a monotonic reading, which Sub and Since measure by when both
// sides have one, so that the wall clock being set does not skew them.
public struct Time {
    var int wall;
    var int mono;

    static fun int(int, int) floorDiv = (a, b) {
        var int q = a / b;
        if((a % b != 0) && ((a < 0) != (b < 0))) {
            q--;
        }
        return q;
    }

    static fun int(int, int) floorMod = (a, b) {
        return a - type(Time).floorDiv(a, b) * b;
    }

    // daysFrom is the day, counted from the epoch, of a proleptic Gregorian
    // date.
    static fun int(int, int, int) daysFrom = (year, month, day) {
        var int y = year;
        if(month <= 2) {
            y--;
        }
        var int era = type(Time).floorDiv(y, 400);
        var int yoe = y - era * 400;
        var int mp = month - 3;
        if(month <= 2) {
            mp = month + 9;
        }
        var int doy = (153 * mp + 2) / 5 + day - 1;
        var int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        return era * 146097 + doe - 719468;
    }

    // civil is the year, month and day of a day counted from the epoch.
    static fun int[3](int) civil = (days) {
        var int z = days + 719468;
        var int era = type(Time).floorDiv(z, 146097);
        var int doe = z - era * 146097;
        var int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        var int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        var int mp = (5 * doy + 2) / 153;
        var int[3] out;
        out[2] = doy - (153 * mp + 2) / 5 + 1;
        out[1] = mp + 3;
        if(mp >= 10) {
            out[1] = mp - 9;
        }
        out[0] = yoe + era * 400;
        if(out[1] <= 2) {
            out[0]++;
        }
        return out;
    }

    static fun Time(int) at = (wall) {
        var Time t;
        t.wall = wall;
        t.mono = 0;
        return t;
    }

    // Now is the current time.
    public static fun Time() Now = () {
        var Time t;
        native(STD_TIME_NOW){void(int*, int*)}(&(t.wall), &(t.mono));
        return t;
    }

    // FromUnix is the time sec seconds and nsec nanoseconds after the epoch.
    public static fun Time(int, int) FromUnix = (sec, nsec) {
        return type(Time).at(sec * 1000000000 + nsec);
    }

    public static fun Time(int) FromUnixMilli = (ms) {
        return type(Time).at(ms * 1000000);
    }

    public static fun Time(int) FromUnixNano = (ns) {
        return type(Time).at(ns);
    }

    // Date is the time of a date and time of day in UTC. Fields outside
    // their ranges carry into the next, so the 32nd of January is the 1st of
    // February.
    public static fun Time(int, int, int, int, int, int, int) Date = (year, month, day, hour, minute, second, nsec) {
        var int y = year + type(Time).floorDiv(month - 1, 12);
        var int m = type(Time).floorMod(month - 1, 12) + 1;
        var int days = type(Time).daysFrom(y, m, 1) + day - 1;
        return type(Time).at(((days * 24 + hour) * 60 + minute) * 60000000000 + second * 1000000000 + nsec);
    }

    // Since is how long ago t was.
    public static fun Duration(Time) Since = (t) {
        return type(Time).Now().Sub(t);
    }

    // Until is how long until t.
    public static fun Duration(Time) Until = (t) {
        return t.Sub(type(Time).Now());
    }

    public fun int() Unix = () {
        return type(Time).floorDiv(this.wall, 1000000000);
    }

    public fun int() UnixMilli = () {
        return type(Time).floorDiv(this.wall, 1000000);
    }

    public fun int() UnixNano = () {
        return this.wall;
    }

    public fun Time(Duration) Add = (d) {
        var Time t;
        t.wall = this.wall + d.InNanoseconds();
        t.mono = this.mono;
        if(this.mono != 0) {
            t.mono = this.mono + d.InNanoseconds();
        }
        return t;
    }

    // Sub is how long after o t is.
    public fun Duration(Time) Sub = (o) {
        if(this.mono != 0 && o.mono != 0) {
            return type(Duration).Nanoseconds(this.mono - o.mono);
        }
        return type(Duration).Nanoseconds(this.wall - o.wall);
    }

    // Cmp is -1, 0 or 1 as t is before, at or after o.
    public fun int(Time) Cmp = (o) {
        var int d = this.Sub(o).InNanoseconds();
        if(d < 0) {
            return -1;
        } else if(d > 0) {
            return 1;
        }
        return 0;
    }

    public fun bool(Time) Before = (o) {
        return this.Cmp(o) < 0;
    }

    public fun bool(Time) After = (o) {
        return this.Cmp(o) > 0;
    }

    public fun bool(Time) Equal = (o) {
        return this.Cmp(o) == 0;
    }

    fun int() days = () {
        return type(Time).floorDiv(this.wall, 86400000000000);
    }

    fun int() ofDay = () {
        return type(Time).floorMod(this.wall, 86400000000000);
    }

    public fun int() Year = () {
        var int[3] c = type(Time).civil(this.days());
        return c[0];
    }

    // Month is 1 for January through 12 for December.
    public fun int() Month = () {
        var int[3] c = type(Time).civil(this.days());
        return c[1];
    }

    public fun int() Day = () {
        var int[3] c = type(Time).civil(this.days());
        return c[2];
    }

    public fun int() Hour = () {
        return this.ofDay() / 3600000000000;
    }

    public fun int() Minute = () {
        return this.ofDay() / 60000000000 % 60;
    }

    public fun int() Second = () {
        return this.ofDay() / 1000000000 % 60;
    }

    public fun int() Nanosecond = () {
        return this.ofDay() % 1000000000;
    }

    // Weekday is 0 for Sunday through 6 for Saturday.
    public fun int() Weekday = () {
        return type(Time).floorMod(this.days() + 4, 7);
    }

    // YearDay is 1 for the 1st of January through 365 or 366.
    public fun int() YearDay = () {
        var int[3] c = type(Time).civil(this.days());
        return this.days() - type(Time).daysFrom(c[0], 1, 1) + 1;
    }

    static fun str(int, uint) pad = (n, width) {
        var str s = n{str};
        for(; type(Strs).ByteLen(s){uint} < width;) {
            s = "0" + s;
        }
        return s;
    }

    // Str writes t in RFC 3339 in UTC, with as many fractional digits as it
    // needs: 2006-01-02T15:04:05.5Z.
    public fun str() Str = () {
        var int[3] c = type(Time).civil(this.days());
        var str s = type(Time).pad(c[0], 4U) + "-" + type(Time).pad(c[1], 2U) + "-" + type(Time).pad(c[2], 2U) + "T" +
            type(Time).pad(this.Hour(), 2U) + ":" + type(Time).pad(this.Minute(), 2U) + ":" + type(Time).pad(this.Second(), 2U);
        var int ns = this.Nanosecond();
        if(ns != 0) {
            var str frac = type(Time).pad(ns, 9U);
            var Pair[byte*, int] b = type(Strs).ToBytes(frac);
            var int n = 9;
            for(; b.first[(n - 1){uint}] == '0'{byte};) {
                n--;
            }
            s = s + "." + type(Strs).FromBytes(b.first, n);
        }
        return s + "Z";
    }

    // digits reads count digits of b from at, or -1 where one is not a digit.
    static fun int(byte*, int, int) digits = (b, at, count) {
        var int v = 0;
        for(var int i = 0; i < count; i++) {
            var int c = b[(at + i){uint}]{int} - '0'{int};
            if(c < 0 || c > 9) {
                return -1;
            }
            v = v * 10 + c;
        }
        return v;
    }

    static fun int(int, int) monthDays = (year, month) {
        if(month == 2) {
            if((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) {
                return 29;
            }
            return 28;
        }
        if(month == 4 || month == 6 || month == 9 || month == 11) {
            return 30;
        }
        return 31;
    }

    // Parse reads a time in RFC 3339, such as 2006-01-02T15:04:05.5+07:00.
    public static fun Pair[Time, Err*](str) Parse = (s) {
        var Pair[Time, Err*] out;
        out.first = type(Time).at(0);
        out.second = type(StrErr).New("not an RFC 3339 time: " + s);
        var Pair[byte*, int] p = type(Strs).ToBytes(s);
        var byte* b = p.first;
        var int n = p.second;
        if(n < 20 || b[4] != '-'{byte} || b[7] != '-'{byte} || b[13] != ':'{byte} || b[16] != ':'{byte}) {
            return out;
        }
        if(b[10] != 'T'{byte} && b[10] != 't'{byte} && b[10] != ' '{byte}) {
            return out;
        }
        var int year = type(Time).digits(b, 0, 4);
        var int month = type(Time).digits(b, 5, 2);
        var int day = type(Time).digits(b, 8, 2);
        var int hour = type(Time).digits(b, 11, 2);
        var int minute = type(Time).digits(b, 14, 2);
        var int second = type(Time).digits(b, 17, 2);
        if(year < 0 || month < 1 || month > 12 || day < 1 || hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59) {
            return out;
        }
        if(day > type(Time).monthDays(year, month)) {
            return out;
        }
        var int at = 19;
        var int nsec = 0;
        if(b[19] == '.'{byte}) {
            at = 20;
            var int scale = 100000000;
            for(; at < n && b[at{uint}] >= '0'{byte} && b[at{uint}] <= '9'{byte}; at++) {
                nsec = nsec + (b[at{uint}]{int} - '0'{int}) * scale;
                scale = scale / 10;
            }
            if(at == 20) {
                return out;
            }
        }
        var int offset = 0;
        if(at == n - 1 && (b[at{uint}] == 'Z'{byte} || b[at{uint}] == 'z'{byte})) {
            offset = 0;
        } else if(at == n - 6 && (b[at{uint}] == '+'{byte} || b[at{uint}] == '-'{byte}) && b[(at + 3){uint}] == ':'{byte}) {
            var int oh = type(Time).digits(b, at + 1, 2);
            var int om = type(Time).digits(b, at + 4, 2);
            if(oh < 0 || oh > 23 || om < 0 || om > 59) {
                return out;
            }
            offset = (oh * 60 + om) * 60;
            if(b[at{uint}] == '-'{byte}) {
                offset = -offset;
            }
        } else {
            return out;
        }
        out.first = type(Time).Date(year, month, day, hour, minute, second - offset, nsec);
        out.second = null;
        return out;
    }
}
