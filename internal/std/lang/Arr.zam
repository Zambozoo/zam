import "Arrs.zam";
import "System.zam";

// Collected array that owns the run it wraps
public class Arr[A] {
    protected var A* arr;
    protected var uint len;

    public static fun[A] Arr[A]*(uint, A...) New = (count, args) {
        var Arr[A]* a = new(Arr[A]);
        a.Init(count, args...);
        return a;
    }

    public fun void(uint, A...) Init = (count, args) {
        this.len = count;
        this.arr = args;
    }

    public fun uint() Len = () {
        return this.len;
    }

    public fun A*() Arr = () {
        return this.arr;
    }

    public fun A(uint) Get = (i) {
        if(i >= this.len) {
            System::Panic("Arr out of bounds");
        }
        return this.arr[i];
    }

    public fun A(uint, A) Set = (i, t) {
        if(i >= this.len) {
            System::Panic("Arr out of bounds");
        }
        var A old = this.arr[i];
        this.arr[i] = t;
        return old;
    }

    public fun void() Delete = () {
        free(this.arr);
        this.arr = null;
        this.len = 0U;
    }

    public fun void() Mark = () {
        Arrs::[A]MarkAll(this.len, this.arr);
    }

    public fun str() Str = () {
        var str s = "[";
        var str spacer = "";
        for(var uint i = 0U; i < this.len; i++) {
            s = s + spacer + this.arr[i]{str};
            spacer = ", ";
        }
        return s + "]";
    }
}
