import "System.zam";

// Collected array that owns the run it wraps
class Arr[A] {
    var A* arr;
    var uint len;

    static fun[A] Arr[A]*(uint, A...) New = (count, args) {
        var Arr[A]* a = new(Arr[A]);
        a.Init(count, args...);
        return a;
    }

    fun void(uint, A...) Init = (count, args) {
        this.len = count;
        this.arr = args;
    }

    fun uint() Len = () {
        return this.len;
    }

    fun A*() Arr = () {
        return this.arr;
    }

    fun A(uint) Get = (i) {
        if(i >= this.len) {
            type(System).Panic("Arr out of bounds");
        }
        return this.arr[i];
    }

    fun A(uint, A) Set = (i, t) {
        if(i >= this.len) {
            type(System).Panic("Arr out of bounds");
        }
        var A old = this.arr[i];
        this.arr[i] = t;
        return old;
    }

    fun void() Delete = () {
        free(this.arr);
        this.arr = null;
        this.len = 0U;
    }

    fun void() Mark = () {
        for(var uint i = 0U; i < this.len; i++) {
            mark(this.arr[i]);
        }
    }

    fun str() Str = () {
        var str s = "[";
        var str spacer = "";
        for(var uint i = 0U; i < this.len; i++) {
            s = s + spacer + this.arr[i]{str};
            spacer = ", ";
        }
        return s + "]";
    }
}
