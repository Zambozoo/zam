import {
    "../io/local/File.zam";
    "Strs.zam";
}

public namespace System {
    public fun void(int) Exit = (code) {
        native(STD_SYSTEM_EXIT){void(int)}(code);
    }

    // Panic writes s and where the program is to stderr, and ends it.
    public fun void(str) Panic = (s) {
        File::StdErr.WriteStr(s);
        System::Trace();
        native(STD_SYSTEM_FAILED){void(str)}(s);
        System::Exit(-1);
    }

    public fun void(str, any...) Panicf = (fmt, args) {
        var str s = Strs::Sprintf(fmt, args);
        File::StdErr.WriteStr(s);
        System::Trace();
        native(STD_SYSTEM_FAILED){void(str)}(s);
        System::Exit(-1);
    }

    // Trace writes where the calling thread is to stderr, a line per call it is
    // inside of, starting with the method calling Trace.
    public fun void() Trace = () {
        native(STD_SYSTEM_TRACE){void()}();
    }

    // Caller answers the file and line skip calls out from the method calling
    // Caller: that method's own line at 0, the line that called it at 1, and so
    // on. The last element says whether there was such a call, and a line the
    // program does not know the source of.
    public fun (str, uint, bool)(uint) Caller = (skip) {
        var (str, uint, bool) caller;
        native(STD_SYSTEM_CALLER){void(uint, str*, uint*, bool*)}(skip, &(caller.0), &(caller.1), &(caller.2));
        return caller;
    }

    // ProcessID reports the OS-level id of this process, which is what
    // Signal.Send takes.
    public fun uint() ProcessID = () {
        var uint id;
        native(STD_SYSTEM_PROCESS_ID){void(uint*)}(&id);
        return id;
    }

    // ThreadID reports the OS-level id of the calling thread as the raw bits
    // of its pthread_t, which is what Signal.ThreadSend takes.
    public fun uint() ThreadID = () {
        var uint id;
        native(STD_SYSTEM_THREAD_ID){void(uint*)}(&id);
        return id;
    }

    public namespace GC {
        public fun void() Block = () {
            native(STD_GC_BLOCK){void()}();
        }

        public fun void() Unblock = () {
            native(STD_GC_UNBLOCK){void()}();
        }

        // Minor collects the young generation before the caller's next
        // instruction, or the whole heap if it has grown to its threshold.
        public fun void() Minor = () {
            native(STD_GC_MINOR){void()}();
        }

        // Major collects the whole heap before the caller's next instruction,
        // running every Delete of what has become unreachable.
        public fun void() Major = () {
            native(STD_GC_MAJOR){void()}();
        }

        // Markable reports whether a value of t holds anything the collector
        // must visit, so that a Mark override can skip what holds nothing.
        public fun bool(type) Markable = (t) {
            var bool m;
            native(STD_GC_MARKABLE){void(type, bool*)}(t, &m);
            return m;
        }
    }

    public enum Endian {
        BigEndian,
        LittleEndian;

        private static var uint one = 1U;

        public static fun Endian() Endianness = () {
            var byte* bytes = (&one){uint}{void*}{byte*};
            return bytes[0]{int} == 1 ? Endian::LittleEndian : Endian::BigEndian;
        }

        public fun str() Str = () {
            return *this == Endian::BigEndian ? "BigEndian" : "LittleEndian";
        }
    }

    // Signal names each POSIX signal the standard library exposes, each backed
    // by the OS-level number resolved at startup, since the same name maps to
    // different numbers across OSes (SIGUSR1 is 10 on Linux, 30 on macOS).
    // Using the enum closes the surface so a program cannot ask the kernel
    // about a signal the kernel does not have.
    //
    // Each value's index is its position in stdSignalInit's table; keep the
    // two in step.
    public enum Signal : byte {
        SIGHUP(sig(0)),
        SIGINT(sig(1)),
        SIGQUIT(sig(2)),
        SIGILL(sig(3)),
        SIGABRT(sig(4)),
        SIGFPE(sig(5)),
        SIGKILL(sig(6)),
        SIGSEGV(sig(7)),
        SIGPIPE(sig(8)),
        SIGALRM(sig(9)),
        SIGTERM(sig(10)),
        SIGSTOP(sig(11)),
        SIGCONT(sig(12)),
        SIGCHLD(sig(13)),
        SIGUSR1(sig(14)),
        SIGUSR2(sig(15));

        // sig resolves the OS-level number of the signal at idx in the
        // native's index table.
        private static fun byte(int) sig = (idx) {
            var int os;
            native(STD_SIGNAL_INIT){void(int, int*)}(idx, &os);
            return os{byte};
        }

        // Raise this signal on the current process. The OS default fires
        // unless Handle was called first.
        public fun void() Raise = () {
            native(STD_SIGNAL_RAISE){void(int)}((*this){int});
        }

        // Send this signal to another process. Maps to kill(pid, sig).
        public fun void(uint) Send = (pid) {
            native(STD_SIGNAL_SEND){void(int, uint)}((*this){int}, pid);
        }

        // Send this signal to another thread of this process by its OS
        // thread id (the raw bits of pthread_t). Maps to pthread_kill.
        public fun void(uint) ThreadSend = (threadID) {
            native(STD_SIGNAL_THREAD_SEND){void(int, uint)}((*this){int}, threadID);
        }

        // Register f as this signal's handler on the calling thread. The
        // closure runs between instructions after the C handler flagged a
        // delivery; see pollSignalHandlers in run.c.
        public fun void(void()) Handle = (f) {
            native(STD_SIGNAL_HANDLE){void(int, void())}((*this){int}, f);
        }

        // Add this signal to the process-wide signal mask so it is held
        // pending for every thread until Unblock.
        public fun void() Block = () {
            native(STD_SIGNAL_BLOCK){void(int)}((*this){int});
        }

        // Remove this signal from the process-wide mask. Pending deliveries
        // fire now.
        public fun void() Unblock = () {
            native(STD_SIGNAL_UNBLOCK){void(int)}((*this){int});
        }

        // Add this signal to the calling thread's own mask.
        public fun void() ThreadBlock = () {
            native(STD_SIGNAL_THREAD_BLOCK){void(int)}((*this){int});
        }

        // Remove this signal from the calling thread's own mask.
        public fun void() ThreadUnblock = () {
            native(STD_SIGNAL_THREAD_UNBLOCK){void(int)}((*this){int});
        }

        // Report whether this signal is in the process-wide mask right now.
        public fun bool() IsBlocked = () {
            var bool blocked;
            native(STD_SIGNAL_IS_BLOCKED){void(int, bool*)}((*this){int}, &blocked);
            return blocked;
        }

        // Report whether this signal is in the calling thread's own mask.
        public fun bool() IsThreadBlocked = () {
            var bool blocked;
            native(STD_SIGNAL_IS_THREAD_BLOCKED){void(int, bool*)}((*this){int}, &blocked);
            return blocked;
        }
    }
}
