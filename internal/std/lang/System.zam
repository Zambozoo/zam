import "../io/local/File.zam";
import "Strs.zam";

namespace System {
    fun void(int) Exit = (code) {
        native(STD_SYSTEM_EXIT){void(int)}(code);
    }

    fun void(str) Panic = (s) {
        type(File).StdErr.WriteStr(s);
        type(System).Exit(-1);
    }

    fun void(str, any...) Panicf = (fmt, args) {
        var str s = type(Strs).Sprintf(fmt, args);
        type(File).StdErr.WriteStr(s);
        type(System).Exit(-1);
    }

    // ProcessID reports the OS-level id of this process, which is what
    // Signal.Send takes.
    fun uint() ProcessID = () {
        var uint id;
        native(STD_SYSTEM_PROCESS_ID){void(uint*)}(&id);
        return id;
    }

    // ThreadID reports the OS-level id of the calling thread as the raw bits
    // of its pthread_t, which is what Signal.ThreadSend takes.
    fun uint() ThreadID = () {
        var uint id;
        native(STD_SYSTEM_THREAD_ID){void(uint*)}(&id);
        return id;
    }

    namespace GC {
        fun void() Block = () {
            native(STD_GC_BLOCK){void()}();
        }

        fun void() Unblock = () {
            native(STD_GC_UNBLOCK){void()}();
        }
    }

    enum Endian {
        BigEndian,
        LittleEndian;

        private static var uint one = 1U;

        static fun Endian() Endianness = () {
            var byte* bytes = (&one){uint}{void*}{byte*};
            return bytes[0]{int} == 1 ? type(Endian).LittleEndian : type(Endian).BigEndian;
        }

        fun str() Str = () {
            return *this == type(Endian).BigEndian ? "BigEndian" : "LittleEndian";
        }
    }

    // Signal names each POSIX signal the standard library exposes, each backed
    // by the OS-level number resolved at startup, since the same name maps to
    // different numbers across OSes (SIGUSR1 is 10 on Linux, 30 on macOS).
    // Using the enum closes the surface so a program cannot ask the kernel
    // about a signal the kernel does not have.
    //
    // Each value's index is its position in stdSignalInit's table; keep the
    // two in step.
    enum Signal : byte {
        SIGHUP(sig(0)),
        SIGINT(sig(1)),
        SIGQUIT(sig(2)),
        SIGILL(sig(3)),
        SIGABRT(sig(4)),
        SIGFPE(sig(5)),
        SIGKILL(sig(6)),
        SIGSEGV(sig(7)),
        SIGPIPE(sig(8)),
        SIGALRM(sig(9)),
        SIGTERM(sig(10)),
        SIGSTOP(sig(11)),
        SIGCONT(sig(12)),
        SIGCHLD(sig(13)),
        SIGUSR1(sig(14)),
        SIGUSR2(sig(15));

        // sig resolves the OS-level number of the signal at idx in the
        // native's index table.
        private static fun byte(int) sig = (idx) {
            var int os;
            native(STD_SIGNAL_INIT){void(int, int*)}(idx, &os);
            return os{byte};
        }

        // Raise this signal on the current process. The OS default fires
        // unless Handle was called first.
        fun void() Raise = () {
            native(STD_SIGNAL_RAISE){void(int)}((*this){int});
        }

        // Send this signal to another process. Maps to kill(pid, sig).
        fun void(uint) Send = (pid) {
            native(STD_SIGNAL_SEND){void(int, uint)}((*this){int}, pid);
        }

        // Send this signal to another thread of this process by its OS
        // thread id (the raw bits of pthread_t). Maps to pthread_kill.
        fun void(uint) ThreadSend = (threadID) {
            native(STD_SIGNAL_THREAD_SEND){void(int, uint)}((*this){int}, threadID);
        }

        // Register f as this signal's handler on the calling thread. The
        // closure runs between instructions after the C handler flagged a
        // delivery; see pollSignalHandlers in run.c.
        fun void(void()) Handle = (f) {
            native(STD_SIGNAL_HANDLE){void(int, void())}((*this){int}, f);
        }

        // Add this signal to the process-wide signal mask so it is held
        // pending for every thread until Unblock.
        fun void() Block = () {
            native(STD_SIGNAL_BLOCK){void(int)}((*this){int});
        }

        // Remove this signal from the process-wide mask. Pending deliveries
        // fire now.
        fun void() Unblock = () {
            native(STD_SIGNAL_UNBLOCK){void(int)}((*this){int});
        }

        // Add this signal to the calling thread's own mask.
        fun void() ThreadBlock = () {
            native(STD_SIGNAL_THREAD_BLOCK){void(int)}((*this){int});
        }

        // Remove this signal from the calling thread's own mask.
        fun void() ThreadUnblock = () {
            native(STD_SIGNAL_THREAD_UNBLOCK){void(int)}((*this){int});
        }

        // Report whether this signal is in the process-wide mask right now.
        fun bool() IsBlocked = () {
            var bool blocked;
            native(STD_SIGNAL_IS_BLOCKED){void(int, bool*)}((*this){int}, &blocked);
            return blocked;
        }

        // Report whether this signal is in the calling thread's own mask.
        fun bool() IsThreadBlocked = () {
            var bool blocked;
            native(STD_SIGNAL_IS_THREAD_BLOCKED){void(int, bool*)}((*this){int}, &blocked);
            return blocked;
        }
    }
}
