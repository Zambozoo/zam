import "../../lang/System.zam";
import "../../lang/Arr.zam";

// Open-addressed hash set with linear probing
public class HashSet[A] {
    static var byte$ empty = 0{byte};
    static var byte$ full = 1{byte};
    static var byte$ removed = 2{byte};

    static var uint$ minCap = 8U;
    static var uint$ wordBits = 64U;
    // fibonacci is 2^64 divided by the golden ratio, which spreads hashes over
    // the high bits a slot index is taken from.
    static var uint$ fibonacci = 11400714819323198485U;
    // A rehash is due once more than loadNum/loadDen of the slots are used.
    static var uint$ loadNum = 3U;
    static var uint$ loadDen = 4U;

    var A* vals;
    var byte* states;
    var uint cap;
    var uint shift;
    var uint len;
    var uint used;

    public static fun[A] HashSet[A]*(uint, A...) New = (len, args) {
        var HashSet[A]* s = new(HashSet[A]);
        s.Init(len, args...);
        return s;
    }

    public fun void(uint, A...) Init = (len, args) {
        this.alloc(HashSet::minCap);
        for(var uint i = 0U; i < len; i++) {
            this.Add(args[i]);
        }
    }

    private fun void(uint) alloc = (cap) {
        this.vals = new(A, cap);
        this.states = new(byte, cap);
        this.cap = cap;
        this.shift = HashSet::wordBits;
        for(var uint c = cap; c > 1U; c = c >> 1U) {
            this.shift--;
        }
        this.len = 0U;
        this.used = 0U;
    }

    private fun uint(A) home = (v) {
        return ((#v){uint} * HashSet::fibonacci) >> this.shift;
    }

    private fun uint(uint) step = (i) {
        return (i + 1U) & (this.cap - 1U);
    }

    // find returns the slot holding v, or cap when v is absent.
    private fun uint(A) find = (v) {
        for(var uint i = this.home(v); this.states[i] != HashSet::empty; i = this.step(i)) {
            if(this.states[i] == HashSet::full && this.vals[i] == v) {
                return i;
            }
        }
        return this.cap;
    }

    // rehash moves every element into fresh arrays, which are filled while the
    // old ones are still the set's, so the collector reaches every element
    // throughout, and installed once they are full.
    private fun void() rehash = () {
        var uint newCap = HashSet::minCap;
        for(; newCap < (this.len + 1U) * 2U;) {
            newCap = newCap * 2U;
        }
        var uint shift = HashSet::wordBits;
        for(var uint c = newCap; c > 1U; c = c >> 1U) {
            shift--;
        }
        var A* vals = new(A, newCap);
        var byte* states = new(byte, newCap);
        for(var uint i = 0U; i < this.cap; i++) {
            if(this.states[i] == HashSet::full) {
                var uint j = ((#this.vals[i]){uint} * HashSet::fibonacci) >> shift;
                for(; states[j] == HashSet::full;) {
                    j = (j + 1U) & (newCap - 1U);
                }
                vals[j] = this.vals[i];
                states[j] = HashSet::full;
            }
        }
        var A* oldVals = this.vals;
        var byte* oldStates = this.states;
        this.vals = vals;
        this.states = states;
        this.cap = newCap;
        this.shift = shift;
        this.used = this.len;
        free(oldVals);
        free(oldStates);
    }

    private fun void(A) place = (v) {
        var uint i = this.home(v);
        for(; this.states[i] == HashSet::full;) {
            i = this.step(i);
        }
        if(this.states[i] == HashSet::empty) {
            this.used++;
        }
        this.states[i] = HashSet::full;
        this.vals[i] = v;
        this.len++;
    }

    public fun uint() Len = () {
        return this.len;
    }

    public fun bool(A) Contains = (v) {
        return this.find(v) != this.cap;
    }

    public fun bool(A) Add = (v) {
        if(this.find(v) != this.cap) {
            return false;
        }
        if((this.used + 1U) * HashSet::loadDen > this.cap * HashSet::loadNum) {
            this.rehash();
        }
        this.place(v);
        return true;
    }

    public fun bool(A) Remove = (v) {
        var uint i = this.find(v);
        if(i == this.cap) {
            return false;
        }
        this.states[i] = HashSet::removed;
        this.len--;
        return true;
    }

    public fun void() Clear = () {
        this.Delete();
        this.alloc(HashSet::minCap);
    }

    public fun Arr[A]*() Arr = () {
        var A* a = new(A, this.len);
        var uint n = 0U;
        for(var uint i = 0U; i < this.cap; i++) {
            if(this.states[i] == HashSet::full) {
                a[n] = this.vals[i];
                n++;
            }
        }
        return Arr::[A]New(this.len, a...);
    }

    public fun Iter[A]*() Iter = () {
        var Iter[A]* i = new(Iter[A]);
        i.Init(this);
        return i;
    }

    public fun str() Str = () {
        var str s = "{";
        var str spacer = "";
        for(var uint i = 0U; i < this.cap; i++) {
            if(this.states[i] == HashSet::full) {
                s = s + spacer + this.vals[i]{str};
                spacer = ", ";
            }
        }
        return s + "}";
    }

    public fun void() Delete = () {
        free(this.vals);
        free(this.states);
        this.vals = null;
        this.states = null;
        this.cap = 0U;
        this.len = 0U;
        this.used = 0U;
    }

    public fun void() Mark = () {
        if(!System.GC::Markable(@{A})) {
            return;
        }
        for(var uint i = 0U; i < this.cap; i++) {
            if(this.states[i] == HashSet::full) {
                mark(this.vals[i]);
            }
        }
    }

    private class Iter[A] {
        var HashSet[A]* s;
        var uint i;

        public fun void(HashSet[A]*) Init = (s) {
            this.s = s;
            this.i = 0U;
        }

        public fun (A, bool)() Next = () {
            var (A, bool) p;
            for(; this.i < this.s.cap; this.i++) {
                if(this.s.states[this.i] == HashSet::full) {
                    p.0 = this.s.vals[this.i];
                    p.1 = true;
                    this.i++;
                    return p;
                }
            }
            p.1 = false;
            return p;
        }

        public fun (A, bool)() Prev = () {
            var (A, bool) p;
            for(; this.i > 0U;) {
                this.i--;
                if(this.s.states[this.i] == HashSet::full) {
                    p.0 = this.s.vals[this.i];
                    p.1 = true;
                    return p;
                }
            }
            p.1 = false;
            return p;
        }
    }
}
