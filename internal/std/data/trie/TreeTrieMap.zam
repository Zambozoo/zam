import "../../lang/System.zam";
import "../../lang/Arr.zam";
import "../../lang/Struct.zam";
import "../list/ArrList.zam";
import "../map/TreeMap.zam";

// Ordered radix trie map from runs of A to B, each node keeping its children in
// a tree map keyed by the first element of their edges
public class TreeTrieMap[A, B] {
    struct Node[A, B] {
        var A* edge;
        var uint edgeLen;
        var bool hasValue;
        var B val;
        var TreeMap[A, Node[A, B]*]* children;
    }

    var uint len;
    var Node[A, B]* root;

    public static fun[A, B] TreeTrieMap[A, B]*() New = () {
        var TreeTrieMap[A, B]* t = new(TreeTrieMap[A, B]);
        t.Init();
        return t;
    }

    public fun void() Init = () {
        this.len = 0U;
        this.root = new(Node[A, B]);
    }

    // markTree marks everything the subtree at n holds: edges, values and
    // the child maps, which nothing but the nodes refers to.
    private static fun[A, B] void(Node[A, B]*) markTree = (n) {
        if(n == null) {
            return;
        }
        for(var uint i = 0U; i < n.edgeLen; i++) {
            mark(n.edge[i]);
        }
        if(n.hasValue) {
            mark(n.val);
        }
        if(n.children != null) {
            mark(n.children);
            n.children.EachValue(TreeTrieMap::[A, B]markTree);
        }
    }

    private static fun[A, B] void(Node[A, B]*) freeTree = (n) {
        if(n.children != null) {
            n.children.EachValue(TreeTrieMap::[A, B]freeTree);
            n.children.Delete();
        }
        free(n.edge);
        free(n);
    }

    private fun A*(A*, uint, uint) copyRun = (key, start, n) {
        if(n == 0U) {
            return null;
        }
        var A* a = new(A, n);
        for(var uint i = 0U; i < n; i++) {
            a[i] = key[start + i];
        }
        return a;
    }

    private fun Node[A, B]*(A*, uint, uint) newNode = (key, start, n) {
        var Node[A, B]* m = new(Node[A, B]);
        m.edge = this.copyRun(key, start, n);
        m.edgeLen = n;
        return m;
    }

    private fun Node[A, B]*(Node[A, B]*, A) childFor = (n, a) {
        if(n.children == null) {
            return null;
        }
        var (Node[A, B]*, bool) p = n.children.Get(a);
        if(!p.1) {
            return null;
        }
        return p.0;
    }

    // setChild and the removal of a child run with collection blocked: Mark
    // reaches the trie's nodes through the child maps, and a tree map rotating
    // has nodes only its own pins can reach.
    private fun void(Node[A, B]*, A, Node[A, B]*) setChild = (n, a, c) {
        if(n.children == null) {
            n.children = TreeMap::[A, Node[A, B]*]New(0U);
        }
        System.GC::Block();
        n.children.Put(a, c);
        System.GC::Unblock();
    }

    private fun uint(Node[A, B]*) childCount = (n) {
        if(n.children == null) {
            return 0U;
        }
        return n.children.Len();
    }

    // common counts how many of n's edge elements match key from i.
    private fun uint(Node[A, B]*, uint, A*, uint) common = (n, len, key, i) {
        var uint p = 0U;
        for(; p < n.edgeLen && i + p < len && n.edge[p] == key[i + p];) {
            p++;
        }
        return p;
    }

    // locate walks key and returns the node it ends at, or null. With prefix,
    // a key that ends partway along an edge ends at the node below it.
    private fun Node[A, B]*(uint, A*, bool) locate = (len, key, prefix) {
        var Node[A, B]* n = this.root;
        for(var uint i = 0U; i < len;) {
            var Node[A, B]* c = this.childFor(n, key[i]);
            if(c == null) {
                return null;
            }
            var uint p = this.common(c, len, key, i);
            if(p < c.edgeLen) {
                if(prefix && i + p == len) {
                    return c;
                }
                return null;
            }
            n = c;
            i = i + p;
        }
        return n;
    }

    // mergeDown replaces n, which holds no value and one child, with that
    // child under the child's edge extended by n's. A detached node's child
    // map is left to the collector, which may already have reclaimed it.
    private fun void(Node[A, B]*, Node[A, B]*) mergeDown = (parent, n) {
        var Node[A, B]* c = n.children.Arr().Get(0U).1;
        var uint total = n.edgeLen + c.edgeLen;
        var A* joined = new(A, total);
        for(var uint i = 0U; i < n.edgeLen; i++) {
            joined[i] = n.edge[i];
        }
        for(var uint i = 0U; i < c.edgeLen; i++) {
            joined[n.edgeLen + i] = c.edge[i];
        }
        var A* old = c.edge;
        c.edge = joined;
        c.edgeLen = total;
        free(old);
        this.setChild(parent, joined[0], c);
        free(n.edge);
        free(n);
    }

    // collect appends the entries of the subtree at n to out from index i, the
    // key so far standing in buf, and returns the index after the last.
    private fun uint(Node[A, B]*, ArrList[A]*, (Arr[A]*, B)*, uint) collect = (n, buf, out, i) {
        for(var uint j = 0U; j < n.edgeLen; j++) {
            buf.AddLast(n.edge[j]);
        }
        if(n.hasValue) {
            out[i].0 = buf.Arr();
            out[i].1 = n.val;
            i++;
        }
        if(n.children != null) {
            var Arr[(A, Node[A, B]*)]* kids = n.children.Arr();
            for(var uint j = 0U; j < kids.Len(); j++) {
                i = this.collect(kids.Get(j).1, buf, out, i);
            }
        }
        for(var uint j = 0U; j < n.edgeLen; j++) {
            buf.RemoveLast();
        }
        return i;
    }

    public fun uint() Len = () {
        return this.len;
    }

    public fun bool(uint, A*) Contains = (len, key) {
        var Node[A, B]* n = this.locate(len, key, false);
        return n != null && n.hasValue;
    }

    // HasPrefix reports whether some key begins with the given run.
    public fun bool(uint, A*) HasPrefix = (len, key) {
        if(len == 0U) {
            return this.len > 0U;
        }
        return this.locate(len, key, true) != null;
    }

    public fun (B, bool)(uint, A*) Get = (len, key) {
        var (B, bool) p;
        var Node[A, B]* n = this.locate(len, key, false);
        if(n == null || !n.hasValue) {
            p.1 = false;
            return p;
        }
        p.0 = n.val;
        p.1 = true;
        return p;
    }

    // Put sets the value of key, reporting whether the key is new. A new node
    // and a node split off an edge are pinned until they are linked in.
    public fun bool(uint, A*, B) Put = (len, key, v) {
        var Node[A, B]* n = this.root;
        var uint i = 0U;
        for(;;) {
            if(i == len) {
                var bool added = !n.hasValue;
                n.val = v;
                n.hasValue = true;
                if(added) {
                    this.len++;
                }
                return added;
            }
            var Node[A, B]* c = this.childFor(n, key[i]);
            if(c == null) {
                var Node[A, B]* leaf = this.newNode(key, i, len - i);
                var Struct[Node[A, B]*] pin;
                pin.Init(leaf, TreeTrieMap::[A, B]markTree, null);
                leaf.val = v;
                leaf.hasValue = true;
                this.setChild(n, key[i], leaf);
                pin.s = null;
                this.len++;
                return true;
            }
            var uint p = this.common(c, len, key, i);
            if(p < c.edgeLen) {
                var Node[A, B]* mid = this.newNode(c.edge, 0U, p);
                var Struct[Node[A, B]*] pin;
                pin.Init(mid, TreeTrieMap::[A, B]markTree, null);
                var A* rest = this.copyRun(c.edge, p, c.edgeLen - p);
                this.setChild(mid, rest[0], c);
                var A* old = c.edge;
                c.edge = rest;
                c.edgeLen = c.edgeLen - p;
                free(old);
                this.setChild(n, key[i], mid);
                pin.s = null;
                c = mid;
            }
            n = c;
            i = i + p;
        }
    }

    public fun (B, bool)(uint, A*) Remove = (len, key) {
        var (B, bool) out;
        out.1 = false;
        var Node[A, B]* grand = null;
        var Node[A, B]* parent = null;
        var Node[A, B]* n = this.root;
        for(var uint i = 0U; i < len;) {
            var Node[A, B]* c = this.childFor(n, key[i]);
            if(c == null) {
                return out;
            }
            var uint p = this.common(c, len, key, i);
            if(p < c.edgeLen) {
                return out;
            }
            grand = parent;
            parent = n;
            n = c;
            i = i + p;
        }
        if(!n.hasValue) {
            return out;
        }
        out.0 = n.val;
        out.1 = true;
        var B zero;
        n.val = zero;
        n.hasValue = false;
        this.len--;
        if(n == this.root) {
            return out;
        }

        if(this.childCount(n) == 0U) {
            System.GC::Block();
            parent.children.Remove(n.edge[0]);
            System.GC::Unblock();
            free(n.edge);
            free(n);
            n = parent;
            parent = grand;
            if(n == this.root || n.hasValue) {
                return out;
            }
        }
        if(this.childCount(n) == 1U && !n.hasValue) {
            this.mergeDown(parent, n);
        }
        return out;
    }

    public fun void() Clear = () {
        this.Delete();
        this.Init();
    }

    // Arr returns the entries, each key a fresh copy, in key order.
    public fun Arr[(Arr[A]*, B)]*() Arr = () {
        var (Arr[A]*, B)* a = new((Arr[A]*, B), this.len);
        var Arr[(Arr[A]*, B)]* out = Arr::[(Arr[A]*, B)]New(this.len, a...);
        var ArrList[A]* buf = ArrList::[A]New(0U);
        this.collect(this.root, buf, a, 0U);
        return out;
    }

    // Iter visits the entries as Arr does, as they stood when it was made.
    public fun Iter[A, B]*() Iter = () {
        var Iter[A, B]* i = new(Iter[A, B]);
        i.items = this.Arr();
        i.i = 0U;
        return i;
    }

    public fun str() Str = () {
        var Arr[(Arr[A]*, B)]* a = this.Arr();
        var str s = "{";
        var str spacer = "";
        for(var uint i = 0U; i < a.Len(); i++) {
            s = s + spacer + a.Get(i).0{str} + ": " + a.Get(i).1{str};
            spacer = ", ";
        }
        return s + "}";
    }

    // Delete detaches the trie and frees it with collection blocked: the child
    // maps are collected objects only the detached nodes still name.
    public fun void() Delete = () {
        var Node[A, B]* n = this.root;
        this.root = null;
        this.len = 0U;
        if(n != null) {
            System.GC::Block();
            TreeTrieMap::[A, B]freeTree(n);
            System.GC::Unblock();
        }
    }

    public fun void() Mark = () {
        TreeTrieMap::[A, B]markTree(this.root);
    }

    private class Iter[A, B] {
        var Arr[(Arr[A]*, B)]* items;
        var uint i;

        public fun ((Arr[A]*, B), bool)() Next = () {
            var ((Arr[A]*, B), bool) p;
            if(this.i >= this.items.Len()) {
                p.1 = false;
                return p;
            }
            p.0 = this.items.Get(this.i);
            p.1 = true;
            this.i++;
            return p;
        }

        public fun ((Arr[A]*, B), bool)() Prev = () {
            var ((Arr[A]*, B), bool) p;
            if(this.i == 0U) {
                p.1 = false;
                return p;
            }
            this.i--;
            p.0 = this.items.Get(this.i);
            p.1 = true;
            return p;
        }
    }
}
