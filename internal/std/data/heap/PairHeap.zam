import "../../lang/System.zam";
import "../../lang/Pair.zam";
import "../../lang/Arr.zam";
import "../../lang/Struct.zam";

// Meldable min max heap of twin pairing heaps sharing their nodes
class PairHeap[A] {
    static var uint$ minSide = 0U;
    static var uint$ maxSide = 1U;

    struct Node[A] {
        // Link is a node's place in one of the two trees. prev is the left
        // sibling, or the parent of a leftmost child.
        struct Link[A] {
            var Node[A]* child;
            var Node[A]* next;
            var Node[A]* prev;
        }
        var A val;
        var Link[A][2] links;
    }

    var uint len;
    var Node[A]*[2] roots;

    static fun[A] PairHeap[A]*(uint, A...) New = (len, args) {
        var PairHeap[A]* h = new(PairHeap[A]);
        h.Init(len, args...);
        return h;
    }

    fun void(uint, A...) Init = (len, args) {
        this.len = 0U;
        this.roots[0] = null;
        this.roots[1] = null;
        for(var uint i = 0U; i < len; i++) {
            this.Add(args[i]);
        }
    }

    // before reports whether a belongs above b in the tree for side s.
    private fun bool(Node[A]*, Node[A]*, uint) before = (a, b, s) {
        if(s == type(PairHeap).minSide) {
            return a.val < b.val;
        }
        return b.val < a.val;
    }

    // link makes the lesser of two detached roots a child of the other.
    private fun Node[A]*(Node[A]*, Node[A]*, uint) link = (a, b, s) {
        if(a == null) {
            return b;
        }
        if(b == null) {
            return a;
        }
        if(this.before(b, a, s)) {
            var Node[A]* t = a;
            a = b;
            b = t;
        }
        var Node[A]* first = a.links[s].child;
        b.links[s].prev = a;
        b.links[s].next = first;
        if(first != null) {
            first.links[s].prev = b;
        }
        a.links[s].child = b;
        return a;
    }

    // combine pairs the sibling list c left to right, then melds the pairs
    // right to left into the slot out. On the min side, the one the collector
    // walks, every list it holds is pinned by its head and every node in
    // transit by itself.
    private fun void(Node[A]*, uint, Node[A]**) combine = (c, s, out) {
        var void(Node[A]*) chain = null;
        var void(Node[A]*) tree = null;
        if(s == type(PairHeap).minSide) {
            chain = type(PairHeap)[A].markChain;
            tree = type(PairHeap)[A].markFrom;
        }
        var Struct[Node[A]*] rest;
        rest.Init(c, chain, null);
        var Struct[Node[A]*] pairs;
        pairs.Init(null, chain, null);
        var Struct[Node[A]*] pa;
        pa.Init(null, tree, null);
        var Struct[Node[A]*] pb;
        pb.Init(null, tree, null);
        for(; rest.s != null;) {
            var Node[A]* a = rest.s;
            var Node[A]* b = a.links[s].next;
            pa.s = a;
            pb.s = b;
            var Node[A]* after = null;
            if(b != null) {
                after = b.links[s].next;
            }
            rest.s = after;
            if(b != null) {
                b.links[s].next = null;
                b.links[s].prev = null;
            }
            a.links[s].next = null;
            a.links[s].prev = null;
            var Node[A]* m = this.link(a, b, s);
            m.links[s].next = pairs.s;
            pairs.s = m;
            pa.s = null;
            pb.s = null;
        }

        *out = null;
        for(; pairs.s != null;) {
            var Node[A]* q = pairs.s;
            pa.s = q;
            pairs.s = q.links[s].next;
            q.links[s].next = null;
            *out = this.link(*out, q, s);
            pa.s = null;
        }
    }

    // unlink takes n out of the tree for side s, melding its children back in.
    private fun void(Node[A]*, uint) unlink = (n, s) {
        var void(Node[A]*) tree = null;
        if(s == type(PairHeap).minSide) {
            tree = type(PairHeap)[A].markFrom;
        }
        var Struct[Node[A]*] kids;
        kids.Init(null, tree, null);
        this.combine(n.links[s].child, s, &(kids.s));
        n.links[s].child = null;
        if(this.roots[s] == n) {
            this.roots[s] = kids.s;
            kids.s = null;
            return;
        }
        var Node[A]* p = n.links[s].prev;
        var Node[A]* next = n.links[s].next;
        if(p.links[s].child == n) {
            p.links[s].child = next;
        } else {
            p.links[s].next = next;
        }
        if(next != null) {
            next.links[s].prev = p;
        }
        n.links[s].prev = null;
        n.links[s].next = null;
        this.roots[s] = this.link(this.roots[s], kids.s, s);
        kids.s = null;
    }

    private fun A(uint) removeRoot = (s) {
        var Node[A]* n = this.roots[s];
        var A v = n.val;
        this.unlink(n, s);
        this.unlink(n, 1U - s);
        free(n);
        this.len--;
        return v;
    }

    // markWalk marks the values of n and everything beneath it in the min
    // tree, and of the siblings that follow n when siblings is true, with a
    // stack of its own since a pairing tree can be as deep as it is large.
    private static fun[A] void(Node[A]*, bool) markWalk = (n, siblings) {
        if(n == null) {
            return;
        }
        var uint cap = 16U;
        var Node[A]** stack = new(Node[A]*, cap);
        var uint top = 0U;
        for(var Node[A]* c = n; c != null; c = c.links[0].next) {
            if(top == cap) {
                var Node[A]** grown = new(Node[A]*, cap * 2U);
                for(var uint i = 0U; i < top; i++) {
                    grown[i] = stack[i];
                }
                free(stack);
                stack = grown;
                cap = cap * 2U;
            }
            stack[top] = c;
            top++;
            if(!siblings) {
                break;
            }
        }
        for(; top > 0U;) {
            top--;
            var Node[A]* m = stack[top];
            mark(m.val);
            for(var Node[A]* c = m.links[0].child; c != null; c = c.links[0].next) {
                if(top == cap) {
                    var Node[A]** grown = new(Node[A]*, cap * 2U);
                    for(var uint i = 0U; i < top; i++) {
                        grown[i] = stack[i];
                    }
                    free(stack);
                    stack = grown;
                    cap = cap * 2U;
                }
                stack[top] = c;
                top++;
            }
        }
        free(stack);
    }

    // markFrom marks n and everything beneath it in the min tree.
    private static fun[A] void(Node[A]*) markFrom = (n) {
        type(PairHeap)[A].markWalk(n, false);
    }

    // markChain marks n, the siblings that follow it, and everything beneath
    // them in the min tree.
    private static fun[A] void(Node[A]*) markChain = (n) {
        type(PairHeap)[A].markWalk(n, true);
    }

    // nodes returns every node, which the caller frees.
    private fun Node[A]**() nodes = () {
        var Node[A]** out = new(Node[A]*, this.len + 1U);
        var Node[A]** stack = new(Node[A]*, this.len + 1U);
        var uint count = 0U;
        var uint top = 0U;
        if(this.roots[0] != null) {
            stack[0] = this.roots[0];
            top = 1U;
        }
        for(; top > 0U;) {
            top--;
            var Node[A]* n = stack[top];
            out[count] = n;
            count++;
            if(n.links[0].next != null) {
                stack[top] = n.links[0].next;
                top++;
            }
            if(n.links[0].child != null) {
                stack[top] = n.links[0].child;
                top++;
            }
        }
        free(stack);
        return out;
    }

    fun uint() Len = () {
        return this.len;
    }

    fun void(A) Add = (v) {
        var Node[A]* n = new(Node[A]);
        n.val = v;
        this.roots[0] = this.link(this.roots[0], n, 0U);
        this.roots[1] = this.link(this.roots[1], n, 1U);
        this.len++;
    }

    fun A() GetMin = () {
        if(this.len == 0U) {
            type(System).Panic("PairHeap is empty");
        }
        return this.roots[type(PairHeap).minSide].val;
    }

    fun A() GetMax = () {
        if(this.len == 0U) {
            type(System).Panic("PairHeap is empty");
        }
        return this.roots[type(PairHeap).maxSide].val;
    }

    fun A() RemoveMin = () {
        if(this.len == 0U) {
            type(System).Panic("PairHeap is empty");
        }
        return this.removeRoot(type(PairHeap).minSide);
    }

    fun A() RemoveMax = () {
        if(this.len == 0U) {
            type(System).Panic("PairHeap is empty");
        }
        return this.removeRoot(type(PairHeap).maxSide);
    }

    // Merge moves every element of other into this heap, leaving other empty.
    fun void(PairHeap[A]*) Merge = (other) {
        if(other{void*} == this{void*}) {
            type(System).Panic("PairHeap merged with itself");
        }
        this.roots[0] = this.link(this.roots[0], other.roots[0], 0U);
        this.roots[1] = this.link(this.roots[1], other.roots[1], 1U);
        this.len = this.len + other.len;
        other.roots[0] = null;
        other.roots[1] = null;
        other.len = 0U;
    }

    fun void() Clear = () {
        this.Delete();
    }

    // Arr returns the elements in no particular order.
    fun Arr[A]*() Arr = () {
        var Node[A]** ns = this.nodes();
        var A* a = new(A, this.len);
        for(var uint i = 0U; i < this.len; i++) {
            a[i] = ns[i].val;
        }
        free(ns);
        return type(Arr)[A].New(this.len, a...);
    }

    // Iter visits the elements in no particular order, as they stood when it
    // was made.
    fun Iter[A]*() Iter = () {
        var Iter[A]* i = new(Iter[A]);
        i.items = this.Arr();
        i.i = 0U;
        return i;
    }

    fun str() Str = () {
        return this.Arr(){str};
    }

    fun void() Delete = () {
        var Node[A]** ns = this.nodes();
        for(var uint i = 0U; i < this.len; i++) {
            free(ns[i]);
        }
        free(ns);
        this.roots[0] = null;
        this.roots[1] = null;
        this.len = 0U;
    }

    fun void() Mark = () {
        if(this.roots[0] != null) {
            type(PairHeap)[A].markFrom(this.roots[0]);
        }
    }

    private class Iter[A] {
        var Arr[A]* items;
        var uint i;

        fun Pair[A, bool]() Next = () {
            var Pair[A, bool] p;
            if(this.i >= this.items.Len()) {
                p.second = false;
                return p;
            }
            p.first = this.items.Get(this.i);
            p.second = true;
            this.i++;
            return p;
        }

        fun Pair[A, bool]() Prev = () {
            var Pair[A, bool] p;
            if(this.i == 0U) {
                p.second = false;
                return p;
            }
            this.i--;
            p.first = this.items.Get(this.i);
            p.second = true;
            return p;
        }
    }
}
