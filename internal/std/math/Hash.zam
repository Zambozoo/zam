import "../lang/Uints.zam";
import "../lang/Flts.zam";
import "../lang/Strs.zam";

// Non-cryptographic hashes over byte runs, and helpers for writing Hash
public namespace Hash {
    var uint$ xxPrime1 = 11400714785074694791U;
    var uint$ xxPrime2 = 14029467366897019727U;
    var uint$ xxPrime3 = 1609587929392839161U;
    var uint$ xxPrime4 = 9650029242287828579U;
    var uint$ xxPrime5 = 2870177450012600261U;
    var uint$ low32 = 4294967295U;

    // FNV1a returns the 64-bit FNV-1a hash of n bytes at b.
    public static fun uint(byte*, uint) FNV1a = (b, n) {
        var uint h = 14695981039346656037U;
        for(var uint i = 0U; i < n; i++) {
            h = (h ^ b[i]{uint}) * 1099511628211U;
        }
        return h;
    }

    private static fun uint(byte*, uint) read64 = (b, i) {
        var uint v = 0U;
        for(var uint j = 8U; j > 0U; j--) {
            v = (v << 8U) | b[i + j - 1U]{uint};
        }
        return v;
    }

    private static fun uint(byte*, uint) read32 = (b, i) {
        return b[i]{uint} | (b[i + 1U]{uint} << 8U) | (b[i + 2U]{uint} << 16U) | (b[i + 3U]{uint} << 24U);
    }

    private static fun uint(uint, uint) xxRound = (acc, v) {
        acc = acc + v * Hash::xxPrime2;
        return Uints::RotateLeft(acc, 31U) * Hash::xxPrime1;
    }

    private static fun uint(uint, uint) xxMerge = (acc, v) {
        acc = acc ^ Hash::xxRound(0U, v);
        return acc * Hash::xxPrime1 + Hash::xxPrime4;
    }

    // XXHash64 returns the 64-bit xxHash of n bytes at b under seed.
    public static fun uint(byte*, uint, uint) XXHash64 = (b, n, seed) {
        var uint i = 0U;
        var uint h;
        if(n >= 32U) {
            var uint v1 = seed + Hash::xxPrime1 + Hash::xxPrime2;
            var uint v2 = seed + Hash::xxPrime2;
            var uint v3 = seed;
            var uint v4 = seed - Hash::xxPrime1;
            for(; i + 32U <= n; i = i + 32U) {
                v1 = Hash::xxRound(v1, Hash::read64(b, i));
                v2 = Hash::xxRound(v2, Hash::read64(b, i + 8U));
                v3 = Hash::xxRound(v3, Hash::read64(b, i + 16U));
                v4 = Hash::xxRound(v4, Hash::read64(b, i + 24U));
            }
            h = Uints::RotateLeft(v1, 1U) + Uints::RotateLeft(v2, 7U) + Uints::RotateLeft(v3, 12U) + Uints::RotateLeft(v4, 18U);
            h = Hash::xxMerge(h, v1);
            h = Hash::xxMerge(h, v2);
            h = Hash::xxMerge(h, v3);
            h = Hash::xxMerge(h, v4);
        } else {
            h = seed + Hash::xxPrime5;
        }
        h = h + n;
        for(; i + 8U <= n; i = i + 8U) {
            h = h ^ Hash::xxRound(0U, Hash::read64(b, i));
            h = Uints::RotateLeft(h, 27U) * Hash::xxPrime1 + Hash::xxPrime4;
        }
        if(i + 4U <= n) {
            h = h ^ (Hash::read32(b, i) * Hash::xxPrime1);
            h = Uints::RotateLeft(h, 23U) * Hash::xxPrime2 + Hash::xxPrime3;
            i = i + 4U;
        }
        for(; i < n; i++) {
            h = h ^ (b[i]{uint} * Hash::xxPrime5);
            h = Uints::RotateLeft(h, 11U) * Hash::xxPrime1;
        }
        h = h ^ (h >> 33U);
        h = h * Hash::xxPrime2;
        h = h ^ (h >> 29U);
        h = h * Hash::xxPrime3;
        return h ^ (h >> 32U);
    }

    private static fun uint(uint, uint) rotl32 = (x, k) {
        return ((x << k) | (x >> (32U - k))) & Hash::low32;
    }

    private static fun uint(uint) murmurBlock = (k) {
        k = (k * 3432918353U) & Hash::low32;
        k = Hash::rotl32(k, 15U);
        return (k * 461845907U) & Hash::low32;
    }

    // Murmur3 returns the 32-bit MurmurHash3 (x86_32) of n bytes at b under
    // the low 32 bits of seed.
    public static fun uint(byte*, uint, uint) Murmur3 = (b, n, seed) {
        var uint h = seed & Hash::low32;
        var uint i = 0U;
        for(; i + 4U <= n; i = i + 4U) {
            h = h ^ Hash::murmurBlock(Hash::read32(b, i));
            h = Hash::rotl32(h, 13U);
            h = (h * 5U + 3864292196U) & Hash::low32;
        }
        var uint k = 0U;
        var uint rest = n - i;
        if(rest == 3U) {
            k = k ^ (b[i + 2U]{uint} << 16U);
        }
        if(rest >= 2U) {
            k = k ^ (b[i + 1U]{uint} << 8U);
        }
        if(rest >= 1U) {
            k = k ^ b[i]{uint};
            h = h ^ Hash::murmurBlock(k);
        }
        h = h ^ (n & Hash::low32);
        h = h ^ (h >> 16U);
        h = (h * 2246822507U) & Hash::low32;
        h = h ^ (h >> 13U);
        h = (h * 3266489909U) & Hash::low32;
        return h ^ (h >> 16U);
    }

    // Str returns the XXHash64 of the bytes of s.
    public static fun uint(str) Str = (s) {
        var (byte*, int) p = Strs::ToBytes(s);
        return Hash::XXHash64(p.0, p.1{uint}, 0U);
    }

    // Mix scrambles the bits of x so that every input bit affects every
    // output bit, mapping distinct inputs to distinct outputs.
    public static fun uint(uint) Mix = (x) {
        x = (x ^ (x >> 30U)) * 13787848793156543929U;
        x = (x ^ (x >> 27U)) * 10723151780598845931U;
        return x ^ (x >> 31U);
    }

    // Combine folds the hash v into the running hash h, depending on order.
    public static fun uint(uint, uint) Combine = (h, v) {
        return Hash::Mix(h ^ (Hash::Mix(v) + 11400714819323198485U + (h << 6U) + (h >> 2U)));
    }

    public static fun uint(int) Int = (x) {
        return Hash::Mix(x{uint});
    }

    // Flt hashes x by its bits, with -0 hashing as 0 so that equal values
    // hash alike.
    public static fun uint(flt) Flt = (x) {
        if(x == 0.0) {
            return Hash::Mix(0U);
        }
        return Hash::Mix(Flts::ToBits(x));
    }
}
