import "../lang/System.zam";
import "../lang/Obj.zam";
import "../lang/Arr.zam";
import "Math.zam";
import "Hash.zam";

// Vector of flts whose length is set when it is made
public class Vector <: Arr[flt]* {
    public static fun Vector*(uint, flt...) New = (len, args) {
        var Vector* v = new(Vector);
        v.Init(len, args...);
        return v;
    }

    // Zero returns a vector of len zeros.
    public static fun Vector*(uint) Zero = (len) {
        var flt* a = new(flt, len);
        for(var uint i = 0U; i < len; i++) {
            a[i] = 0.0;
        }
        return Vector::New(len, a...);
    }

    private fun void(Vector*) check = (o) {
        if(o.len != this.len) {
            System::Panic("Vector lengths differ");
        }
    }

    public fun Vector*() Copy = () {
        var flt* a = new(flt, this.len);
        for(var uint i = 0U; i < this.len; i++) {
            a[i] = this.arr[i];
        }
        return Vector::New(this.len, a...);
    }

    public fun Vector*(Vector*) Add = (o) {
        this.check(o);
        var Vector* r = Vector::Zero(this.len);
        for(var uint i = 0U; i < this.len; i++) {
            r.arr[i] = this.arr[i] + o.arr[i];
        }
        return r;
    }

    public fun Vector*(Vector*) Sub = (o) {
        this.check(o);
        var Vector* r = Vector::Zero(this.len);
        for(var uint i = 0U; i < this.len; i++) {
            r.arr[i] = this.arr[i] - o.arr[i];
        }
        return r;
    }

    public fun Vector*(flt) Scale = (k) {
        var Vector* r = Vector::Zero(this.len);
        for(var uint i = 0U; i < this.len; i++) {
            r.arr[i] = this.arr[i] * k;
        }
        return r;
    }

    public fun Vector*() Neg = () {
        return this.Scale(-1.0);
    }

    public fun flt(Vector*) Dot = (o) {
        this.check(o);
        var flt s = 0.0;
        for(var uint i = 0U; i < this.len; i++) {
            s = s + this.arr[i] * o.arr[i];
        }
        return s;
    }

    // Norm returns the Euclidean length.
    public fun flt() Norm = () {
        return Math::Sqrt(this.Dot(this));
    }

    // Normalize returns the vector of length one in the same direction.
    public fun Vector*() Normalize = () {
        return this.Scale(1.0 / this.Norm());
    }

    public fun flt(Vector*) Distance = (o) {
        return this.Sub(o).Norm();
    }

    // Cross returns the cross product of two vectors of length three.
    public fun Vector*(Vector*) Cross = (o) {
        if(this.len != 3U || o.len != 3U) {
            System::Panic("Vector.Cross needs vectors of length three");
        }
        var flt* a = this.arr;
        var flt* b = o.arr;
        return Vector::New(3U, a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]);
    }

    public fun bool(Obj*) Eq = (o) {
        var Vector* v = o{Vector*};
        if(v.len != this.len) {
            return false;
        }
        for(var uint i = 0U; i < this.len; i++) {
            if(this.arr[i] != v.arr[i]) {
                return false;
            }
        }
        return true;
    }

    public fun int() Hash = () {
        var uint h = Hash::Int(this.len{int});
        for(var uint i = 0U; i < this.len; i++) {
            h = Hash::Combine(h, Hash::Flt(this.arr[i]));
        }
        return h{int};
    }
}
