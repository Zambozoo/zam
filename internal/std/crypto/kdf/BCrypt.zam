import "../../lang/Err.zam";
import "../../lang/StrErr.zam";

// bcrypt password-hashing function, for passwords of at most 72 bytes
public namespace BCrypt {
    public var int$ DefaultCost = 10;

    // Hash hashes a password under a fresh salt at cost, from 4 to 31.
    public static fun (str, Err*)(byte*, uint, int) Hash = (password, passwordLen, cost) {
        var (str, Err*) r;
        var str hash;
        var str errStr;
        native(STD_BCRYPT_HASH){void(byte*, int, int, str*, str*)}(password, passwordLen{int}, cost, &hash, &errStr);
        r.0 = hash;
        r.1 = null;
        if(errStr != null) {
            r.1 = StrErr::New(errStr);
        }
        return r;
    }

    // Verify reports whether a password matches a hash from Hash.
    public static fun bool(str, byte*, uint) Verify = (hash, password, passwordLen) {
        var bool ok = false;
        native(STD_BCRYPT_VERIFY){void(str, byte*, int, bool*)}(hash, password, passwordLen{int}, &ok);
        return ok;
    }
}
