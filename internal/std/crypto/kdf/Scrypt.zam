import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";

// scrypt password-based key derivation function (RFC 7914)
public namespace Scrypt {
    // Key derives length bytes from a password and salt at a cost of n, a
    // power of 2, with block size r and parallelism p.
    public static fun (Arr[byte]*, Err*)(byte*, uint, byte*, uint, uint, uint, uint, uint) Key = (password, passwordLen, salt, saltLen, n, r, p, length) {
        var byte* out = new(byte, length);
        var str errStr;
        native(STD_SCRYPT){void(byte*, int, byte*, int, uint, uint, uint, byte*, int, str*)}(password, passwordLen{int}, salt, saltLen{int}, n, r, p, out, length{int}, &errStr);
        var (Arr[byte]*, Err*) r;
        r.0 = null;
        r.1 = null;
        if(errStr != null) {
            free(out);
            r.1 = StrErr::New(errStr);
        } else {
            r.0 = Arr::[byte]New(length, out...);
        }
        return r;
    }
}
