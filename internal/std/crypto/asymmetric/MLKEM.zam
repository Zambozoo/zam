import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "Key.zam";

// Module-Lattice-Based Key-Encapsulation Mechanism (FIPS 203), with keys of
// the ML_KEM_512, ML_KEM_768 or ML_KEM_1024 kinds
public namespace MLKEM {
    // Encapsulation is a 32-byte shared secret and the ciphertext that carries
    // it to the holder of the private key.
    public class Encapsulation {
        public var Arr[byte]* ciphertext;
        public var Arr[byte]* secret;
    }

    // Generate makes a private key of a parameter set.
    public static fun (Key*, Err*)(Key.Kind) Generate = (kind) {
        if(kind{byte} < Key.Kind::ML_KEM_512{byte} || kind{byte} > Key.Kind::ML_KEM_1024{byte}) {
            var (Key*, Err*) out;
            out.0 = null;
            out.1 = StrErr::New("ML-KEM needs an ML_KEM_512, ML_KEM_768 or ML_KEM_1024 kind");
            return out;
        }
        return Key::Generate(kind);
    }

    // Encapsulate makes a shared secret for the holder of key's private half.
    public static fun (MLKEM.Encapsulation*, Err*)(Key*) Encapsulate = (key) {
        var (MLKEM.Encapsulation*, Err*) out;
        out.0 = null;
        out.1 = Key::check(key, Key.Kind::ML_KEM_512, Key.Kind::ML_KEM_1024, "ML-KEM");
        if(out.1 != null) {
            return out;
        }
        var uint ctH = 0U;
        var int ctN = 0;
        var uint secretH = 0U;
        var int secretN = 0;
        var str errStr;
        native(STD_PKEY_ENCAPSULATE){void(uint, uint*, int*, uint*, int*, str*)}(key.handle, &ctH, &ctN, &secretH, &secretN, &errStr);
        if(errStr != null) {
            out.1 = StrErr::New(errStr);
            return out;
        }
        var MLKEM.Encapsulation* enc = new(MLKEM.Encapsulation);
        enc.ciphertext = Key::take(ctH, ctN, null).0;
        enc.secret = Key::take(secretH, secretN, null).0;
        out.0 = enc;
        return out;
    }

    // Decapsulate recovers the shared secret n bytes of ciphertext at b carry.
    public static fun (Arr[byte]*, Err*)(Key*, byte*, uint) Decapsulate = (key, b, n) {
        var Err* e = Key::checkPrivate(key, Key.Kind::ML_KEM_512, Key.Kind::ML_KEM_1024, "ML-KEM");
        if(e != null) {
            var (Arr[byte]*, Err*) out;
            out.0 = null;
            out.1 = e;
            return out;
        }
        var uint h = 0U;
        var int len = 0;
        var str errStr;
        native(STD_PKEY_DECAPSULATE){void(uint, byte*, int, uint*, int*, str*)}(key.handle, b, n{int}, &h, &len, &errStr);
        return Key::take(h, len, errStr);
    }
}
