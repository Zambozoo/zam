import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "Key.zam";

// Elliptic Curve Diffie-Hellman over the NIST curves P256, P384 and P521
public namespace ECDH {
    // Generate makes a private key on a curve.
    public static fun (Key*, Err*)(Key.Kind) Generate = (curve) {
        if(curve{byte} < Key.Kind::P256{byte} || curve{byte} > Key.Kind::P521{byte}) {
            var (Key*, Err*) out;
            out.0 = null;
            out.1 = StrErr::New("ECDH needs a P256, P384 or P521 curve");
            return out;
        }
        return Key::Generate(curve);
    }

    // Derive agrees a shared secret between a private key and a peer's public
    // key on the same curve.
    public static fun (Arr[byte]*, Err*)(Key*, Key*) Derive = (key, peer) {
        var Err* e = Key::checkPrivate(key, Key.Kind::P256, Key.Kind::P521, "ECDH");
        if(e == null) {
            e = Key::check(peer, key.Kind(), key.Kind(), "ECDH");
        }
        if(e != null) {
            var (Arr[byte]*, Err*) out;
            out.0 = null;
            out.1 = e;
            return out;
        }
        return key.derive(peer);
    }
}
