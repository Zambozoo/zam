import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "Key.zam";

// Edwards-curve Digital Signature Algorithm over Curve25519 (RFC 8032)
public namespace Ed25519 {
    // Generate makes a private key.
    public static fun Key*() Generate = () {
        return Key::Generate(Key.Kind::ED25519).0;
    }

    // PrivateKey makes a private key from its 32-byte seed.
    public static fun (Key*, Err*)(byte*, uint) PrivateKey = (b, n) {
        return Key::FromRaw(Key.Kind::ED25519, b, n, true);
    }

    // PublicKey makes a public key from its 32 raw bytes.
    public static fun (Key*, Err*)(byte*, uint) PublicKey = (b, n) {
        return Key::FromRaw(Key.Kind::ED25519, b, n, false);
    }

    // Sign returns the 64-byte signature of n bytes at b.
    public static fun (Arr[byte]*, Err*)(Key*, byte*, uint) Sign = (key, b, n) {
        var Err* e = Key::checkPrivate(key, Key.Kind::ED25519, Key.Kind::ED25519, "Ed25519");
        if(e != null) {
            var (Arr[byte]*, Err*) out;
            out.0 = null;
            out.1 = e;
            return out;
        }
        return key.sign(-1, false, b, n);
    }

    // Verify reports whether sigLen bytes at sig are a signature of n bytes at
    // b under key.
    public static fun bool(Key*, byte*, uint, byte*, uint) Verify = (key, b, n, sig, sigLen) {
        return Key::check(key, Key.Kind::ED25519, Key.Kind::ED25519, "Ed25519") == null &&
            key.verify(-1, false, b, n, sig, sigLen);
    }
}
