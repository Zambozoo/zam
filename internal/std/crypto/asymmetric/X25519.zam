import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "Key.zam";

// X25519 Diffie-Hellman key agreement (RFC 7748)
public namespace X25519 {
    // Generate makes a private key.
    public static fun Key*() Generate = () {
        return Key::Generate(Key.Kind::X25519).0;
    }

    // PrivateKey makes a private key from its 32 raw bytes.
    public static fun (Key*, Err*)(byte*, uint) PrivateKey = (b, n) {
        return Key::FromRaw(Key.Kind::X25519, b, n, true);
    }

    // PublicKey makes a public key from its 32 raw bytes.
    public static fun (Key*, Err*)(byte*, uint) PublicKey = (b, n) {
        return Key::FromRaw(Key.Kind::X25519, b, n, false);
    }

    // Derive agrees a 32-byte shared secret between a private key and a
    // peer's public key.
    public static fun (Arr[byte]*, Err*)(Key*, Key*) Derive = (key, peer) {
        var Err* e = Key::checkPrivate(key, Key.Kind::X25519, Key.Kind::X25519, "X25519");
        if(e == null) {
            e = Key::check(peer, Key.Kind::X25519, Key.Kind::X25519, "X25519");
        }
        if(e != null) {
            var (Arr[byte]*, Err*) out;
            out.0 = null;
            out.1 = e;
            return out;
        }
        return key.derive(peer);
    }
}
