import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../hash/Digest.zam";
import "ECDH.zam";
import "Key.zam";

// Elliptic Curve Digital Signature Algorithm over the NIST curves P256, P384
// and P521, with DER-encoded signatures
public namespace ECDSA {
    // Generate makes a private key on a curve.
    public static fun (Key*, Err*)(Key.Kind) Generate = (curve) {
        return ECDH::Generate(curve);
    }

    // Sign returns the signature of the digest of n bytes at b.
    public static fun (Arr[byte]*, Err*)(Key*, Digest.Kind, byte*, uint) Sign = (key, digest, b, n) {
        var Err* e = Key::checkPrivate(key, Key.Kind::P256, Key.Kind::P521, "ECDSA");
        if(e != null) {
            var (Arr[byte]*, Err*) out;
            out.0 = null;
            out.1 = e;
            return out;
        }
        return key.sign(digest{byte}{int}, false, b, n);
    }

    // Verify reports whether sigLen bytes at sig are a signature of the digest
    // of n bytes at b under key.
    public static fun bool(Key*, Digest.Kind, byte*, uint, byte*, uint) Verify = (key, digest, b, n, sig, sigLen) {
        return Key::check(key, Key.Kind::P256, Key.Kind::P521, "ECDSA") == null &&
            key.verify(digest{byte}{int}, false, b, n, sig, sigLen);
    }
}
