import "../../lang/Arr.zam";
import "Digest.zam";

// SHA-256 and SHA-224
public namespace SHA256 {
    // New starts a SHA-256 digest.
    public static fun Digest*() New = () {
        return Digest::Must(Digest.Kind::SHA256, 0U);
    }

    // Sum returns the SHA-256 digest of n bytes at b.
    public static fun Arr[byte]*(byte*, uint) Sum = (b, n) {
        return Digest::Of(Digest.Kind::SHA256, 0U, b, n);
    }

    // New224 starts a SHA-224 digest.
    public static fun Digest*() New224 = () {
        return Digest::Must(Digest.Kind::SHA224, 0U);
    }

    // Sum224 returns the SHA-224 digest of n bytes at b.
    public static fun Arr[byte]*(byte*, uint) Sum224 = (b, n) {
        return Digest::Of(Digest.Kind::SHA224, 0U, b, n);
    }
}
