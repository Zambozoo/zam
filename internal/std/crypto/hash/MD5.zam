import "../../lang/Arr.zam";
import "Digest.zam";

// Message-Digest Algorithm 5, broken and only for interoperating
public namespace MD5 {
    // New starts an MD5 digest.
    public static fun Digest*() New = () {
        return Digest::Must(Digest.Kind::MD5, 0U);
    }

    // Sum returns the MD5 digest of n bytes at b.
    public static fun Arr[byte]*(byte*, uint) Sum = (b, n) {
        return Digest::Of(Digest.Kind::MD5, 0U, b, n);
    }
}
