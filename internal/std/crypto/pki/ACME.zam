import "../../codec/format/JSON.zam";
import "../../codec/text/Base64.zam";
import "../../io/web/HTTP.zam";
import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../lang/time/Duration.zam";
import "../../lang/time/Timer.zam";
import "../asymmetric/ECDSA.zam";
import "../asymmetric/Key.zam";
import "../hash/Digest.zam";
import "../hash/SHA256.zam";

// ACME is a client of an Automatic Certificate Management Environment (RFC
// 8555) server, such as Let's Encrypt, under one account. The account key is
// a P256 key, signing as ES256. A certificate is had by registering, ordering
// it for some domains, answering each domain's challenge, waiting for the
// order, finalizing it with a certificate request, and downloading it.
public class ACME {
    // Order is a request for a certificate and where it stands: its status
    // runs pending, ready, processing, then valid, or invalid.
    public class Order {
        public var str url;
        public var str status;
        public var Arr[str]* authorizations;
        public var str finalize;
        // certificate is where the certificate is downloaded from once the
        // order is valid, or "".
        public var str certificate;
    }

    // Challenge is a proof of control over a domain the server asks for. For
    // http-01, keyAuthorization is served at
    // /.well-known/acme-challenge/<token>; for dns-01, dnsValue is set as the
    // TXT record of _acme-challenge.<domain>.
    public class Challenge {
        public var str domain;
        public var str kind;
        public var str token;
        public var str url;
        public var str keyAuthorization;
        public var str dnsValue;
    }

    // Reply is a server's answer to one request.
    class Reply {
        var uint status;
        var HTTP.Headers* headers;
        var str body;
    }

    // pollMs is how long to wait between polls of an order, and attempts how
    // many polls to make before giving up.
    public var uint pollMs;
    public var uint attempts;

    var str newNonce;
    var str newAccount;
    var str newOrder;
    var Key* key;
    var str jwk;
    var str thumbprint;
    var str kid;
    var str nonce;

    static fun Err*(str) fail = (s) {
        return StrErr::New("ACME: " + s);
    }

    static fun str(str) b64 = (s) {
        var (byte*, int) p = Strs::ToBytes(s);
        return Base64::EncodeURL(p.0, p.1{uint});
    }

    static fun str(str) quote = (s) {
        return JSON::NewStr(s).Encode(false);
    }

    static fun str(JSON*, str) field = (j, name) {
        var (JSON*, bool) f = j.Get(name);
        if(!f.1 || f.0.Kind() != JSON.Kind::String) {
            return "";
        }
        return f.0.AsStr();
    }

    // New starts a client of the server whose directory is at directoryURL,
    // under accountKey.
    public static fun (ACME*, Err*)(str, Key*) New = (directoryURL, accountKey) {
        var (ACME*, Err*) out;
        out.0 = null;
        out.1 = null;
        if(!accountKey.IsPrivate() || accountKey.Kind() != Key.Kind::P256) {
            out.1 = ACME::fail("the account key must be a private P256 key");
            return out;
        }
        var (HTTP.Response*, Err*) resp = HTTP::Do(HTTP.Request::New("GET", directoryURL));
        if(resp.1 != null) {
            out.1 = resp.1;
            return out;
        }
        var (str, Err*) body = resp.0.ReadBody();
        if(body.1 != null) {
            out.1 = body.1;
            return out;
        }
        var (JSON*, Err*) dir = JSON::Parse(body.0);
        if(dir.1 != null || resp.0.status != 200U) {
            out.1 = ACME::fail("no directory at " + directoryURL);
            return out;
        }
        var ACME* a = new(ACME);
        a.newNonce = ACME::field(dir.0, "newNonce");
        a.newAccount = ACME::field(dir.0, "newAccount");
        a.newOrder = ACME::field(dir.0, "newOrder");
        a.key = accountKey;
        a.kid = "";
        a.nonce = "";
        a.pollMs = 1000U;
        a.attempts = 60U;
        var Arr[byte]* der = accountKey.Public().DER().0;
        var byte* point = der.Arr() + (der.Len() - 64U);
        a.jwk = "{\"crv\":\"P-256\",\"kty\":\"EC\",\"x\":\"" + Base64::EncodeURL(point, 32U) + "\",\"y\":\"" + Base64::EncodeURL(point + 32U, 32U) + "\"}";
        var (byte*, int) j = Strs::ToBytes(a.jwk);
        var Arr[byte]* sum = SHA256::Sum(j.0, j.1{uint});
        a.thumbprint = Base64::EncodeURL(sum.Arr(), sum.Len());
        if(a.newNonce == "" || a.newAccount == "" || a.newOrder == "") {
            out.1 = ACME::fail("the directory at " + directoryURL + " is incomplete");
            return out;
        }
        out.0 = a;
        return out;
    }

    // rawSignature turns a DER ECDSA signature into the 64 bytes of r and s
    // that JWS wants.
    static fun str(Arr[byte]*) rawSignature = (der) {
        var byte* d = der.Arr();
        var byte* out = new(byte, 64U);
        var uint at = 2U;
        for(var uint part = 0U; part < 2U; part++) {
            var uint len = d[at + 1U]{uint};
            var uint start = at + 2U;
            var uint skip = 0U;
            for(; len - skip > 32U;) {
                skip++;
            }
            for(var uint i = skip; i < len; i++) {
                out[part * 32U + 32U - (len - i)] = d[start + i];
            }
            at = start + len;
        }
        var str s = Base64::EncodeURL(out, 64U);
        free(out);
        return s;
    }

    fun Err*() fetchNonce = () {
        var (HTTP.Response*, Err*) resp = HTTP::Do(HTTP.Request::New("GET", this.newNonce));
        if(resp.1 != null) {
            return resp.1;
        }
        var (str, bool) n = resp.0.headers.Value("Replay-Nonce");
        if(!n.1) {
            return ACME::fail("the server gave no nonce");
        }
        this.nonce = n.0;
        return null;
    }

    // post sends payload, or nothing for "" as a POST-as-GET, to url signed
    // as a JWS, naming the account by its key until it has an id.
    fun (ACME.Reply*, Err*)(str, str) post = (url, payload) {
        var (ACME.Reply*, Err*) out;
        out.0 = null;
        out.1 = null;
        for(var int attempt = 0; attempt < 2; attempt++) {
            if(this.nonce == "") {
                out.1 = this.fetchNonce();
                if(out.1 != null) {
                    return out;
                }
            }
            var str who = "\"jwk\":" + this.jwk;
            if(this.kid != "") {
                who = "\"kid\":" + ACME::quote(this.kid);
            }
            var str header = ACME::b64("{\"alg\":\"ES256\"," + who + ",\"nonce\":" + ACME::quote(this.nonce) + ",\"url\":" + ACME::quote(url) + "}");
            var str body = "";
            if(payload != "") {
                body = ACME::b64(payload);
            }
            var (byte*, int) input = Strs::ToBytes(header + "." + body);
            var (Arr[byte]*, Err*) sig = ECDSA::Sign(this.key, Digest.Kind::SHA256, input.0, input.1{uint});
            if(sig.1 != null) {
                out.1 = sig.1;
                return out;
            }
            var HTTP.Request* r = HTTP.Request::New("POST", url);
            r.headers.Set("Content-Type", "application/jose+json");
            r.SetBody("{\"protected\":\"" + header + "\",\"payload\":\"" + body + "\",\"signature\":\"" + ACME::rawSignature(sig.0) + "\"}");
            this.nonce = "";
            var (HTTP.Response*, Err*) resp = HTTP::Do(r);
            if(resp.1 != null) {
                out.1 = resp.1;
                return out;
            }
            var (str, bool) n = resp.0.headers.Value("Replay-Nonce");
            if(n.1) {
                this.nonce = n.0;
            }
            var (str, Err*) text = resp.0.ReadBody();
            if(text.1 != null) {
                out.1 = text.1;
                return out;
            }
            if(resp.0.status >= 400U) {
                var str kind = "";
                var str detail = text.0;
                var (JSON*, Err*) problem = JSON::Parse(text.0);
                if(problem.1 == null && problem.0.Kind() == JSON.Kind::Object) {
                    kind = ACME::field(problem.0, "type");
                    detail = ACME::field(problem.0, "detail");
                }
                if(kind == "urn:ietf:params:acme:error:badNonce" && attempt == 0) {
                    continue;
                }
                out.1 = ACME::fail(url + " answered " + resp.0.status{str} + ": " + detail);
                return out;
            }
            var ACME.Reply* reply = new(ACME.Reply);
            reply.status = resp.0.status;
            reply.headers = resp.0.headers;
            reply.body = text.0;
            out.0 = reply;
            return out;
        }
        return out;
    }

    fun (JSON*, Err*)(str, str) postJSON = (url, payload) {
        var (JSON*, Err*) out;
        out.0 = null;
        var (ACME.Reply*, Err*) reply = this.post(url, payload);
        out.1 = reply.1;
        if(reply.1 != null) {
            return out;
        }
        out = JSON::Parse(reply.0.body);
        if(out.1 != null || out.0.Kind() != JSON.Kind::Object) {
            out.0 = null;
            out.1 = ACME::fail(url + " did not answer with an object");
        }
        return out;
    }

    // Register creates the account, or finds it if the key already has one,
    // with email as its contact unless it is "", agreeing to the terms of
    // service when told to.
    public fun Err*(str, bool) Register = (email, agree) {
        var JSON* payload = JSON::NewObject();
        payload.Set("termsOfServiceAgreed", JSON::NewBool(agree));
        if(email != "") {
            var JSON* contact = JSON::NewArray();
            contact.Append(JSON::NewStr("mailto:" + email));
            payload.Set("contact", contact);
        }
        var (ACME.Reply*, Err*) reply = this.post(this.newAccount, payload.Encode(false));
        if(reply.1 != null) {
            return reply.1;
        }
        var (str, bool) location = reply.0.headers.Value("Location");
        if(!location.1) {
            return ACME::fail("the server gave no account URL");
        }
        this.kid = location.0;
        return null;
    }

    fun void(ACME.Order*, JSON*) read = (o, j) {
        o.status = ACME::field(j, "status");
        o.finalize = ACME::field(j, "finalize");
        o.certificate = ACME::field(j, "certificate");
        var (JSON*, bool) auths = j.Get("authorizations");
        var uint n = 0U;
        if(auths.1) {
            n = auths.0.Len();
        }
        o.authorizations = Arr::[str]New(n, new(str, n + 1U)...);
        for(var uint i = 0U; i < n; i++) {
            o.authorizations.Set(i, auths.0.At(i).AsStr());
        }
    }

    // NewOrder orders a certificate for domains.
    public fun (ACME.Order*, Err*)(Arr[str]*) NewOrder = (domains) {
        var (ACME.Order*, Err*) out;
        out.0 = null;
        if(this.kid == "") {
            out.1 = ACME::fail("register before ordering");
            return out;
        }
        var JSON* ids = JSON::NewArray();
        for(var uint i = 0U; i < domains.Len(); i++) {
            var JSON* id = JSON::NewObject();
            id.Set("type", JSON::NewStr("dns"));
            id.Set("value", JSON::NewStr(domains.Get(i)));
            ids.Append(id);
        }
        var JSON* payload = JSON::NewObject();
        payload.Set("identifiers", ids);
        var (ACME.Reply*, Err*) reply = this.post(this.newOrder, payload.Encode(false));
        out.1 = reply.1;
        if(reply.1 != null) {
            return out;
        }
        var (str, bool) location = reply.0.headers.Value("Location");
        var (JSON*, Err*) j = JSON::Parse(reply.0.body);
        if(!location.1 || j.1 != null) {
            out.1 = ACME::fail("the server's order is unreadable");
            return out;
        }
        var ACME.Order* o = new(ACME.Order);
        o.url = location.0;
        this.read(o, j.0);
        out.0 = o;
        return out;
    }

    // Challenges returns the challenge of kind, such as http-01 or dns-01,
    // for each domain of an order.
    public fun (Arr[ACME.Challenge*]*, Err*)(ACME.Order*, str) Challenges = (o, kind) {
        var (Arr[ACME.Challenge*]*, Err*) out;
        out.0 = null;
        out.1 = null;
        var uint n = o.authorizations.Len();
        var Arr[ACME.Challenge*]* list = Arr::[ACME.Challenge*]New(n, new(ACME.Challenge*, n + 1U)...);
        for(var uint i = 0U; i < n; i++) {
            var (JSON*, Err*) auth = this.postJSON(o.authorizations.Get(i), "");
            if(auth.1 != null) {
                out.1 = auth.1;
                return out;
            }
            var str domain = "";
            var (JSON*, bool) id = auth.0.Get("identifier");
            if(id.1) {
                domain = ACME::field(id.0, "value");
            }
            var (JSON*, bool) all = auth.0.Get("challenges");
            var ACME.Challenge* found = null;
            for(var uint k = 0U; all.1 && found == null && k < all.0.Len(); k++) {
                var JSON* c = all.0.At(k);
                if(ACME::field(c, "type") == kind) {
                    found = new(ACME.Challenge);
                    found.domain = domain;
                    found.kind = kind;
                    found.token = ACME::field(c, "token");
                    found.url = ACME::field(c, "url");
                    found.keyAuthorization = found.token + "." + this.thumbprint;
                    var (byte*, int) ka = Strs::ToBytes(found.keyAuthorization);
                    var Arr[byte]* sum = SHA256::Sum(ka.0, ka.1{uint});
                    found.dnsValue = Base64::EncodeURL(sum.Arr(), sum.Len());
                }
            }
            if(found == null) {
                out.1 = ACME::fail("no " + kind + " challenge for " + domain);
                return out;
            }
            list.Set(i, found);
        }
        out.0 = list;
        return out;
    }

    // Accept tells the server a challenge is ready to be checked.
    public fun Err*(ACME.Challenge*) Accept = (c) {
        return this.postJSON(c.url, "{}").1;
    }

    // poll reads the order until its status is want, failing if it turns
    // invalid or attempts run out.
    fun Err*(ACME.Order*, str) poll = (o, want) {
        for(var uint i = 0U; i < this.attempts; i++) {
            var (JSON*, Err*) j = this.postJSON(o.url, "");
            if(j.1 != null) {
                return j.1;
            }
            this.read(o, j.0);
            if(o.status == want || o.status == "valid") {
                return null;
            }
            if(o.status == "invalid") {
                return ACME::fail("the order turned invalid");
            }
            Timer::Sleep(Duration::Milliseconds(this.pollMs{int}));
        }
        return ACME::fail("the order is still " + o.status);
    }

    // Wait waits for every challenge of an order to be met.
    public fun Err*(ACME.Order*) Wait = (o) {
        return this.poll(o, "ready");
    }

    // Finalize submits a certificate request in DER for a ready order and
    // waits for the certificate to be issued.
    public fun Err*(ACME.Order*, Arr[byte]*) Finalize = (o, csr) {
        var (JSON*, Err*) j = this.postJSON(o.finalize, "{\"csr\":\"" + Base64::EncodeURL(csr.Arr(), csr.Len()) + "\"}");
        if(j.1 != null) {
            return j.1;
        }
        this.read(o, j.0);
        return this.poll(o, "valid");
    }

    // Certificate downloads a valid order's certificate chain, in PEM.
    public fun (str, Err*)(ACME.Order*) Certificate = (o) {
        var (str, Err*) out;
        out.0 = "";
        if(o.certificate == "") {
            out.1 = ACME::fail("the order has no certificate yet");
            return out;
        }
        var (ACME.Reply*, Err*) reply = this.post(o.certificate, "");
        out.1 = reply.1;
        if(reply.1 == null) {
            out.0 = reply.0.body;
        }
        return out;
    }
}
