import "../../io/web/HTTP.zam";
import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../lang/time/Duration.zam";
import "../../lang/time/Time.zam";
import "../asymmetric/Key.zam";
import "X509.zam";

// Online Certificate Status Protocol (RFC 6960): asking a certificate's
// issuer whether it still stands, and answering as one
public namespace OCSP {
    public enum Status : int {
        Good(0),
        Revoked(1),
        Unknown(2);
    }

    // Result is what a responder said of a certificate, to the second.
    // revokedAt holds only for a Revoked status, and nextUpdate only when
    // hasNextUpdate is set.
    public class Result {
        public var OCSP.Status status;
        public var Time revokedAt;
        public var Time thisUpdate;
        public var Time nextUpdate;
        public var bool hasNextUpdate;
    }

    static fun OCSP.Status(int) statusOf = (s) {
        if(s == OCSP.Status::Good{int}) {
            return OCSP.Status::Good;
        } else if(s == OCSP.Status::Revoked{int}) {
            return OCSP.Status::Revoked;
        }
        return OCSP.Status::Unknown;
    }

    // Request asks after cert, issued by issuer, in DER.
    public static fun (Arr[byte]*, Err*)(X509*, X509*) Request = (cert, issuer) {
        var uint h = 0U;
        var int n = 0;
        var str errStr;
        native(STD_OCSP_REQUEST){void(uint, uint, uint*, int*, str*)}(cert.handle, issuer.handle, &h, &n, &errStr);
        return X509::take(h, n, errStr);
    }

    // Check reads n bytes of DER response at b about cert, which must be
    // signed by issuer or a responder it delegated to and be current.
    public static fun (OCSP.Result*, Err*)(X509*, X509*, byte*, uint) Check = (cert, issuer, b, n) {
        var (OCSP.Result*, Err*) out;
        out.0 = null;
        out.1 = null;
        var int status = 0;
        var int revokedAt = 0;
        var int thisUpdate = 0;
        var int nextUpdate = 0;
        var bool hasNextUpdate = false;
        var str errStr;
        native(STD_OCSP_CHECK){void(uint, uint, byte*, int, int*, int*, int*, int*, bool*, str*)}(cert.handle, issuer.handle, b, n{int}, &status, &revokedAt, &thisUpdate, &nextUpdate, &hasNextUpdate, &errStr);
        if(errStr != null) {
            out.1 = StrErr::New(errStr);
            return out;
        }
        var OCSP.Result* r = new(OCSP.Result);
        r.status = OCSP::statusOf(status);
        r.revokedAt = Time::FromUnix(revokedAt, 0);
        r.thisUpdate = Time::FromUnix(thisUpdate, 0);
        r.nextUpdate = Time::FromUnix(nextUpdate, 0);
        r.hasNextUpdate = hasNextUpdate;
        out.0 = r;
        return out;
    }

    // Query asks the responder cert names after cert, issued by issuer.
    public static fun (OCSP.Result*, Err*)(X509*, X509*) Query = (cert, issuer) {
        var (OCSP.Result*, Err*) out;
        out.0 = null;
        if(cert.OCSPURL() == "") {
            out.1 = StrErr::New("the certificate names no OCSP responder");
            return out;
        }
        var (Arr[byte]*, Err*) req = OCSP::Request(cert, issuer);
        out.1 = req.1;
        if(req.1 != null) {
            return out;
        }
        var HTTP.Request* r = HTTP.Request::New("POST", cert.OCSPURL());
        r.headers.Set("Content-Type", "application/ocsp-request");
        r.SetBody(Strs::FromBytes(req.0.Arr(), req.0.Len(){int}));
        var (HTTP.Response*, Err*) resp = HTTP::Do(r);
        out.1 = resp.1;
        if(resp.1 != null) {
            return out;
        }
        if(resp.0.status != 200U) {
            out.1 = StrErr::New("the OCSP responder answered " + resp.0.status{str});
            return out;
        }
        var (str, Err*) body = resp.0.ReadBody();
        out.1 = body.1;
        if(body.1 != null) {
            return out;
        }
        var (byte*, int) b = Strs::ToBytes(body.0);
        return OCSP::Check(cert, issuer, b.0, b.1{uint});
    }

    // Respond answers n bytes of DER request at b as issuer, signing with
    // issuerKey and giving every certificate asked after status, revoked at
    // revokedAt if it is Revoked, to hold for validFor.
    public static fun (Arr[byte]*, Err*)(byte*, uint, X509*, Key*, OCSP.Status, Time, Duration) Respond = (b, n, issuer, issuerKey, status, revokedAt, validFor) {
        var (Arr[byte]*, Err*) der = issuerKey.DER();
        if(der.1 != null) {
            return der;
        }
        if(!issuerKey.IsPrivate()) {
            der.0 = null;
            der.1 = StrErr::New("answering OCSP needs the issuer's private key");
            return der;
        }
        var uint h = 0U;
        var int len = 0;
        var str errStr;
        native(STD_OCSP_RESPOND){void(byte*, int, uint, byte*, int, int, int, int, uint*, int*, str*)}(b, n{int}, issuer.handle, der.0.Arr(), der.0.Len(){int}, status{int}, revokedAt.Unix(), validFor.InMilliseconds() / 1000, &h, &len, &errStr);
        return X509::take(h, len, errStr);
    }
}
