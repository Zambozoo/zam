import "../lang/Strs.zam";

// Comparisons that take time independent of the secrets compared
public namespace Subtle {
    // Equal reports whether the n bytes at a and b are equal.
    public static fun bool(byte*, byte*, uint) Equal = (a, b, n) {
        var bool out = false;
        native(STD_CRYPTO_EQUAL){void(byte*, byte*, int, bool*)}(a, b, n{int}, &out);
        return out;
    }

    // EqualStr reports whether a and b are equal, leaking only their lengths.
    public static fun bool(str, str) EqualStr = (a, b) {
        var (byte*, int) x = Strs::ToBytes(a);
        var (byte*, int) y = Strs::ToBytes(b);
        if(x.1 != y.1) {
            return false;
        }
        return Subtle::Equal(x.0, y.0, x.1{uint});
    }
}
