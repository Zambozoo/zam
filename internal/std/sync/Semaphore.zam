import "Mutex.zam";
import "Cond.zam";

// Counting semaphore
public class Semaphore {
    var Mutex* m;
    var Cond* c;
    var uint count;

    public static fun Semaphore*(uint) New = (i) {
        var Semaphore* s = new(Semaphore);
        s.Init(i);
        return s;
    }

    public fun void(uint) Init = (i) {
        this.m = type(Mutex).New();
        this.c = type(Cond).New(this.m);
        this.count = i;
    }

    // Wait takes one from the count, waiting while it is zero.
    public fun void() Wait = () {
        this.m.Lock();
        for(; this.count == 0U;) {
            this.c.Wait();
        }
        this.count--;
        this.m.Unlock();
    }

    // TryWait takes one from the count if it is not zero, reporting whether
    // it did.
    public fun bool() TryWait = () {
        this.m.Lock();
        var bool ok = this.count > 0U;
        if(ok) {
            this.count--;
        }
        this.m.Unlock();
        return ok;
    }

    // Unlock adds one to the count, waking a waiter.
    public fun void() Unlock = () {
        this.m.Lock();
        this.count++;
        this.c.Signal();
        this.m.Unlock();
    }
}
