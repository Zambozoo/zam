import "Mutex.zam";
import "Cond.zam";

// Counting semaphore
public class Semaphore {
    var Mutex* m;
    var Cond* c;
    var uint count;

    public static fun Semaphore*(uint) New = (i) {
        var Semaphore* s = new(Semaphore);
        s.Init(i);
        return s;
    }

    public fun void(uint) Init = (i) {
        this.m = Mutex::New();
        this.c = Cond::New(this.m);
        this.count = i;
    }

    // Wait takes one from the count, waiting while it is zero.
    public fun void() Wait = () {
        this.m.Lock();
        defer this.m.Unlock();
        for(; this.count == 0U;) {
            this.c.Wait();
        }
        this.count--;
    }

    // TryWait takes one from the count if it is not zero, reporting whether
    // it did.
    public fun bool() TryWait = () {
        this.m.Lock();
        defer this.m.Unlock();
        if(this.count == 0U) {
            return false;
        }
        this.count--;
        return true;
    }

    // Unlock adds one to the count, waking a waiter.
    public fun void() Unlock = () {
        this.m.Lock();
        defer this.m.Unlock();
        this.count++;
        this.c.Signal();
    }
}
