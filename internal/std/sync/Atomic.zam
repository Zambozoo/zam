import "RWMutex.zam";

// Value read and written by many threads at once
public class Atomic[A] {
    var RWMutex* m;
    var A v;

    public static fun[A] Atomic[A]*(A) New = (v) {
        var Atomic[A]* a = new(Atomic[A]);
        a.Init(v);
        return a;
    }

    public fun void(A) Init = (v) {
        this.m = RWMutex::New();
        this.v = v;
    }

    public fun A() Load = () {
        this.m.RLock();
        var A v = this.v;
        this.m.RUnlock();
        return v;
    }

    // Set stores v and returns the value it replaced.
    public fun A(A) Set = (v) {
        this.m.Lock();
        var A old = this.v;
        this.v = v;
        this.m.Unlock();
        return old;
    }

    // Update stores v if f holds for the current value and v, returning the
    // value it replaced and whether it did.
    public fun (A, bool)(A, bool(A, A)) Update = (v, f) {
        this.m.Lock();
        var (A, bool) p;
        if(f(this.v, v)) {
            p.1 = true;
            p.0 = this.v;
            this.v = v;
        } else {
            p.1 = false;
        }
        this.m.Unlock();
        return p;
    }
}
