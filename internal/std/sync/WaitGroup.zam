import "../lang/System.zam";
import "Mutex.zam";
import "Cond.zam";

// Count of outstanding work that waiters block on until it reaches zero. Do
// runs work on threads of its own, at most max at once when max is not zero.
public class WaitGroup {
    var Mutex* m;
    var Cond* c;
    var int count;
    var uint running;
    var uint max;

    public static fun WaitGroup*() New = () {
        return WaitGroup::NewWithMaxSize(0U);
    }

    public static fun WaitGroup*(uint) NewWithMaxSize = (max) {
        var WaitGroup* wg = new(WaitGroup);
        wg.InitWithMaxSize(max);
        return wg;
    }

    public fun void() Init = () {
        this.InitWithMaxSize(0U);
    }

    public fun void(uint) InitWithMaxSize = (max) {
        this.m = Mutex::New();
        this.c = Cond::New(this.m);
        this.count = 0;
        this.running = 0U;
        this.max = max;
    }

    private fun void(void()) run = (f) {
        f();
        this.m.Lock();
        this.running--;
        this.count--;
        this.c.Broadcast();
        this.m.Unlock();
    }

    // Do runs f on a new thread, first waiting for a free slot when the group
    // has a max size.
    public fun void(void()) Do = (f) {
        this.m.Lock();
        for(; this.max > 0U && this.running >= this.max;) {
            this.c.Wait();
        }
        this.running++;
        this.count++;
        this.m.Unlock();
        async(this.run(f));
    }

    // Add adds i, which may be negative, to the count.
    public fun void(int) Add = (i) {
        this.m.Lock();
        this.count = this.count + i;
        if(this.count < 0) {
            System::Panic("WaitGroup count is negative");
        }
        if(this.count == 0) {
            this.c.Broadcast();
        }
        this.m.Unlock();
    }

    public fun void() Done = () {
        this.Add(-1);
    }

    // Wait returns once the count is zero.
    public fun void() Wait = () {
        this.m.Lock();
        for(; this.count > 0;) {
            this.c.Wait();
        }
        this.m.Unlock();
    }
}
