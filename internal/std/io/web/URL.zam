import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../data/list/ArrList.zam";

// URL split into its parts, over libcurl. Each part is as written, so
// percent-escaped wherever the URL escapes it; a missing part is empty, and
// a missing port is 0.
public class URL {
    public var str scheme;
    public var str user;
    public var str password;
    public var str host;
    public var uint port;
    public var str path;
    public var str query;
    public var str fragment;

    // Parse reads an absolute URL.
    public static fun (URL*, Err*)(str) Parse = (s) {
        var (URL*, Err*) out;
        var URL* u = new(URL);
        var int port;
        var str errStr;
        native(STD_URL_PARSE){void(str, str*, str*, str*, str*, int*, str*, str*, str*, str*)}(s, &(u.scheme), &(u.user), &(u.password), &(u.host), &port, &(u.path), &(u.query), &(u.fragment), &errStr);
        u.port = port{uint};
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(s + ": " + errStr);
        } else {
            out.0 = u;
        }
        return out;
    }

    // Escape percent-escapes every byte of s but letters, digits and -._~.
    public static fun str(str) Escape = (s) {
        var str out;
        native(STD_URL_ESCAPE){void(str, str*)}(s, &out);
        return out;
    }

    // Unescape decodes every percent escape in s.
    public static fun str(str) Unescape = (s) {
        var str out;
        native(STD_URL_UNESCAPE){void(str, str*)}(s, &out);
        return out;
    }

    // ParseQuery decodes a query as name=value pairs joined by &, reading +
    // as a space. A pair with no = has an empty value.
    public static fun Arr[(str, str)]*(str) ParseQuery = (q) {
        var ArrList[(str, str)]* pairs = ArrList::[(str, str)]New(0U);
        if(Strs::ByteLen(q) == 0) {
            return pairs.Arr();
        }
        var Arr[str]* parts = Strs::Split(q, '&'{int}{byte});
        for(var uint i = 0U; i < parts.Len(); i++) {
            var str part = parts.Get(i);
            if(Strs::ByteLen(part) == 0) {
                continue;
            }
            var Arr[str]* kv = Strs::Split(part, '='{int}{byte});
            var str value = "";
            for(var uint j = 1U; j < kv.Len(); j++) {
                if(j > 1U) {
                    value = value + "=";
                }
                value = value + kv.Get(j);
            }
            var (str, str) p;
            p.0 = URL::Unescape(URL::plusToSpace(kv.Get(0U)));
            p.1 = URL::Unescape(URL::plusToSpace(value));
            pairs.AddLast(p);
        }
        return pairs.Arr();
    }

    private static fun str(str) plusToSpace = (s) {
        var Arr[str]* parts = Strs::Split(s, '+'{int}{byte});
        var str out = parts.Get(0U);
        for(var uint i = 1U; i < parts.Len(); i++) {
            out = out + " " + parts.Get(i);
        }
        return out;
    }

    // QueryValues decodes this URL's query; see ParseQuery.
    public fun Arr[(str, str)]*() QueryValues = () {
        return URL::ParseQuery(this.query);
    }

    // QueryValue returns the first value the query gives a name, and false
    // when it gives none.
    public fun (str, bool)(str) QueryValue = (name) {
        var (str, bool) out;
        out.0 = "";
        out.1 = false;
        var Arr[(str, str)]* values = this.QueryValues();
        for(var uint i = 0U; i < values.Len(); i++) {
            if(values.Get(i).0 == name) {
                out.0 = values.Get(i).1;
                out.1 = true;
                return out;
            }
        }
        return out;
    }

    // Resolve resolves a reference, absolute or relative, against this URL.
    public fun (URL*, Err*)(str) Resolve = (ref) {
        var str resolved;
        var str errStr;
        native(STD_URL_RESOLVE){void(str, str, str*, str*)}(this.Str(), ref, &resolved, &errStr);
        if(errStr != null) {
            var (URL*, Err*) out;
            out.0 = null;
            out.1 = StrErr::New(ref + ": " + errStr);
            return out;
        }
        return URL::Parse(resolved);
    }

    // Str joins the parts back into a URL, or is empty when they do not make
    // one.
    public fun str() Str = () {
        var str out;
        var str errStr;
        native(STD_URL_BUILD){void(str, str, str, str, int, str, str, str, str*, str*)}(this.scheme, this.user, this.password, this.host, this.port{int}, this.path, this.query, this.fragment, &out, &errStr);
        return out;
    }
}
