import "../../lang/Arrs.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../sync/Mutex.zam";
import "../local/Buffer.zam";
import "../local/Stream.zam";
import "../local/Streams.zam";
import "../net/Socket.zam";
import "../net/TCP.zam";
import "../net/TLS.zam";
import "HTTP.zam";
import "URL.zam";

// WebSocket over any stream, per RFC 6455: dialed as a client to ws:// and
// wss:// URLs, or accepted by a server from an HTTP request. One thread may
// send while another receives. Pings are answered without being seen.
public class WebSocket {
    // One whole message, or the end of the connection when closed is true
    public class Message {
        public var bool text;
        public var str data;
        public var bool closed;
    }

    // The largest message Receive takes, joined from its fragments
    public static var int MaxMessage = 67108864;

    var Stream* stream;
    var Socket* sock;
    var bool client;
    var Mutex* lock;
    var byte* buf;
    var int bufCap;
    var int bufStart;
    var int bufEnd;
    var bool closeSent;
    var bool ended;
    var bool receiving;
    var bool released;

    private static fun WebSocket*(Stream*, Socket*, bool, str) of = (stream, sock, client, rest) {
        var WebSocket* ws = new(WebSocket);
        ws.stream = stream;
        ws.sock = sock;
        ws.client = client;
        ws.lock = Mutex::New();
        ws.bufCap = 16384;
        ws.buf = new(byte, 16384U);
        ws.bufStart = 0;
        ws.bufEnd = 0;
        var (byte*, int) r = Strs::ToBytes(rest);
        if(r.1 > 0) {
            ws.reserve(r.1);
            Arrs::[byte]Copy(r.1{uint}, r.0, ws.buf);
            ws.bufEnd = r.1;
        }
        ws.closeSent = false;
        ws.ended = false;
        ws.receiving = false;
        ws.released = false;
        return ws;
    }

    private static fun (WebSocket*, Err*)(str) fail = (msg) {
        var (WebSocket*, Err*) out;
        out.0 = null;
        out.1 = StrErr::New(msg);
        return out;
    }

    // Dial opens a WebSocket to a ws:// or wss:// url, sending headers,
    // which may be null, with the opening handshake. A wss:// connection is
    // verified with ctx, or against the system's roots for a null one.
    public static fun (WebSocket*, Err*)(str, HTTP.Headers*, TLS.Context*) Dial = (url, headers, ctx) {
        var (URL*, Err*) parsed = URL::Parse(url);
        if(parsed.1 != null) {
            return WebSocket::fail(url + ": " + parsed.1.Err());
        }
        var URL* u = parsed.0;
        var bool secure = u.scheme == "wss" || u.scheme == "https";
        if(!secure && u.scheme != "ws" && u.scheme != "http") {
            return WebSocket::fail(url + ": not a WebSocket URL");
        }
        var uint port = u.port;
        if(port == 0U) {
            port = 80U;
            if(secure) {
                port = 443U;
            }
        }
        var (Socket*, Err*) d = TCP::Dial(u.host, port);
        if(d.1 != null) {
            return WebSocket::fail(url + ": " + d.1.Err());
        }
        var Stream* s = d.0;
        if(secure) {
            if(ctx == null) {
                var (TLS.Context*, Err*) roots = TLS.Context::Client("", true);
                if(roots.1 != null) {
                    d.0.Close();
                    return WebSocket::fail(url + ": " + roots.1.Err());
                }
                ctx = roots.0;
            }
            var (TLS*, Err*) t = TLS::Client(d.0, ctx, u.host);
            if(t.1 != null) {
                d.0.Close();
                return WebSocket::fail(url + ": " + t.1.Err());
            }
            s = t.0;
        }

        var str target = u.path;
        if(target == "") {
            target = "/";
        }
        if(u.query != "") {
            target = target + "?" + u.query;
        }
        var str host = u.host;
        if(u.port != 0U) {
            host = host + ":" + u.port{str};
        }
        var str key;
        native(STD_WS_KEY){void(str*)}(&key);
        var str extra = "";
        if(headers != null) {
            extra = headers.Join(": ", "\r\n");
        }
        var Err* e = Streams::WriteStr(s, "GET " + target + " HTTP/1.1\r\nHost: " + host + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n" + extra + "\r\n");
        if(e != null) {
            s.Close();
            return WebSocket::fail(url + ": " + e.Err());
        }
        var HTTP.Conn* c = HTTP.Conn::New(s, d.0, true);
        var (bool, Err*) next = c.Next();
        var str problem = "";
        if(next.1 != null) {
            problem = next.1.Err();
        } else if(!next.0) {
            problem = "connection closed during the handshake";
        } else if(c.status != 101U) {
            problem = "handshake answered " + c.status{str} + " " + HTTP::StatusText(c.status);
        } else {
            var str want;
            native(STD_WS_ACCEPT){void(str, str*)}(key, &want);
            if(c.headers.Value("sec-websocket-accept").0 != want) {
                problem = "handshake answered the wrong key";
            }
        }
        if(problem != "") {
            c.Delete();
            s.Close();
            return WebSocket::fail(url + ": " + problem);
        }
        var str rest = c.Rest();
        c.Delete();
        var (WebSocket*, Err*) out;
        out.0 = WebSocket::of(s, d.0, true, rest);
        out.1 = null;
        return out;
    }

    // Accept answers a request to open a WebSocket, hijacking the
    // connection it came on. It fails, leaving the request to be answered,
    // for a request that is not one.
    public static fun (WebSocket*, Err*)(HTTP.Request*) Accept = (req) {
        var (str, bool) key = req.headers.Value("sec-websocket-key");
        if(req.method != "GET" || HTTP.Headers::Fold(req.headers.Value("upgrade").0) != "websocket" || !key.1) {
            return WebSocket::fail("not a WebSocket request");
        }
        if(req.headers.Value("sec-websocket-version").0 != "13") {
            return WebSocket::fail("unsupported WebSocket version");
        }
        var HTTP.Conn* c = req.Hijack();
        if(c == null) {
            return WebSocket::fail("request was not received by a server");
        }
        var str accept;
        native(STD_WS_ACCEPT){void(str, str*)}(key.0, &accept);
        var Err* e = Streams::WriteStr(c.stream, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n");
        if(e != null) {
            c.stream.Close();
            return WebSocket::fail(e.Err());
        }
        var (WebSocket*, Err*) out;
        out.0 = WebSocket::of(c.stream, c.sock, false, c.Rest());
        out.1 = null;
        return out;
    }

    // sendLocked sends one frame; the caller holds the lock.
    private fun Err*(int, byte*, int) sendLocked = (opcode, b, n) {
        if(this.closeSent || this.released) {
            return StrErr::New("WebSocket is closed");
        }
        if(opcode == 8) {
            this.closeSent = true;
        }
        var byte* frame = new(byte, (n + 14){uint});
        var int len;
        native(STD_WS_FRAME){void(int, bool, byte*, int, byte*, int*)}(opcode, this.client, b, n, frame, &len);
        var Err* e = Streams::WriteAll(this.stream, frame, len);
        free(frame);
        return e;
    }

    private fun Err*(int, byte*, int) send = (opcode, b, n) {
        this.lock.Lock();
        var Err* e = this.sendLocked(opcode, b, n);
        this.lock.Unlock();
        return e;
    }

    public fun Err*(str) SendText = (s) {
        var (byte*, int) p = Strs::ToBytes(s);
        return this.send(1, p.0, p.1);
    }

    public fun Err*(byte*, uint) SendBinary = (b, n) {
        return this.send(2, b, n{int});
    }

    // reserve makes room for n unread bytes in buf.
    private fun void(int) reserve = (n) {
        var int len = this.bufEnd - this.bufStart;
        if(this.bufStart > 0) {
            if(len > 0) {
                Arrs::[byte]Copy(len{uint}, this.buf + this.bufStart{uint}, this.buf);
            }
            this.bufStart = 0;
            this.bufEnd = len;
        }
        if(n <= this.bufCap) {
            return;
        }
        var byte* grown = new(byte, n{uint});
        if(len > 0) {
            Arrs::[byte]Copy(len{uint}, this.buf, grown);
        }
        free(this.buf);
        this.buf = grown;
        this.bufCap = n;
    }

    // fill reads until n bytes are unread, answering false at the end of the
    // stream.
    private fun (bool, Err*)(int) fill = (n) {
        var (bool, Err*) out;
        out.0 = true;
        out.1 = null;
        if(this.bufEnd - this.bufStart >= n) {
            return out;
        }
        if(this.bufStart + n > this.bufCap) {
            var int want = n;
            if(want < 16384) {
                want = 16384;
            }
            this.reserve(want);
        }
        for(; this.bufEnd - this.bufStart < n;) {
            var (int, Err*) p = this.stream.Read(this.buf + this.bufEnd{uint}, this.bufCap - this.bufEnd);
            if(p.1 != null) {
                out.0 = false;
                out.1 = p.1;
                return out;
            }
            if(p.0 == 0) {
                out.0 = false;
                return out;
            }
            this.bufEnd = this.bufEnd + p.0;
        }
        return out;
    }

    // release closes the stream once nothing more is to be read or sent;
    // the caller holds the lock.
    private fun void() release = () {
        if(!this.released) {
            this.released = true;
            this.stream.Close();
        }
    }

    // Receive waits for the next whole message, joining its fragments. Once
    // the connection is closed, from either end, it answers a closed message.
    public fun (WebSocket.Message*, Err*)() Receive = () {
        var (WebSocket.Message*, Err*) out;
        out.0 = new(WebSocket.Message);
        out.0.text = false;
        out.0.data = "";
        out.0.closed = true;
        out.1 = null;
        this.lock.Lock();
        if(this.ended) {
            this.lock.Unlock();
            return out;
        }
        this.receiving = true;
        this.lock.Unlock();

        var Buffer* message = null;
        for(;;) {
            var bool fin;
            var int opcode;
            var int head = 0;
            var int length;
            var (bool, Err*) got = this.fill(2);
            for(; got.0 && head == 0;) {
                native(STD_WS_HEADER){void(byte*, int, bool*, int*, int*, int*)}(this.buf + this.bufStart{uint}, this.bufEnd - this.bufStart, &fin, &opcode, &head, &length);
                if(head == 0) {
                    got = this.fill(this.bufEnd - this.bufStart + 1);
                }
            }
            if(got.0 && (length > WebSocket::MaxMessage || (message != null && message.Len(){int} + length > WebSocket::MaxMessage))) {
                got.0 = false;
                got.1 = StrErr::New("WebSocket message too large");
            }
            if(got.0) {
                got = this.fill(head + length);
            }
            if(!got.0) {
                if(got.1 != null && !this.closeSent) {
                    out.1 = got.1;
                } else if(message != null) {
                    out.1 = StrErr::New("connection ended in the middle of a message");
                }
                break;
            }
            var byte* payload = this.buf + (this.bufStart + head){uint};
            if((this.buf[this.bufStart + 1]{int} & 128) != 0) {
                native(STD_WS_UNMASK){void(byte*, int, byte*)}(payload, length, payload - 4U);
            }
            this.bufStart = this.bufStart + head + length;
            if(opcode == 8) {
                var int echo = length;
                if(echo > 2) {
                    echo = 2;
                }
                this.lock.Lock();
                if(!this.closeSent) {
                    this.sendLocked(8, payload, echo);
                }
                this.lock.Unlock();
                break;
            }
            if(opcode == 9) {
                this.send(10, payload, length);
                continue;
            }
            if(opcode == 10) {
                continue;
            }
            if((opcode == 1 || opcode == 2) && message == null) {
                if(fin) {
                    out.0.text = opcode == 1;
                    out.0.data = Strs::FromBytes(payload, length);
                    out.0.closed = false;
                    break;
                }
                out.0.text = opcode == 1;
                message = Buffer::New();
                message.Write(payload, length);
                continue;
            }
            if(opcode == 0 && message != null) {
                message.Write(payload, length);
                if(fin) {
                    out.0.data = message.Str();
                    out.0.closed = false;
                    message.Delete();
                    break;
                }
                continue;
            }
            out.1 = StrErr::New("WebSocket protocol error: unexpected opcode " + opcode{str});
            break;
        }

        this.lock.Lock();
        this.receiving = false;
        if(out.0.closed || out.1 != null) {
            this.ended = true;
            out.0.closed = true;
            this.release();
        }
        this.lock.Unlock();
        return out;
    }

    // Close sends a close frame, if none has been sent, and ends the
    // connection, ending any Receive waiting in another thread.
    public fun void() Close = () {
        this.lock.Lock();
        if(!this.closeSent && !this.released) {
            this.sendLocked(8, null, 0);
        }
        this.ended = true;
        if(this.receiving) {
            this.sock.CloseRead();
            this.sock.CloseWrite();
        } else {
            this.release();
        }
        this.lock.Unlock();
    }

    public fun void() Delete = () {
        free(this.buf);
        this.buf = null;
    }
}
