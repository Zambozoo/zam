import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "Buffer.zam";
import "Stream.zam";

// Helpers over any Stream
public namespace Streams {
    // ReadAll reads s to its end.
    public static fun (str, Err*)(Stream*) ReadAll = (s) {
        var (str, Err*) out;
        var Buffer* b = Buffer::New();
        var byte* chunk = new(byte, 16384U);
        out.1 = null;
        for(;;) {
            var (int, Err*) p = s.Read(chunk, 16384);
            if(p.1 != null) {
                out.1 = p.1;
                break;
            }
            if(p.0 == 0) {
                break;
            }
            b.Write(chunk, p.0);
        }
        free(chunk);
        out.0 = b.Str();
        b.Delete();
        return out;
    }

    // WriteAll writes all n bytes at b, writing again after a short write.
    public static fun Err*(Stream*, byte*, int) WriteAll = (s, b, n) {
        var int done = 0;
        for(; done < n;) {
            var (int, Err*) p = s.Write(b + done{uint}, n - done);
            if(p.1 != null) {
                return p.1;
            }
            if(p.0 <= 0) {
                return StrErr::New("stream accepted no bytes");
            }
            done = done + p.0;
        }
        return null;
    }

    public static fun Err*(Stream*, str) WriteStr = (s, text) {
        var (byte*, int) p = Strs::ToBytes(text);
        return Streams::WriteAll(s, p.0, p.1);
    }

    // Copy writes what it reads from src to dst until src ends, returning how
    // many bytes it copied.
    public static fun (int, Err*)(Stream*, Stream*) Copy = (dst, src) {
        var (int, Err*) out;
        out.0 = 0;
        out.1 = null;
        var byte* chunk = new(byte, 16384U);
        for(;;) {
            var (int, Err*) p = src.Read(chunk, 16384);
            if(p.1 != null) {
                out.1 = p.1;
                break;
            }
            if(p.0 == 0) {
                break;
            }
            var Err* e = Streams::WriteAll(dst, chunk, p.0);
            if(e != null) {
                out.1 = e;
                break;
            }
            out.0 = out.0 + p.0;
        }
        free(chunk);
        return out;
    }
}
