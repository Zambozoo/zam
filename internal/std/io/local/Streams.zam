import {
    "../../lang/Err.zam";
    "../../lang/StrErr.zam";
    "../../lang/Strs.zam";
    "Buffer.zam";
    "Stream.zam";
}

// Helpers over any Stream
public namespace Streams {
    // ReadAll reads s to its end.
    public static fun (str, Err*)(Stream*) ReadAll = (s) {
        var (str, Err*) out;
        var Buffer* b = Buffer::New();
        defer b.Delete();
        var byte* chunk = new(byte, 16384U);
        defer free(chunk);
        out.1 = null;
        for {
            var (uint, Err*) p = s.Read(chunk, 16384U);
            if(p.1 != null) {
                out.1 = p.1;
                break;
            }
            if(p.0 == 0U) {
                break;
            }
            b.Write(chunk, p.0);
        }
        out.0 = b.Str();
        return out;
    }

    // WriteAll writes all n bytes at b, writing again after a short write.
    public static fun Err*(Stream*, byte*, uint) WriteAll = (s, b, n) {
        var uint done = 0U;
        for(; done < n;) {
            var (uint, Err*) p = s.Write(b + done, n - done);
            if(p.1 != null) {
                return p.1;
            }
            if(p.0 == 0U) {
                return StrErr::New("stream accepted no bytes");
            }
            done = done + p.0;
        }
        return null;
    }

    public static fun Err*(Stream*, str) WriteStr = (s, text) {
        var (byte*, uint) p = Strs::ToBytes(text);
        return Streams::WriteAll(s, p.0, p.1);
    }

    // Copy writes what it reads from src to dst until src ends, returning how
    // many bytes it copied.
    public static fun (uint, Err*)(Stream*, Stream*) Copy = (dst, src) {
        var (uint, Err*) out;
        out.0 = 0U;
        out.1 = null;
        var byte* chunk = new(byte, 16384U);
        defer free(chunk);
        for {
            var (uint, Err*) p = src.Read(chunk, 16384U);
            if(p.1 != null) {
                out.1 = p.1;
                break;
            }
            if(p.0 == 0U) {
                break;
            }
            var Err* e = Streams::WriteAll(dst, chunk, p.0);
            if(e != null) {
                out.1 = e;
                break;
            }
            out.0 = out.0 + p.0;
        }
        return out;
    }
}
