import "../../lang/Err.zam";
import "../../lang/Pair.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../lang/Objs.zam";

class File {
    // The POSIX open flags
    enum Flag : byte {
        ReadOnly(flag(0)),
        WriteOnly(flag(1)),
        ReadWrite(flag(2)),
        Create(flag(3)),
        Exclusive(flag(4)),
        Truncate(flag(5)),
        Append(flag(6));

        static private fun byte(int) flag = (code) {
            var int v;
            native(STD_FILE_FLAG){void(int, int*)}(code, &v);
            return v{byte};
        }
    }

    static private fun File*(int) newWithFD = (fd) {
        var File* f = new(File);
        f.fd = fd;
        return f;
    }

    static var File*$ StdIn = newWithFD(0);
    static var File*$ StdOut = newWithFD(1);
    static var File*$ StdErr = newWithFD(2);

    private var int fd;

    static fun Pair[File*, Err*](str, int) New = (path, mode) {
        var File* f = new(File);
        var Pair[File*, Err*] p;
        p.second = f.Init(path, mode);
        if (p.second == null) {
            p.first = f;
        }
        return p;
    }

    fun Err*(str, int) Init = (path, mode) {
        var str errStr;
        native(STD_FILE_INIT){void(str, int, int*, str*)}(path, mode, &(this.fd), &errStr);
        if (errStr != null) {
            var StrErr* se = new(StrErr);
            se.Init(errStr);
            return se;
        }
        return null;
    }

    fun Pair[int, Err*](byte*, int) Write = (buffer, count) {
        var Pair[int, Err*] p;
        var str errStr;
        native(STD_FILE_WRITE){void(int*, byte*, int, int*, str*)}(&(this.fd), buffer, count, &(p.first), &errStr);
        if (errStr != null) {
            var StrErr* se = new(StrErr);
            se.Init(errStr);
            p.second = se;
        }
        return p;
    }

    fun Pair[int, Err*](str) WriteStr = (s) {
        var Pair[byte*, int] bytes = type(Strs).ToBytes(s);
        return this.Write(bytes.first, bytes.second);
    }

    fun Pair[int, Err*](byte*, int) Read = (buffer, count) {
        var Pair[int, Err*] p;
        var str errStr;
        native(STD_FILE_READ){void(int*, byte*, int, int*, str*)}(&(this.fd), buffer, count, &(p.first), &errStr);
        if (errStr != null) {
            var StrErr* se = new(StrErr);
            se.Init(errStr);
            p.second = se;
        }
        return p;
    }

    fun Err*() Close = () {
        var str errStr;
        native(STD_FILE_CLOSE){void(int*, str*)}(&(this.fd), &errStr);
        if (errStr != null) {
            var StrErr* se = new(StrErr);
            se.Init(errStr);
            return se;
        }
        return null;
    }

    fun void() Delete = () {
        this.Close();
        type(Objs).Delete(this);
    }
}
