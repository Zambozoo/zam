import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../lang/Objs.zam";
import "Streams.zam";

public class File {
    // The POSIX open flags
    public enum Flag : int {
        ReadOnly(flag(0)),
        WriteOnly(flag(1)),
        ReadWrite(flag(2)),
        Create(flag(3)),
        Exclusive(flag(4)),
        Truncate(flag(5)),
        Append(flag(6));

        static private fun int(int) flag = (code) {
            var int v;
            native(STD_FILE_FLAG){void(int, int*)}(code, &v);
            return v;
        }
    }

    // Where a Seek offset is measured from
    public enum Whence : int {
        Start(0),
        Current(1),
        End(2);
    }

    // FromFD wraps an open file descriptor, which the File then owns.
    public static fun File*(int) FromFD = (fd) {
        var File* f = new(File);
        f.fd = fd;
        return f;
    }

    public static var File*$ StdIn = FromFD(0);
    public static var File*$ StdOut = FromFD(1);
    public static var File*$ StdErr = FromFD(2);

    private var int fd;

    // err turns a native's error message into an Err, or null for none.
    private static fun Err*(str) err = (msg) {
        if(msg == null) {
            return null;
        }
        return StrErr::New(msg);
    }

    // New opens path with mode, the Flags it is opened with or'd together.
    public static fun (File*, Err*)(str, int) New = (path, mode) {
        var File* f = new(File);
        var (File*, Err*) p;
        p.1 = f.Init(path, mode);
        if (p.1 == null) {
            p.0 = f;
        }
        return p;
    }

    // Open opens path for reading.
    public static fun (File*, Err*)(str) Open = (path) {
        return File::New(path, File.Flag::ReadOnly{int});
    }

    // Create opens path for writing, creating it or emptying what is there.
    public static fun (File*, Err*)(str) Create = (path) {
        return File::New(path, File.Flag::WriteOnly{int} | File.Flag::Create{int} | File.Flag::Truncate{int});
    }

    public fun Err*(str, int) Init = (path, mode) {
        var str errStr;
        this.fd = -1;
        native(STD_FILE_INIT){void(str, int, int*, str*)}(path, mode, &(this.fd), &errStr);
        return File::err(errStr);
    }

    public fun int() FD = () {
        return this.fd;
    }

    // InitFD makes the File own an open file descriptor, which is how a
    // subclass wraps one.
    public fun void(int) InitFD = (fd) {
        this.fd = fd;
    }

    public fun (int, Err*)(byte*, int) Write = (buffer, count) {
        var (int, Err*) p;
        var str errStr;
        native(STD_FILE_WRITE){void(int*, byte*, int, int*, str*)}(&(this.fd), buffer, count, &(p.0), &errStr);
        p.1 = File::err(errStr);
        return p;
    }

    public fun (int, Err*)(str) WriteStr = (s) {
        var (byte*, int) bytes = Strs::ToBytes(s);
        return this.Write(bytes.0, bytes.1);
    }

    // Read reads up to count bytes into buffer, returning how many it read,
    // zero at the end of the file.
    public fun (int, Err*)(byte*, int) Read = (buffer, count) {
        var (int, Err*) p;
        var str errStr;
        native(STD_FILE_READ){void(int*, byte*, int, int*, str*)}(&(this.fd), buffer, count, &(p.0), &errStr);
        p.1 = File::err(errStr);
        return p;
    }

    // ReadAll reads up to the end of the file.
    public fun (str, Err*)() ReadAll = () {
        return Streams::ReadAll(this);
    }

    // Seek moves the offset the next read or write begins at, returning the
    // new offset from the start.
    public fun (int, Err*)(int, File.Whence) Seek = (offset, whence) {
        var (int, Err*) p;
        var str errStr;
        native(STD_FILE_SEEK){void(int*, int, int, int*, str*)}(&(this.fd), offset, whence{int}, &(p.0), &errStr);
        p.1 = File::err(errStr);
        return p;
    }

    public fun (int, Err*)() Size = () {
        var (int, Err*) p;
        var str errStr;
        native(STD_FILE_SIZE){void(int*, int*, str*)}(&(this.fd), &(p.0), &errStr);
        p.1 = File::err(errStr);
        return p;
    }

    // Sync commits what has been written to storage.
    public fun Err*() Sync = () {
        var str errStr;
        native(STD_FILE_SYNC){void(int*, str*)}(&(this.fd), &errStr);
        return File::err(errStr);
    }

    public fun Err*() Close = () {
        if(this.fd < 0) {
            return StrErr::New("file already closed");
        }
        var str errStr;
        native(STD_FILE_CLOSE){void(int*, str*)}(&(this.fd), &errStr);
        this.fd = -1;
        return File::err(errStr);
    }

    public fun void() Delete = () {
        if(this.fd >= 0) {
            this.Close();
        }
        Objs::Delete(this);
    }
}
