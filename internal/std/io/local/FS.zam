import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../../lang/time/Time.zam";
import "File.zam";

// Operations on the paths of the local file system
public namespace FS {
    // What lies at a path
    public struct Info {
        public var int size;
        // mode holds the permission bits.
        public var int mode;
        public var bool isDir;
        // modTime is the last modification, to the second.
        public var Time modTime;
    }

    private static fun Err*(str) err = (msg) {
        if(msg == null) {
            return null;
        }
        return StrErr::New(msg);
    }

    // Stat describes what lies at path, following symbolic links.
    public static fun (FS.Info, Err*)(str) Stat = (path) {
        var (FS.Info, Err*) p;
        var str errStr;
        var int modTime = 0;
        native(STD_FS_STAT){void(str, int*, int*, bool*, int*, str*)}(path, &(p.0.size), &(p.0.mode), &(p.0.isDir), &modTime, &errStr);
        p.0.modTime = Time::FromUnix(modTime, 0);
        p.1 = FS::err(errStr);
        return p;
    }

    public static fun bool(str) Exists = (path) {
        return FS::Stat(path).1 == null;
    }

    public static fun bool(str) IsDir = (path) {
        var (FS.Info, Err*) p = FS::Stat(path);
        return p.1 == null && p.0.isDir;
    }

    // Remove removes a file or an empty directory.
    public static fun Err*(str) Remove = (path) {
        var str errStr;
        native(STD_FS_REMOVE){void(str, str*)}(path, &errStr);
        return FS::err(errStr);
    }

    // RemoveAll removes path and everything beneath it. A path that does not
    // exist is no error.
    public static fun Err*(str) RemoveAll = (path) {
        if(!FS::Exists(path)) {
            return null;
        }
        if(FS::IsDir(path)) {
            var (Arr[str]*, Err*) entries = FS::ReadDir(path);
            if(entries.1 != null) {
                return entries.1;
            }
            for(var uint i = 0U; i < entries.0.Len(); i++) {
                var Err* e = FS::RemoveAll(FS::Join(path, entries.0.Get(i)));
                if(e != null) {
                    return e;
                }
            }
        }
        return FS::Remove(path);
    }

    public static fun Err*(str, str) Rename = (from, to) {
        var str errStr;
        native(STD_FS_RENAME){void(str, str, str*)}(from, to, &errStr);
        return FS::err(errStr);
    }

    // MakeDir makes a directory with permission bits 0755.
    public static fun Err*(str) MakeDir = (path) {
        var str errStr;
        native(STD_FS_MAKE_DIR){void(str, int, str*)}(path, 493, &errStr);
        return FS::err(errStr);
    }

    // MakeDirs makes path and every directory above it that is missing.
    public static fun Err*(str) MakeDirs = (path) {
        var (byte*, int) p = Strs::ToBytes(path);
        var uint n = p.1{uint};
        for(var uint i = 1U; i <= n; i++) {
            if(i == n || p.0[i]{int} == '/'{int}) {
                var str prefix = Strs::FromBytes(p.0, i{int});
                if(!FS::IsDir(prefix)) {
                    var Err* e = FS::MakeDir(prefix);
                    if(e != null) {
                        return e;
                    }
                }
            }
        }
        return null;
    }

    public static fun Err*(str, int) Chmod = (path, mode) {
        var str errStr;
        native(STD_FS_CHMOD){void(str, int, str*)}(path, mode, &errStr);
        return FS::err(errStr);
    }

    // ReadDir lists the names in a directory but . and .., sorted bytewise.
    public static fun (Arr[str]*, Err*)(str) ReadDir = (path) {
        var (Arr[str]*, Err*) out;
        var str joined;
        var str errStr;
        native(STD_FS_READ_DIR){void(str, str*, str*)}(path, &joined, &errStr);
        out.1 = FS::err(errStr);
        if(out.1 != null) {
            out.0 = null;
            return out;
        }
        if(Strs::ByteLen(joined) == 0) {
            out.0 = Arr::[str]New(0U, new(str, 0U)...);
        } else {
            out.0 = Strs::Split(joined, 0{byte});
        }
        return out;
    }

    public static fun (str, Err*)(str) ReadFile = (path) {
        var (str, Err*) out;
        var (File*, Err*) f = File::Open(path);
        if(f.1 != null) {
            out.0 = "";
            out.1 = f.1;
            return out;
        }
        out = f.0.ReadAll();
        var Err* e = f.0.Close();
        if(out.1 == null) {
            out.1 = e;
        }
        return out;
    }

    private static fun Err*(str, str, int) writeWith = (path, s, mode) {
        var (File*, Err*) f = File::New(path, mode);
        if(f.1 != null) {
            return f.1;
        }
        var (int, Err*) w = f.0.WriteStr(s);
        var Err* e = f.0.Close();
        if(w.1 != null) {
            return w.1;
        }
        return e;
    }

    // WriteFile writes s as the whole of path, creating it if need be.
    public static fun Err*(str, str) WriteFile = (path, s) {
        return FS::writeWith(path, s, File.Flag::WriteOnly{int} | File.Flag::Create{int} | File.Flag::Truncate{int});
    }

    // AppendFile writes s at the end of path, creating it if need be.
    public static fun Err*(str, str) AppendFile = (path, s) {
        return FS::writeWith(path, s, File.Flag::WriteOnly{int} | File.Flag::Create{int} | File.Flag::Append{int});
    }

    // Cwd returns the working directory.
    public static fun (str, Err*)() Cwd = () {
        var (str, Err*) out;
        var str errStr;
        native(STD_FS_CWD){void(str*, str*)}(&(out.0), &errStr);
        out.1 = FS::err(errStr);
        return out;
    }

    // Chdir changes the working directory.
    public static fun Err*(str) Chdir = (path) {
        var str errStr;
        native(STD_FS_CHDIR){void(str, str*)}(path, &errStr);
        return FS::err(errStr);
    }

    // TempDir returns the directory for temporary files: $TMPDIR, or /tmp.
    public static fun str() TempDir = () {
        var str dir;
        native(STD_FS_TEMP_DIR){void(str*)}(&dir);
        return dir;
    }

    // Join joins two paths with one slash between them.
    public static fun str(str, str) Join = (a, b) {
        var (byte*, int) p = Strs::ToBytes(a);
        if(p.1 == 0) {
            return b;
        }
        if(p.0[p.1 - 1]{int} == '/'{int}) {
            return a + b;
        }
        return a + "/" + b;
    }
}
