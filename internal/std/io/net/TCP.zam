import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "Socket.zam";

// TCP connections, over IPv4 and IPv6
public namespace TCP {
    // Dial connects to the first of host's addresses that answers on port.
    public static fun (Socket*, Err*)(str, uint) Dial = (host, port) {
        var (Socket*, Err*) out;
        var int fd = -1;
        var str errStr;
        native(STD_TCP_DIAL){void(str, int, int*, str*)}(host, port{int}, &fd, &errStr);
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(host + ":" + port{str} + ": " + errStr);
        } else {
            out.0 = Socket::Of(fd);
        }
        return out;
    }

    // Listen accepts connections on host and port. An empty host listens on
    // every local address, and port 0 lets the system choose one.
    public static fun (Socket.Listener*, Err*)(str, uint) Listen = (host, port) {
        var (Socket.Listener*, Err*) out;
        var uint h = 0U;
        var str errStr;
        native(STD_NET_LISTEN){void(bool, str, int, uint*, str*)}(false, host, port{int}, &h, &errStr);
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(host + ":" + port{str} + ": " + errStr);
        } else {
            out.0 = Socket.Listener::Of(h);
        }
        return out;
    }
}
