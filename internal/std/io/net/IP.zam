import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";

// IPv4 or IPv6 address, held as its 16 bytes in two big-endian words, an
// IPv4 address in the leading four
public struct IP {
    var uint hi;
    var uint lo;
    var bool v6;

    // Parse reads an IPv4 or IPv6 address in any of its written forms.
    public static fun (IP, Err*)(str) Parse = (s) {
        var (IP, Err*) out;
        var str errStr;
        native(STD_IP_PARSE){void(str, uint*, uint*, bool*, str*)}(s, &(out.0.hi), &(out.0.lo), &(out.0.v6), &errStr);
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(errStr + ": " + s);
        }
        return out;
    }

    // Lookup resolves a host name, or an address, to its addresses.
    public static fun (Arr[IP]*, Err*)(str) Lookup = (host) {
        var (Arr[IP]*, Err*) out;
        var str joined;
        var str errStr;
        native(STD_IP_LOOKUP){void(str, str*, str*)}(host, &joined, &errStr);
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(host + ": " + errStr);
            return out;
        }
        var Arr[str]* texts = Strs::Split(joined, 0{byte});
        out.0 = Arr::[IP]New(texts.Len(), new(IP, texts.Len())...);
        for(var uint i = 0U; i < texts.Len(); i++) {
            out.0.Set(i, IP::Parse(texts.Get(i)).0);
        }
        return out;
    }

    public fun bool() IsV6 = () {
        return this.v6;
    }

    public fun bool() IsLoopback = () {
        if(this.v6) {
            return this.hi == 0U && this.lo == 1U;
        }
        return (this.hi >> 56U) == 127U;
    }

    public fun bool(IP) Eq = (o) {
        return this.hi == o.hi && this.lo == o.lo && this.v6 == o.v6;
    }

    // Str returns the address's canonical text.
    public fun str() Str = () {
        var str s;
        native(STD_IP_STR){void(uint, uint, bool, str*)}(this.hi, this.lo, this.v6, &s);
        return s;
    }
}
