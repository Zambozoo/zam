import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../local/Streams.zam";
import "Socket.zam";

// TLS connection over a socket, over OpenSSL, speaking TLS 1.2 or later
public class TLS {
    // Context holds what a client or server connects with: trusted roots and
    // whether to verify the peer for a client, and a certificate and key for
    // a server. One context serves any number of connections.
    public class Context {
        var uint handle;

        private static fun (TLS.Context*, Err*)(uint, str) of = (h, errStr) {
            var (TLS.Context*, Err*) out;
            out.0 = null;
            out.1 = null;
            if(errStr != null) {
                out.1 = StrErr::New(errStr);
            } else {
                out.0 = new(TLS.Context);
                out.0.handle = h;
            }
            return out;
        }

        // Client trusts the PEM certificates in caFile, or the system's roots
        // for an empty path, and checks the server's certificate and name
        // unless verify is false.
        public static fun (TLS.Context*, Err*)(str, bool) Client = (caFile, verify) {
            var uint h = 0U;
            var str errStr;
            native(STD_TLS_CLIENT_CONTEXT){void(str, bool, uint*, str*)}(caFile, verify, &h, &errStr);
            return TLS.Context::of(h, errStr);
        }

        // Server presents the PEM certificate chain in certFile, proven by the
        // PEM private key in keyFile.
        public static fun (TLS.Context*, Err*)(str, str) Server = (certFile, keyFile) {
            var uint h = 0U;
            var str errStr;
            native(STD_TLS_SERVER_CONTEXT){void(str, str, uint*, str*)}(certFile, keyFile, &h, &errStr);
            return TLS.Context::of(h, errStr);
        }

        public fun void() Delete = () {
            native(STD_TLS_CONTEXT_FREE){void(uint)}(this.handle);
            this.handle = 0U;
        }
    }

    var uint ssl;
    var Socket* sock;
    var TLS.Context* ctx;

    private static fun (TLS*, Err*)(Socket*, TLS.Context*, str, bool) handshake = (sock, ctx, serverName, server) {
        var (TLS*, Err*) out;
        var uint h = 0U;
        var str errStr;
        native(STD_TLS_HANDSHAKE){void(uint, int, str, bool, uint*, str*)}(ctx.handle, sock.FD(), serverName, server, &h, &errStr);
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(errStr);
            return out;
        }
        var TLS* t = new(TLS);
        t.ssl = h;
        t.sock = sock;
        t.ctx = ctx;
        out.0 = t;
        return out;
    }

    // Client runs the client handshake over a connected socket. serverName is
    // the host the certificate must name, and is sent for SNI.
    public static fun (TLS*, Err*)(Socket*, TLS.Context*, str) Client = (sock, ctx, serverName) {
        return TLS::handshake(sock, ctx, serverName, false);
    }

    // Server runs the server handshake over an accepted socket.
    public static fun (TLS*, Err*)(Socket*, TLS.Context*) Server = (sock, ctx) {
        return TLS::handshake(sock, ctx, "", true);
    }

    public fun Socket*() Sock = () {
        return this.sock;
    }

    // Read reads up to count bytes into buffer, returning how many it read,
    // zero at the end of the stream.
    public fun (int, Err*)(byte*, int) Read = (buffer, count) {
        var (int, Err*) p;
        var str errStr;
        native(STD_TLS_READ){void(uint, byte*, int, int*, str*)}(this.ssl, buffer, count, &(p.0), &errStr);
        p.1 = null;
        if(errStr != null) {
            p.1 = StrErr::New(errStr);
        }
        return p;
    }

    public fun (int, Err*)(byte*, int) Write = (buffer, count) {
        var (int, Err*) p;
        var str errStr;
        native(STD_TLS_WRITE){void(uint, byte*, int, int*, str*)}(this.ssl, buffer, count, &(p.0), &errStr);
        p.1 = null;
        if(errStr != null) {
            p.1 = StrErr::New(errStr);
        }
        return p;
    }

    public fun (int, Err*)(str) WriteStr = (s) {
        var (byte*, int) bytes = Strs::ToBytes(s);
        return this.Write(bytes.0, bytes.1);
    }

    // ReadAll reads up to the end of the stream.
    public fun (str, Err*)() ReadAll = () {
        return Streams::ReadAll(this);
    }

    // Close ends the TLS session and closes the socket under it.
    public fun Err*() Close = () {
        if(this.ssl != 0U) {
            native(STD_TLS_CLOSE){void(uint)}(this.ssl);
            this.ssl = 0U;
        }
        return this.sock.Close();
    }

    public fun void() Delete = () {
        if(this.ssl != 0U) {
            native(STD_TLS_CLOSE){void(uint)}(this.ssl);
            this.ssl = 0U;
        }
    }
}
