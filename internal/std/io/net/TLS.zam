import "../../lang/Err.zam";
import "../../lang/Pair.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";
import "../local/Streams.zam";
import "Socket.zam";

// TLS connection over a socket, over OpenSSL, speaking TLS 1.2 or later
public class TLS {
    // Context holds what a client or server connects with: trusted roots and
    // whether to verify the peer for a client, and a certificate and key for
    // a server. One context serves any number of connections.
    public class Context {
        var uint handle;

        private static fun Pair[TLS.Context*, Err*](uint, str) of = (h, errStr) {
            var Pair[TLS.Context*, Err*] out;
            out.first = null;
            out.second = null;
            if(errStr != null) {
                out.second = type(StrErr).New(errStr);
            } else {
                out.first = new(TLS.Context);
                out.first.handle = h;
            }
            return out;
        }

        // Client trusts the PEM certificates in caFile, or the system's roots
        // for an empty path, and checks the server's certificate and name
        // unless verify is false.
        public static fun Pair[TLS.Context*, Err*](str, bool) Client = (caFile, verify) {
            var uint h = 0U;
            var str errStr;
            native(STD_TLS_CLIENT_CONTEXT){void(str, bool, uint*, str*)}(caFile, verify, &h, &errStr);
            return type(TLS.Context).of(h, errStr);
        }

        // Server presents the PEM certificate chain in certFile, proven by the
        // PEM private key in keyFile.
        public static fun Pair[TLS.Context*, Err*](str, str) Server = (certFile, keyFile) {
            var uint h = 0U;
            var str errStr;
            native(STD_TLS_SERVER_CONTEXT){void(str, str, uint*, str*)}(certFile, keyFile, &h, &errStr);
            return type(TLS.Context).of(h, errStr);
        }

        public fun void() Delete = () {
            native(STD_TLS_CONTEXT_FREE){void(uint)}(this.handle);
            this.handle = 0U;
        }
    }

    var uint ssl;
    var Socket* sock;
    var TLS.Context* ctx;

    private static fun Pair[TLS*, Err*](Socket*, TLS.Context*, str, bool) handshake = (sock, ctx, serverName, server) {
        var Pair[TLS*, Err*] out;
        var uint h = 0U;
        var str errStr;
        native(STD_TLS_HANDSHAKE){void(uint, int, str, bool, uint*, str*)}(ctx.handle, sock.FD(), serverName, server, &h, &errStr);
        out.first = null;
        out.second = null;
        if(errStr != null) {
            out.second = type(StrErr).New(errStr);
            return out;
        }
        var TLS* t = new(TLS);
        t.ssl = h;
        t.sock = sock;
        t.ctx = ctx;
        out.first = t;
        return out;
    }

    // Client runs the client handshake over a connected socket. serverName is
    // the host the certificate must name, and is sent for SNI.
    public static fun Pair[TLS*, Err*](Socket*, TLS.Context*, str) Client = (sock, ctx, serverName) {
        return type(TLS).handshake(sock, ctx, serverName, false);
    }

    // Server runs the server handshake over an accepted socket.
    public static fun Pair[TLS*, Err*](Socket*, TLS.Context*) Server = (sock, ctx) {
        return type(TLS).handshake(sock, ctx, "", true);
    }

    public fun Socket*() Sock = () {
        return this.sock;
    }

    // Read reads up to count bytes into buffer, returning how many it read,
    // zero at the end of the stream.
    public fun Pair[int, Err*](byte*, int) Read = (buffer, count) {
        var Pair[int, Err*] p;
        var str errStr;
        native(STD_TLS_READ){void(uint, byte*, int, int*, str*)}(this.ssl, buffer, count, &(p.first), &errStr);
        p.second = null;
        if(errStr != null) {
            p.second = type(StrErr).New(errStr);
        }
        return p;
    }

    public fun Pair[int, Err*](byte*, int) Write = (buffer, count) {
        var Pair[int, Err*] p;
        var str errStr;
        native(STD_TLS_WRITE){void(uint, byte*, int, int*, str*)}(this.ssl, buffer, count, &(p.first), &errStr);
        p.second = null;
        if(errStr != null) {
            p.second = type(StrErr).New(errStr);
        }
        return p;
    }

    public fun Pair[int, Err*](str) WriteStr = (s) {
        var Pair[byte*, int] bytes = type(Strs).ToBytes(s);
        return this.Write(bytes.first, bytes.second);
    }

    // ReadAll reads up to the end of the stream.
    public fun Pair[str, Err*]() ReadAll = () {
        return type(Streams).ReadAll(this);
    }

    // Close ends the TLS session and closes the socket under it.
    public fun Err*() Close = () {
        if(this.ssl != 0U) {
            native(STD_TLS_CLOSE){void(uint)}(this.ssl);
            this.ssl = 0U;
        }
        return this.sock.Close();
    }

    public fun void() Delete = () {
        if(this.ssl != 0U) {
            native(STD_TLS_CLOSE){void(uint)}(this.ssl);
            this.ssl = 0U;
        }
    }
}
