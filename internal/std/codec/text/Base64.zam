import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";

// RFC 4648 Base64, in the standard alphabet with padding and in the URL-safe
// alphabet without it
public namespace Base64 {
    var str$ std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var str$ url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

    private static fun str(byte*, uint, str, bool) encode = (b, n, alphabet, pad) {
        var (byte*, int) a = Strs::ToBytes(alphabet);
        var uint cap = (n + 2U) / 3U * 4U;
        var byte* out = new(byte, cap + 1U);
        var uint o = 0U;
        for(var uint i = 0U; i < n; i = i + 3U) {
            var uint v = b[i]{uint} << 16U;
            if(i + 1U < n) {
                v = v | (b[i + 1U]{uint} << 8U);
            }
            if(i + 2U < n) {
                v = v | b[i + 2U]{uint};
            }
            out[o] = a.0[(v >> 18U) & 63U];
            out[o + 1U] = a.0[(v >> 12U) & 63U];
            o = o + 2U;
            if(i + 1U < n) {
                out[o] = a.0[(v >> 6U) & 63U];
                o++;
            } else if(pad) {
                out[o] = '='{int}{byte};
                o++;
            }
            if(i + 2U < n) {
                out[o] = a.0[v & 63U];
                o++;
            } else if(pad) {
                out[o] = '='{int}{byte};
                o++;
            }
        }
        var str s = Strs::FromBytes(out, o{int});
        free(out);
        return s;
    }

    // value returns the six bits c stands for in the alphabet, or -1.
    private static fun int(int, bool) value = (c, urlSafe) {
        if(c >= 'A'{int} && c <= 'Z'{int}) {
            return c - 'A'{int};
        }
        if(c >= 'a'{int} && c <= 'z'{int}) {
            return c - 'a'{int} + 26;
        }
        if(c >= '0'{int} && c <= '9'{int}) {
            return c - '0'{int} + 52;
        }
        if((c == '+'{int} && !urlSafe) || (c == '-'{int} && urlSafe)) {
            return 62;
        }
        if((c == '/'{int} && !urlSafe) || (c == '_'{int} && urlSafe)) {
            return 63;
        }
        return -1;
    }

    // decode reads s, whose padding is optional, into bytes.
    private static fun (Arr[byte]*, Err*)(str, bool) decode = (s, urlSafe) {
        var (Arr[byte]*, Err*) out;
        out.0 = null;
        var (byte*, int) p = Strs::ToBytes(s);
        var uint n = p.1{uint};
        for(; n > 0U && p.0[n - 1U]{int} == '='{int};) {
            n--;
        }
        if(n % 4U == 1U || p.1{uint} - n > 2U) {
            out.1 = StrErr::New("invalid base64 length");
            return out;
        }
        var uint len = n / 4U * 3U;
        if(n % 4U > 1U) {
            len = len + n % 4U - 1U;
        }
        var byte* b = new(byte, len);
        var uint o = 0U;
        var uint acc = 0U;
        var uint bits = 0U;
        for(var uint i = 0U; i < n; i++) {
            var int v = Base64::value(p.0[i]{int}, urlSafe);
            if(v < 0) {
                free(b);
                out.1 = StrErr::New("invalid base64 byte at offset " + i{str});
                return out;
            }
            acc = (acc << 6U) | v{uint};
            bits = bits + 6U;
            if(bits >= 8U) {
                bits = bits - 8U;
                b[o] = ((acc >> bits) & 255U){byte};
                o++;
            }
        }
        out.0 = Arr::[byte]New(len, b...);
        out.1 = null;
        return out;
    }

    public static fun str(byte*, uint) Encode = (b, n) {
        return Base64::encode(b, n, Base64::std, true);
    }

    public static fun str(str) EncodeStr = (s) {
        var (byte*, int) p = Strs::ToBytes(s);
        return Base64::encode(p.0, p.1{uint}, Base64::std, true);
    }

    // EncodeURL encodes in the URL-safe alphabet, without padding.
    public static fun str(byte*, uint) EncodeURL = (b, n) {
        return Base64::encode(b, n, Base64::url, false);
    }

    public static fun (Arr[byte]*, Err*)(str) Decode = (s) {
        return Base64::decode(s, false);
    }

    public static fun (Arr[byte]*, Err*)(str) DecodeURL = (s) {
        return Base64::decode(s, true);
    }

    public static fun (str, Err*)(str) DecodeStr = (s) {
        var (str, Err*) out;
        var (Arr[byte]*, Err*) d = Base64::decode(s, false);
        out.1 = d.1;
        out.0 = "";
        if(d.1 == null) {
            out.0 = Strs::FromBytes(d.0.Arr(), d.0.Len(){int});
        }
        return out;
    }
}
