import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/Pair.zam";
import "../../lang/StrErr.zam";
import "../../lang/Strs.zam";

// RFC 4648 Base64, in the standard alphabet with padding and in the URL-safe
// alphabet without it
public namespace Base64 {
    var str$ std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var str$ url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

    private static fun str(byte*, uint, str, bool) encode = (b, n, alphabet, pad) {
        var Pair[byte*, int] a = type(Strs).ToBytes(alphabet);
        var uint cap = (n + 2U) / 3U * 4U;
        var byte* out = new(byte, cap + 1U);
        var uint o = 0U;
        for(var uint i = 0U; i < n; i = i + 3U) {
            var uint v = b[i]{uint} << 16U;
            if(i + 1U < n) {
                v = v | (b[i + 1U]{uint} << 8U);
            }
            if(i + 2U < n) {
                v = v | b[i + 2U]{uint};
            }
            out[o] = a.first[(v >> 18U) & 63U];
            out[o + 1U] = a.first[(v >> 12U) & 63U];
            o = o + 2U;
            if(i + 1U < n) {
                out[o] = a.first[(v >> 6U) & 63U];
                o++;
            } else if(pad) {
                out[o] = '='{int}{byte};
                o++;
            }
            if(i + 2U < n) {
                out[o] = a.first[v & 63U];
                o++;
            } else if(pad) {
                out[o] = '='{int}{byte};
                o++;
            }
        }
        var str s = type(Strs).FromBytes(out, o{int});
        free(out);
        return s;
    }

    // value returns the six bits c stands for in the alphabet, or -1.
    private static fun int(int, bool) value = (c, urlSafe) {
        if(c >= 'A'{int} && c <= 'Z'{int}) {
            return c - 'A'{int};
        }
        if(c >= 'a'{int} && c <= 'z'{int}) {
            return c - 'a'{int} + 26;
        }
        if(c >= '0'{int} && c <= '9'{int}) {
            return c - '0'{int} + 52;
        }
        if((c == '+'{int} && !urlSafe) || (c == '-'{int} && urlSafe)) {
            return 62;
        }
        if((c == '/'{int} && !urlSafe) || (c == '_'{int} && urlSafe)) {
            return 63;
        }
        return -1;
    }

    // decode reads s, whose padding is optional, into bytes.
    private static fun Pair[Arr[byte]*, Err*](str, bool) decode = (s, urlSafe) {
        var Pair[Arr[byte]*, Err*] out;
        out.first = null;
        var Pair[byte*, int] p = type(Strs).ToBytes(s);
        var uint n = p.second{uint};
        for(; n > 0U && p.first[n - 1U]{int} == '='{int};) {
            n--;
        }
        if(n % 4U == 1U || p.second{uint} - n > 2U) {
            out.second = type(StrErr).New("invalid base64 length");
            return out;
        }
        var uint len = n / 4U * 3U;
        if(n % 4U > 1U) {
            len = len + n % 4U - 1U;
        }
        var byte* b = new(byte, len);
        var uint o = 0U;
        var uint acc = 0U;
        var uint bits = 0U;
        for(var uint i = 0U; i < n; i++) {
            var int v = type(Base64).value(p.first[i]{int}, urlSafe);
            if(v < 0) {
                free(b);
                out.second = type(StrErr).New("invalid base64 byte at offset " + i{str});
                return out;
            }
            acc = (acc << 6U) | v{uint};
            bits = bits + 6U;
            if(bits >= 8U) {
                bits = bits - 8U;
                b[o] = ((acc >> bits) & 255U){byte};
                o++;
            }
        }
        out.first = type(Arr)[byte].New(len, b...);
        out.second = null;
        return out;
    }

    public static fun str(byte*, uint) Encode = (b, n) {
        return type(Base64).encode(b, n, type(Base64).std, true);
    }

    public static fun str(str) EncodeStr = (s) {
        var Pair[byte*, int] p = type(Strs).ToBytes(s);
        return type(Base64).encode(p.first, p.second{uint}, type(Base64).std, true);
    }

    // EncodeURL encodes in the URL-safe alphabet, without padding.
    public static fun str(byte*, uint) EncodeURL = (b, n) {
        return type(Base64).encode(b, n, type(Base64).url, false);
    }

    public static fun Pair[Arr[byte]*, Err*](str) Decode = (s) {
        return type(Base64).decode(s, false);
    }

    public static fun Pair[Arr[byte]*, Err*](str) DecodeURL = (s) {
        return type(Base64).decode(s, true);
    }

    public static fun Pair[str, Err*](str) DecodeStr = (s) {
        var Pair[str, Err*] out;
        var Pair[Arr[byte]*, Err*] d = type(Base64).decode(s, false);
        out.second = d.second;
        out.first = "";
        if(d.second == null) {
            out.first = type(Strs).FromBytes(d.first.Arr(), d.first.Len(){int});
        }
        return out;
    }
}
