import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "Archive.zam";

// Zip archives, written with deflate and read with any method libarchive
// supports
public namespace ZIP {
    public static fun (Arr[Archive.Entry*]*, Err*)(byte*, uint) Read = (b, n) {
        return Archive::Read(b, n, Archive.Format::Zip);
    }

    public static fun (Arr[byte]*, Err*)(Arr[Archive.Entry*]*) Write = (entries) {
        return Archive::Write(entries, Archive.Format::Zip);
    }
}
