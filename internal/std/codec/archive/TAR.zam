import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "Archive.zam";

// Tar archives, written in POSIX pax form and read in any tar form,
// compressed by gzip, bzip2, xz, zstd or lz4 or not at all
public namespace TAR {
    public static fun (Arr[Archive.Entry*]*, Err*)(byte*, uint) Read = (b, n) {
        return Archive::Read(b, n, Archive.Format::Tar);
    }

    public static fun (Arr[byte]*, Err*)(Arr[Archive.Entry*]*) Write = (entries) {
        return Archive::Write(entries, Archive.Format::Tar);
    }
}
