import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/StrErr.zam";

// Brotli (RFC 7932) compression, over libbrotli
public namespace Brotli {
    public var int$ DefaultLevel = 11;

    // take copies a compressed or decompressed run out of the buffer the
    // native left it in.
    private static fun (Arr[byte]*, Err*)(uint, int, str) take = (h, n, errStr) {
        var (Arr[byte]*, Err*) out;
        out.0 = null;
        out.1 = null;
        if(errStr != null) {
            out.1 = StrErr::New(errStr);
            return out;
        }
        var byte* b = new(byte, n{uint});
        native(STD_CODEC_TAKE){void(uint, byte*)}(h, b);
        out.0 = Arr::[byte]New(n{uint}, b...);
        return out;
    }

    // Compress compresses n bytes at b. The level runs from 0, fastest, to 11, smallest.
    public static fun Arr[byte]*(byte*, uint, int) Compress = (b, n, level) {
        var uint h;
        var int len;
        var str errStr;
        native(STD_BROTLI_COMPRESS){void(byte*, int, int, uint*, int*, str*)}(b, n{int}, level, &h, &len, &errStr);
        return Brotli::take(h, len, errStr).0;
    }

    // Decompress decompresses n bytes at b, which must hold exactly one
    // compressed stream.
    public static fun (Arr[byte]*, Err*)(byte*, uint) Decompress = (b, n) {
        var uint h;
        var int len;
        var str errStr;
        native(STD_BROTLI_DECOMPRESS){void(byte*, int, uint*, int*, str*)}(b, n{int}, &h, &len, &errStr);
        return Brotli::take(h, len, errStr);
    }
}
