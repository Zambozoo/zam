import "../../lang/Arr.zam";
import "../../lang/Err.zam";
import "../../lang/Pair.zam";
import "../../lang/StrErr.zam";

// Gzip (RFC 1952) compression, over zlib
public namespace GZIP {
    public var int$ DefaultLevel = -1;

    // take copies a compressed or decompressed run out of the buffer the
    // native left it in.
    private static fun Pair[Arr[byte]*, Err*](uint, int, str) take = (h, n, errStr) {
        var Pair[Arr[byte]*, Err*] out;
        out.first = null;
        out.second = null;
        if(errStr != null) {
            out.second = type(StrErr).New(errStr);
            return out;
        }
        var byte* b = new(byte, n{uint});
        native(STD_CODEC_TAKE){void(uint, byte*)}(h, b);
        out.first = type(Arr)[byte].New(n{uint}, b...);
        return out;
    }

    // Compress compresses n bytes at b. The level runs from 0, storing, to 9, smallest, or DefaultLevel.
    public static fun Arr[byte]*(byte*, uint, int) Compress = (b, n, level) {
        var uint h;
        var int len;
        var str errStr;
        native(STD_GZIP_COMPRESS){void(byte*, int, int, uint*, int*, str*)}(b, n{int}, level, &h, &len, &errStr);
        return type(GZIP).take(h, len, errStr).first;
    }

    // Decompress decompresses n bytes at b, which must hold exactly one
    // compressed stream.
    public static fun Pair[Arr[byte]*, Err*](byte*, uint) Decompress = (b, n) {
        var uint h;
        var int len;
        var str errStr;
        native(STD_GZIP_DECOMPRESS){void(byte*, int, uint*, int*, str*)}(b, n{int}, &h, &len, &errStr);
        return type(GZIP).take(h, len, errStr);
    }
}
