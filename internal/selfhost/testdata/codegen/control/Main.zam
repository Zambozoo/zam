namespace Main {
    fun void(uint, str...) main = (argC, argV) {
        var int one = 1;
        var int c1 = one / ((Main::sign(-5) == -1 && Main::sign(0) == 0 && Main::sign(8) == 1) ? 1 : 0);
        var int c2 = one / ((Main::sum(10) == 45 && Main::firstOver(3) == 4) ? 1 : 0);
        var int c3 = one / ((Main::odds(10) == 25 && Main::pairs(4) == 6) ? 1 : 0);
        var int c4 = one / ((Main::exhausted(3) == 103 && Main::exhausted(30) == 10) ? 1 : 0);
        var int c5 = one / ((Main::classify(1) == 10 && Main::classify(3) == 10 && Main::classify(4) == 40 && Main::classify(9) == -1) ? 1 : 0);
        var int c6 = one / ((Main::through(1) == 111 && Main::through(2) == 11 && Main::through(3) == 1) ? 1 : 0);
        var int c7 = one / ((Main::grade('b') == 2 && Main::grade('z') == 0 && Main::halve(2.0) == 1) ? 1 : 0);
        var int c8 = one / ((Main::ordered() == 321 && Main::unwound(5) == 5) ? 1 : 0);
        var int c9 = one / ((Main::leaving(4) == 4 && Main::scoped() == 12) ? 1 : 0);
        Main::spin(1000);
    }

    fun int(int) sign = (n) {
        if(n < 0) {
            return -1;
        } else if(n == 0) {
            return 0;
        }
        return 1;
    }

    fun int(int) sum = (n) {
        var int total = 0;
        for(var int i = 0; i < n; i++) {
            total = total + i;
        }
        return total;
    }

    fun int(int) firstOver = (n) {
        var int i = 0;
        for {
            if(i > n) {
                break;
            }
            i++;
        }
        return i;
    }

    fun int(int) odds = (n) {
        var int total = 0;
        for(var int i = 0; i < n; i++) {
            if(i % 2 == 0) {
                continue;
            }
            total = total + i;
        }
        return total;
    }

    fun int(int) pairs = (n) {
        var int count = 0;
        label outer: for(var int i = 0; i < n; i++) {
            for(var int j = 0; j < n; j++) {
                if(j == i) {
                    continue outer;
                }
                count++;
            }
        }
        return count;
    }

    fun int(int) exhausted = (n) {
        var int i = 0;
        for(; i < 10; i++) {
            if(i == n) {
                break;
            }
        } else {
            return i;
        }
        return i + 100;
    }

    fun int(int) classify = (n) {
        var int out = -1;
        switch(n) {
            case (1, 2, 3)
                out = 10;
            case (4) {
                out = 40;
            }
        } else {
            out = -1;
        }
        return out;
    }

    fun int(int) through = (n) {
        var int out = 0;
        switch(n) {
            case (1) {
                out = out + 100;
                continue;
            }
            case (2) {
                out = out + 10;
                continue;
            }
            case (3) {
                out = out + 1;
                break;
                out = out + 1000;
            }
        }
        return out;
    }

    fun int(char) grade = (c) {
        switch(c) {
            case ('a')
                return 1;
            case ('b')
                return 2;
        }
        return 0;
    }

    fun int(flt) halve = (f) {
        switch(f / 2.0) {
            case (1.0)
                return 1;
        }
        return 0;
    }

    fun int() ordered = () {
        var int out = 0;
        {
            defer out = out * 10 + 1;
            defer out = out * 10 + 2;
            defer out = out * 10 + 3;
        }
        return out;
    }

    fun int(int) unwound = (n) {
        var int one = 1;
        var int ready = 0;
        defer {
            var int check = one / ready;
        }
        ready = 1;
        return n;
    }

    fun int(int) leaving = (n) {
        var int one = 1;
        var int seen = 0;
        for(var int i = 0; i < n; i++) {
            var int before = seen;
            defer seen = seen + 1;
            if(i % 2 == 0) {
                continue;
            }
            var int check = one / ((seen == before) ? 1 : 0);
        }
        return seen;
    }

    fun int() scoped = () {
        var int one = 1;
        var int out = 0;
        if(out == 0) {
            defer out = out + 2;
            out = 10;
        }
        var int check = one / ((out == 12) ? 1 : 0);
        return out;
    }

    fun void(int) spin = (n) {
        for(var int i = 0; i < n; i++) {}
    }
}
