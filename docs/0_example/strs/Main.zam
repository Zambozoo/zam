import std("io/local/*");
import std("lang/*");

namespace Main {
    class Stringed {
        fun str() Str = () {
            return "I'm a string";
        }
    }
    
    static fun void(uint, str...) main = (argC, argV) {
        var Stringed ss;
        var str s = Strs::Sprintf("%v%d", &ss, 5);
        File::StdOut.WriteStr(s);
    }
}
