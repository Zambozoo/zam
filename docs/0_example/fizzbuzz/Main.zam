import std("io/*");

namespace Main {
    fun void(uint, str...) main = (_, _) {
        for(var int i = 1; i <= 100; i++) {
            var str s = "";
            if(i%3 == 0) {
                s = s + "Fizz";
            }
            if(i%5 == 0) {
                s = s + "Buzz";
            }
            if(s == "") {
                s = i{str};
            }
            type(File).StdOut.WriteStr(s + "\n");
        }
    }
}
