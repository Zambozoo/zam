import std("io/local/*");
import std("data/list/*");
import std("data/sort/*");
import std("lang/*");

namespace Main {
    interface Iter[A] {
        fun (A, bool)() Next;
    }
    
    interface Iterable[A] {
        fun Iter[A]*() Iter;
        fun Arr[A]*() Arr;
    }

    fun[A] void(Iterable[A]*) Print = (i) {
        File::StdOut.WriteStr(i{str} + "\n");
        var Iter[A]* iter = i.Iter();
        for(var (A, bool) p = iter.Next(); p.1; p = iter.Next()) {
            File::StdOut.WriteStr(p.0{str} + "\n");
        }
    }

    fun void(uint, str...) main = (argC, argV) {
        var Iterable[str]* al = ArrList::[str]New(argC, argV...);
        Main::[str]Print(al);

        var Iterable[str]* ll = LinkList::[str]New(argC, argV...);
        Main::[str]Print(ll);

        var Iterable[str]* sl = SkipList::[str]New(argC, argV...);
        Main::[str]Print(sl);

        var Arr[str]* arr = al.Arr();
        Sort::[str]SortArr(arr);
        File::StdOut.WriteStr(arr{str} + "\n");
    }
}
